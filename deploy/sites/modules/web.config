<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for https://modules.dotnetcloud.net  (static IIS site, no managed code)

  Site layout is fixed by the store frontend, which fetches ../index/v1/index.json and follows the
  catalogue's site-root-relative downloadUrl values (packages/<id>/<version>/<file>.dncpkg):

      <root>/index.html, package.html, publisher.html, store.css, store.js
      <root>/index/v1/index.json (+ .sig, packages/<id>.json, icons/)
      <root>/packages/<id>/<version>/<file>.dncpkg (+ .sig, store.json)
      <root>/publishers.json, yanked.json

  Deploying the frontend into a subdirectory breaks both of those paths, so the root layout is a
  hard requirement (see finding 1 in docs/THIRD_PARTY_MODULE_SANDBOX_AND_STORE_PLAN.md §B4).

  Requires the IIS "URL Rewrite" module.

  Cache policy
    default (html, css, js, publishers.json, yanked.json)   no-cache
    index/                                                   max-age 60s   (changes on every publish)
    index/v1/icons/                                          max-age 30d
    packages/                                                max-age 1y    (content-addressed by version)

  The .dncpkg / .sig MIME maps are mandatory: IIS refuses to serve an extension it does not know,
  which presents as a 404 for the package file (finding 2). They are applied here so a hand-edited
  copy on the server is no longer required.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!--
      Static site: clear the inherited handler list so extensionless requests (ACME HTTP-01 tokens)
      are served by StaticFile instead of ExtensionlessUrlHandler-* (404.17). See the www web.config.
    -->
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <staticContent>
      <clientCache cacheControlMode="DisableCache" />

      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />

      <!-- ACME HTTP-01 tokens are extensionless (/well-known/acme-challenge/<token>); without this
           mapping IIS refuses to serve them and certificate renewal fails with a 404. -->
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />

      <!-- Package artefacts: must download, never render. -->
      <remove fileExtension=".dncpkg" />
      <mimeMap fileExtension=".dncpkg" mimeType="application/octet-stream" />
      <remove fileExtension=".sig" />
      <mimeMap fileExtension=".sig" mimeType="application/octet-stream" />

      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!-- The catalogue changes on every publish: revalidate quickly, never serve a stale one for long. -->
  <location path="index">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:01:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Icons are copied out of the package into index/v1/icons/ and are stable per package version. -->
  <location path="index/v1/icons">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Packages are immutable by version; a re-publish always publishes a new version. -->
  <location path="packages">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for https://www.dotnetcloud.net  (static IIS site, no managed code)

  Source of truth lives in the core repo (deploy/sites/www/web.config) and is copied into the
  release directory by scripts/deploy-sites.ps1, so the marketing-site repo stays static-only.

  Requires the IIS "URL Rewrite" module. Without it the http->https and apex->www redirects
  silently do not happen (the site still serves, so a missing module is easy to miss).

  Cache policy
    default (html, root files)    no-cache          -> a page edit is visible on reload
    css/, js/, images/, fonts/    max-age 30 days   -> versioned by the deploy, not by filename

  See docs/admin/SITES.md for the IIS site/binding setup and the renewal task.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <!--
      These are static sites: no managed runtime, no ISAPI. The machine-level handler list maps
      `path="*."` to ExtensionlessUrlHandler-*(ISAPI/managed), which claims extensionless requests
      before StaticFile and answers 404.17 — that is exactly the shape of an ACME HTTP-01 token
      (`/.well-known/acme-challenge/<token>`), so renewal would fail. Clearing the inherited list and
      keeping the static handler makes extensionless files ordinary static content.
    -->
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <staticContent>
      <!-- Long-lived assets first; the <location> blocks below re-enable caching for them. -->
      <clientCache cacheControlMode="DisableCache" />

      <!-- Extensions IIS 10 does not always map, or maps to a legacy type. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <!-- ACME HTTP-01 tokens are extensionless (/well-known/acme-challenge/<token>); without this
           mapping IIS refuses to serve them and certificate renewal fails with a 404. -->
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json; charset=utf-8" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <!--
          Apex -> www, in one hop, whatever the scheme. The apex name is bound to this same site
          (host-header binding) so this rule is what performs the redirect; it also collapses
          http://dotnetcloud.net/x straight to https://www.dotnetcloud.net/x.
        -->
        <rule name="ApexToWww" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^dotnetcloud\.net$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.dotnetcloud.net/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Everything else: http -> https on the same host (query string is appended by default). -->
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <location path="css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="fonts">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>

<Project>
  <!-- CRITICAL: Set output paths before Microsoft.Common.props is imported -->
  <!-- This prevents MSB3539 warning about BaseIntermediateOutputPath being modified after use -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BaseIntermediateOutputPath>$(MSBuildProjectDir)bin\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDir)bin\</BaseOutputPath>
    <!-- Prevent test SDK and other targets from overriding output paths -->
    <_UseCustomIntermediateOutputPath>true</_UseCustomIntermediateOutputPath>
    <DisablePathNormalization>true</DisablePathNormalization>
  </PropertyGroup>
  <!-- SixLabors.ImageSharp v4 license -->
  <!-- Points to the actual license file from SixLabors at src\sixlabors.lic -->
  <PropertyGroup>
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)src\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <!-- Common properties for all projects -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Shared metadata -->
  <PropertyGroup>
    <Company>DotNetCloud</Company>
    <Authors>DotNetCloud Contributors</Authors>
    <Product>DotNetCloud</Product>
    <Description>A modular, multi-tenant cloud platform built with .NET</Description>
    <PackageProjectUrl>https://github.com/LLabmik/DotNetCloud</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LLabmik/DotNetCloud</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Versioning -->
  <PropertyGroup>
    <MajorVersion>0</MajorVersion>
    <MinorVersion>4</MinorVersion>
    <PatchVersion>07</PatchVersion>
    <PreReleaseVersion></PreReleaseVersion>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion Condition="'$(PreReleaseVersion)' == ''">$(Version)</InformationalVersion>
    <InformationalVersion Condition="'$(PreReleaseVersion)' != ''">$(Version)-$(PreReleaseVersion)</InformationalVersion>
  </PropertyGroup>

  <!-- Output settings -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet audit suppressions -->
  <!--
    AngleSharp 0.17.1 (GHSA-pgww-w46g-26qg, CVE-2026-54570):
    mXSS via MathML annotation-xml HTML integration point bypass.
    Fixed in AngleSharp 1.5.0+, but AngleSharp.Css 0.17.0 and HtmlSanitizer 9.0.892
    both pin AngleSharp to < 0.18.0. Suppressed until those packages release
    AngleSharp 1.x-compatible versions.
    SOC 2 compensating control (CC7): user-generated HTML is sanitized with
    HtmlSanitizer and rendered only to authenticated users; no admin is exposed to
    unauthenticated attacker-controlled HTML. REVIEW DATE: 2026-11-18 (re-check for
    AngleSharp 1.x-compatible HtmlSanitizer/AngleSharp.Css releases).
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
    <!-- Microsoft.OpenApi 2.0.0 vulnerability (GHSA-v5pm-xwqc-g5wc):
         Transitive dependency from Microsoft.AspNetCore.OpenApi 10.0.10.
         Explicit override to 3.9.0 breaks the source generator (IOpenApiMediaType.Example
         is read-only in OpenApi 3.x). Suppressed until AspNetCore.OpenApi ships with
         a compatible OpenApi 2.x with the fix.
         SOC 2 compensating control (CC7): OpenApi metadata is only served by the
         module hosts over the loopback/internal gRPC surface in development; no
         production-facing endpoint exposes the affected generator path.
         REVIEW DATE: 2026-11-18. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <!-- Code analysis -->
  <PropertyGroup>
    <GenerateFullPaths>true</GenerateFullPaths>
  </PropertyGroup>

  </Project>

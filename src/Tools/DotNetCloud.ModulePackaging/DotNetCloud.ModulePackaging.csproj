<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnetcloud-pack</AssemblyName>
    <RootNamespace>DotNetCloud.ModulePackaging</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The packaging logic is referenced by the installer tests (B3) as well as the CLI. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ed25519. .NET 10 has no System.Security.Cryptography.Ed25519 surface, and a native
         libsodium binding would make the packer platform-specific. See MODULE_PACKAGING.md §3. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest contract (ModuleManifestLoader/ModuleCompatibility) is the single source of
         truth for validation, so the packer and the running core agree by construction. -->
    <ProjectReference Include="..\..\Core\DotNetCloud.Core.Server\DotNetCloud.Core.Server.csproj" />
  </ItemGroup>

</Project>

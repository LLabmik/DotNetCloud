@namespace DotNetCloud.Modules.AI.UI
@using DotNetCloud.UI.Shared.Components.Navigation

@using DotNetCloud.Core.AI
@using DotNetCloud.Core.Authorization
@using DotNetCloud.Core.Services.ModuleApis
@using DotNetCloud.UI.Shared.Services
@using System.Text
@using System.Diagnostics
@inject IAiApiClient AiApi
@inject IMarkdownRenderer MarkdownRenderer
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Logging.ILogger<AiChatPage> Logger
@inject IJSRuntime JS

<div class="ai-layout">
    @* ─── Sidebar ─── *@
    <aside class="ai-sidebar">
        <div class="ai-sidebar-header">
            <h3>AI Assistant</h3>
            <button class="btn-new-chat" @onclick="StartNewConversation" title="New Chat">
                <span>+</span>
            </button>
        </div>

        <div class="ai-model-label">Model: @_defaultModel</div>

        <div class="ai-conversation-list">
            @if (_conversations.Count == 0 && !_isLoading)
            {
                <div class="ai-empty-hint">No conversations yet.</div>
            }
            @foreach (var conv in _conversations)
            {
                <div class="ai-conversation-item @(_activeConversationId == conv.Id ? "active" : "")">
                    @if (_renamingConversationId == conv.Id)
                    {
                        <input class="conv-title-input"
                               @bind="_renameTitle"
                               @bind:event="oninput"
                               @onblur="CommitRenameAsync"
                               @onkeydown="OnRenameTitleKeyDown"
                               @ref="_renameTitleInput" />
                    }
                    else
                    {
                        <button class="ai-conversation-btn"
                                @onclick="() => LoadConversationAsync(conv.Id)"
                                @ondblclick="() => StartRenaming(conv)"
                                @ondblclick:stopPropagation="true">
                            <span class="conv-title">@(string.IsNullOrWhiteSpace(conv.Title) ? "Untitled" : conv.Title)</span>
                            <span class="conv-date">@conv.UpdatedAt.ToLocalTime().ToString("MMM d")</span>
                        </button>
                    }
                    <button class="ai-conversation-delete" title="Delete chat"
                            @onclick="() => DeleteConversationAsync(conv.Id)"
                            @onclick:stopPropagation="true">
                        ✕
                    </button>
                </div>
            }
        </div>

        <ModuleHelpLink ModuleId="ai" Collapsed="false" />
    </aside>

    @* ─── Main Chat Area ─── *@
    <main class="ai-main">
        @if (_activeConversation is null && !_isLoading)
        {
            <div class="ai-welcome">
                <div class="ai-welcome-icon">🤖</div>
                <h2>DotNetCloud AI Assistant</h2>
                <p>Start a conversation or select one from the sidebar.</p>
                @if (!_ollamaHealthy)
                {
                    <div class="ai-warning">⚠ Ollama is not reachable. AI features may be unavailable.</div>
                }
            </div>
        }
        else
        {
            <div class="ai-messages" @ref="_messagesContainer">
                @if (_activeConversation is not null)
                {
                    @foreach (var msg in _activeMessages)
                    {
                        <div class="ai-message @(msg.Role == "user" ? "user" : "assistant")">
                            <div class="ai-message-avatar">
                                @(msg.Role == "user" ? "👤" : "🤖")
                            </div>
                            <div class="ai-message-content">
                                <div class="ai-message-role">@(msg.Role == "user" ? "You" : "Assistant")</div>
                                @if (msg.Role == "assistant")
                                {
                                    <div class="ai-message-text markdown-body">@((MarkupString)MarkdownRenderer.RenderToHtml(msg.Content))</div>
                                    <div class="ai-copy-actions">
                                        <button class="ai-copy-btn" @onclick="() => CopyAsMarkdownAsync(msg.Content)" title="Copy as Markdown">
                                            @if (_copiedMessageId == msg.Id && _copiedFormat == "md")
                                            {
                                                <span class="ai-copy-icon">✓</span>
                                                <span>Copied!</span>
                                            }
                                            else
                                            {
                                                <span class="ai-copy-icon">📋</span>
                                                <span>Copy as Markdown</span>
                                            }
                                        </button>
                                        <button class="ai-copy-btn" @onclick="() => CopyAsFormattedAsync(msg.Content)" title="Copy as Formatted">
                                            @if (_copiedMessageId == msg.Id && _copiedFormat == "html")
                                            {
                                                <span class="ai-copy-icon">✓</span>
                                                <span>Copied!</span>
                                            }
                                            else
                                            {
                                                <span class="ai-copy-icon">📄</span>
                                                <span>Copy as Formatted</span>
                                            }
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="ai-message-text">@msg.Content</div>
                                }
                            </div>
                        </div>
                    }

                    @if (_isStreaming)
                    {
                        <div class="ai-message assistant">
                            <div class="ai-message-avatar">🤖</div>
                            <div class="ai-message-content">
                                <div class="ai-message-role">
                                    Assistant
                                    @if (_isStreaming && !_isModelLoading && !_isQueued && string.IsNullOrEmpty(_streamingContent) && string.IsNullOrEmpty(_thinkingContent))
                                    {
                                        <span class="ai-thinking">* Thinking *</span>
                                    }
                                </div>
                                <div class="ai-stream-actions">
                                    @if (_isQueued)
                                    {
                                        <div class="ai-queue-status">
                                            In queue: position @_queuePosition of @_queueTotal
                                        </div>
                                    }
                                    <button class="ai-abort-btn" @onclick="AbortStream" title="Cancel this request">
                                        <span class="ai-abort-icon">✕</span>
                                        <span>Abort</span>
                                    </button>
                                </div>
                                @if (_isModelLoading && !_isQueued && string.IsNullOrEmpty(_streamingContent) && string.IsNullOrEmpty(_thinkingContent))
                                {
                                    <div class="ai-model-loading">
                                        <span class="ai-model-loading-spinner"></span>
                                        <span>Generating…</span>
                                    </div>
                                }
                                @if (_hasThinking && !_isQueued)
                                {
                                    <div class="ai-thinking-block">
                                        <div class="ai-thinking-label">Thought process</div>
                                        <div class="ai-thinking-text">@_thinkingContent</div>
                                    </div>
                                }
                                <div class="ai-message-text ai-streaming">
                                    <div class="ai-stream-scroll" @ref="_streamScroll">
                                        @_streamingContent<span class="ai-cursor">▍</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="ai-input-area">
                <div class="ai-input-row">
                    <textarea class="ai-input"
                              placeholder="Type a message…"
                              @bind="_userInput"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              rows="1"
                              disabled="@_isStreaming"></textarea>
                    <button class="btn-send" @onclick="SendMessageAsync" disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_userInput))">
                        @if (_isStreaming)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <span>➤</span>
                        }
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="ai-error">@_errorMessage</div>
                }
            </div>
        }
    </main>
</div>

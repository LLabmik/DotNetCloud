<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.AI.Host</RootNamespace>
    <AssemblyName>dotnetcloud.ai</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Prevent publishing static web assets to avoid conflicts when Core.Server publishes.
         Module.Host projects are referenced by Core.Server, and their assets would collide
         with Core.Server's own assets. These settings ensure only Core.Server's assets are published. -->
    <PublishWithPackageReferences>false</PublishWithPackageReferences>
    <PublishReadyToCompile>false</PublishReadyToCompile>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\ai_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Modules.AI\DotNetCloud.Modules.AI.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.AI.Data\DotNetCloud.Modules.AI.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.AI.Data.SqlServer\DotNetCloud.Modules.AI.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
    <!-- Canonical module API client (audit, settings plane) and the in-memory test harness. -->
    <ProjectReference Include="..\..\..\SDK\DotNetCloud.Modules.Sdk\DotNetCloud.Modules.Sdk.csproj" />
    <!-- The module UI. This is the standard hosted-Blazor-WebAssembly shape: referencing the
         WebAssembly project contributes its published files as this host's static web assets, so
         the frame the core loads at /apps/dotnetcloud.ai/ is served by the module process itself. -->
    <ProjectReference Include="..\DotNetCloud.Modules.AI.Web\DotNetCloud.Modules.AI.Web.csproj" />
  </ItemGroup>

  <!--
    The supervisor reads <modules>/<id>/manifest.json to decide how a module runs. The packer
    copies its own manifest into a package, but a plain `dotnet publish` of this host must still
    produce one — that is what makes a directly-published build run sandboxed rather than falling
    back to the v1 default manifest.
  -->
  <ItemGroup>
    <Content Include="..\manifest.json"
             Link="manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

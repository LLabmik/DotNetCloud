@namespace DotNetCloud.Modules.Bookmarks.UI
@using DotNetCloud.Modules.Bookmarks.Models
@using System.ComponentModel.DataAnnotations

<div class="edit-panel">
    <h3>@(Bookmark.Id == Guid.Empty ? "Add Bookmark" : "Edit Bookmark")</h3>

    <EditForm Model="Bookmark" OnValidSubmit="HandleSaveAsync" OnInvalidSubmit="HandleInvalidSubmit"
              FormName="bookmark-edit">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="url">URL</label>
            <InputText id="url" class="input" @bind-Value="Bookmark.Url" placeholder="https://..." />
            <ValidationMessage For="() => Bookmark.Url" />
        </div>

        <div class="form-group">
            <label for="title">Title</label>
            <InputText id="title" class="input" @bind-Value="Bookmark.Title" placeholder="Optional title" />
        </div>

        <div class="form-group">
            <label for="folder">Folder</label>
            <select id="folder" class="input" @bind="Bookmark.FolderId">
                <option value="">No folder</option>
                @foreach (var folder in Folders)
                {
                    <option value="@folder.Id">@folder.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <InputTextArea id="description" class="input" @bind-Value="Bookmark.Description" rows="2"
                           placeholder="Optional description" />
        </div>

        <div class="form-group">
            <label for="notes">Notes</label>
            <InputTextArea id="notes" class="input" @bind-Value="Bookmark.Notes" rows="3"
                           placeholder="Optional notes" />
        </div>

        <div class="form-group">
            <label for="tags">Tags (comma-separated)</label>
            <input id="tags" class="input" @bind="_tagsInput" placeholder="tag1, tag2, tag3" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@_submitting">
                @(_submitting ? "Saving..." : "Save")
            </button>
        </div>
    </EditForm>

    <div class="form-actions" style="margin-top: 8px;">
        <button type="button" class="btn btn-outline" @onclick="Cancel" disabled="@_submitting">
            Cancel
        </button>
    </div>
</div>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Photos.Host</RootNamespace>
    <AssemblyName>dotnetcloud.photos</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Prevent publishing static web assets to avoid conflicts when Core.Server publishes.
         Module.Host projects are referenced by Core.Server, and their assets would collide
         with Core.Server's own assets. These settings ensure only Core.Server's assets are published. -->
    <PublishWithPackageReferences>false</PublishWithPackageReferences>
    <PublishReadyToCompile>false</PublishReadyToCompile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\photos_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Modules.Photos\DotNetCloud.Modules.Photos.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Photos.Data\DotNetCloud.Modules.Photos.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Photos.Data.SqlServer\DotNetCloud.Modules.Photos.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
    <ProjectReference Include="..\..\..\SDK\DotNetCloud.Modules.Sdk\DotNetCloud.Modules.Sdk.csproj" />
    <!-- No cross-module reference: the user's files are read through the core (IFileDirectory). -->
  </ItemGroup>

  <ItemGroup>
    <!-- A plain `dotnet publish` must ship the v2 manifest, or the supervisor falls back to a v1
         default and withholds the module directories. -->
    <Content Include="..\manifest.json"
             Link="manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module UI. This is the standard hosted-Blazor-WebAssembly shape: referencing the
         WebAssembly project contributes its published files as this host's static web assets, so the
         frame the core loads at /apps/dotnetcloud.photos/ is served by the module process itself. -->
    <ProjectReference Include="..\DotNetCloud.Modules.Photos.Web\DotNetCloud.Modules.Photos.Web.csproj" />
  </ItemGroup>

</Project>

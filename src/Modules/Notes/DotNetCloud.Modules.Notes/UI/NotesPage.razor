@namespace DotNetCloud.Modules.Notes.UI

@using DotNetCloud.Core.DTOs
@using DotNetCloud.Modules.Notes.Services
@using DotNetCloud.Modules.Notes.Models
@using System.Security.Claims
@inject INotesApiClient ApiClient
@inject IMarkdownRenderer MarkdownRenderer
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject DotNetCloud.Core.Capabilities.IUserDirectory UserDirectory
@inject DotNetCloud.Core.Capabilities.ITeamDirectory TeamDirectory

<div class="notes-page-layout">
    <div class="notes-sidebar @(_sidebarCollapsed ? "collapsed" : "")">
        <div class="notes-sidebar-header">
            @if (!_sidebarCollapsed)
            {
                <h3 class="notes-sidebar-title">Notes</h3>
            }
            <button class="notes-sidebar-toggle" @onclick="ToggleSidebar"
                    title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
                <MaterialIcon Icon="@(_sidebarCollapsed ? "chevron_right" : "chevron_left")" />
            </button>
            @if (!_sidebarCollapsed)
            {
                <button class="btn btn-primary new-note-btn" @onclick="BeginCreateNote" title="New Note">
                    <span class="new-note-btn-icon">+</span>
                    <span>New Note</span>
                </button>
            }
        </div>
        @if (!_sidebarCollapsed)
        {
            <div class="notes-search">
                <input type="text" class="form-control form-control-sm" placeholder="Search notes..." @bind="_searchQuery"
                       @bind:event="oninput" />
            </div>
        }
        <nav class="notes-nav">
            <a class="notes-nav-item @(_activeSection == "all" ? "active" : "")" @onclick='() => _activeSection = "all"'
               title="All Notes">
                <span class="notes-nav-icon">📝</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="notes-nav-label">All Notes</span>
                }
            </a>
            <a class="notes-nav-item @(_activeSection == "folders" ? "active" : "")"
               @onclick='() => _activeSection = "folders"' title="Folders">
                <span class="notes-nav-icon">📁</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="notes-nav-label">Folders</span>
                }
            </a>
            <a class="notes-nav-item @(_activeSection == "tags" ? "active" : "")"
               @onclick='() => _activeSection = "tags"' title="Tags">
                <span class="notes-nav-icon">🏷️</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="notes-nav-label">Tags</span>
                }
            </a>
            <a class="notes-nav-item @(_activeSection == "favorites" ? "active" : "")"
               @onclick='() => _activeSection = "favorites"' title="Favorites">
                <span class="notes-nav-icon">⭐</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="notes-nav-label">Favorites</span>
                }
            </a>
            <a class="notes-nav-item @(_activeSection == "shared" ? "active" : "")"
               @onclick='() => _activeSection = "shared"' title="Shared with Me">
                <span class="notes-nav-icon">🤝</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="notes-nav-label">Shared with Me</span>
                }
            </a>
        </nav>

        @if (_activeSection == "folders" && !_sidebarCollapsed)
        {
            <div class="notes-folders">
                @foreach (var folder in _folders)
                {
                    <div class="notes-folder-item-row">
                        <button class="notes-folder-item @(_selectedFolderId == folder.Id ? "selected" : "")"
                                @onclick="() => SelectFolderAsync(folder.Id)">
                            @folder.Name
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" title="Rename"
                                @onclick="() => BeginRenameFolder(folder)">✏</button>
                        <button class="btn btn-sm btn-outline-danger" title="Delete"
                                @onclick="() => DeleteFolderAsync(folder.Id)">×</button>
                    </div>
                }
                <div class="notes-folder-actions">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFolderFilter">All Folders</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="BeginCreateFolder">+ Folder</button>
                </div>

                @if (_showFolderForm)
                {
                    <div class="notes-folder-form">
                        <input type="text" class="form-control form-control-sm" placeholder="Folder name" @bind="_folderName" />
                        <button class="btn btn-sm btn-primary" @onclick="SaveFolderAsync">Save</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => _showFolderForm = false">Cancel</button>
                    </div>
                }
            </div>
        }

        @if (!_sidebarCollapsed)
        {
            <div class="notes-list">
                @if (_notes.Count == 0)
                {
                    <div class="notes-list-empty">
                        <span class="notes-list-empty-icon">📝</span>
                        <p>No notes found</p>
                    </div>
                }
                else
                {
                    @foreach (var note in VisibleNotes)
                    {
                        <button class="notes-list-item @(_selectedNote?.Id == note.Id ? "selected" : "")"
                                @onclick="() => SelectNoteAsync(note.Id)">
                            <div class="notes-list-item-header">
                                <strong class="notes-list-item-title">@note.Title</strong>
                                @if (!IsOwner(note))
                                {
                                    <span class="notes-list-item-share-badge @(CanEdit(note) ? "" : "notes-list-item-share-badge-ro")"
                                          title="@(CanEdit(note) ? "Shared with you — can edit" : "Shared with you — read only")">
                                        @(CanEdit(note) ? "Shared" : "Read-only")
                                    </span>
                                }
                                @if (note.IsFavorite)
                                {
                                    <span class="notes-list-item-favorite" title="Favorite">★</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(note.Content))
                            {
                                <span class="notes-list-item-preview">@GetPreview(note.Content)</span>
                            }
                            <div class="notes-list-item-footer">
                                <span class="notes-list-item-date">@note.UpdatedAt.ToLocalTime().ToString("g")</span>
                                @if (note.Tags.Count > 0)
                                {
                                    <span class="notes-list-item-tags">
                                        @foreach (var tag in note.Tags.Take(2))
                                        {
                                            <span class="notes-list-item-tag">@tag</span>
                                        }
                                        @if (note.Tags.Count > 2)
                                        {
                                            <span class="notes-list-item-tag notes-list-item-tag-more">+@(note.Tags.Count - 2)</span>
                                        }
                                    </span>
                                }
                            </div>
                            @if (GetFolderLabel(note.FolderId) is string folderLabel)
                            {
                                <span class="notes-list-item-folder" title="Folder: @folderLabel">@folderLabel</span>
                            }
                        </button>
                    }
                }
            </div>
        }

        <DotNetCloud.UI.Shared.Components.Navigation.ModuleHelpLink ModuleId="notes" Collapsed="_sidebarCollapsed" />
    </div>
    <div class="notes-main">
        <DncLoadingIndicator Visible="_isLoading" Message="Loading notes..." />

        @if (!_isLoading && _editingNote is not null)
        {
            <EditForm Model="_editingNote" OnValidSubmit="SaveNoteAsync" class="notes-editor-form">
                <div class="notes-form-actions">
                    <button type="submit" class="btn btn-outline-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
                <div class="notes-form-grid">
                    <InputText class="form-control" @bind-Value="_editingNote.Title" placeholder="Note title" />
                    <InputText class="form-control" @bind-Value="_editingNote.TagCsv"
                               placeholder="Tags (comma separated)" />
                    @if (CanChangeFolder)
                    {
                        <label class="notes-field-label" for="note-folder-select">Folder</label>
                        <select id="note-folder-select" class="form-control" @bind="_editingNote.FolderSelection">
                            <option value="">No folder (unfiled)</option>
                            @foreach (var folder in _folders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                    }
                </div>
                <MarkdownEditor Content="@_editingNote.Content" ContentChanged="HandleEditorChanged"
                                Renderer="MarkdownRenderer" FillHeight="true" />
            </EditForm>
        }
        else if (_selectedNote is not null)
        {
            <div class="notes-detail">
                <h2>@_selectedNote.Title</h2>
                <p><strong>Tags:</strong> @string.Join(", ", _selectedNote.Tags)</p>
                <div class="notes-detail-folder">
                    <MaterialIcon Icon="folder" Size="MaterialIconSize.Sm" />
                    @if (IsOwner(_selectedNote))
                    {
                        <label class="notes-field-label" for="note-move-folder">Folder</label>
                        <select id="note-move-folder" class="form-control form-control-sm notes-move-select"
                                value="@(_selectedNote.FolderId?.ToString() ?? string.Empty)"
                                @onchange="MoveSelectedNoteAsync"
                                title="Move this note to a folder">
                            <option value="">No folder (unfiled)</option>
                            @foreach (var folder in _folders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="notes-detail-folder-name">@GetFolderName(_selectedNote.FolderId)</span>
                    }
                </div>
                @if (!IsOwner(_selectedNote))
                {
                    <div
                        class="notes-share-notice @(CanEdit(_selectedNote) ? "notes-share-notice-edit" : "notes-share-notice-ro")">
                        <MaterialIcon Icon="@(CanEdit(_selectedNote) ? "edit_note" : "lock")" Size="MaterialIconSize.Sm" />
                        <span>@(CanEdit(_selectedNote) ? "Shared with you — you can edit" : "Shared with you — read only")</span>
                    </div>
                }
                <div class="notes-detail-actions">
                    @if (CanEdit(_selectedNote))
                    {
                        <button class="btn btn-outline-primary" @onclick="BeginEditSelected">Edit</button>
                        <button class="btn btn-outline-warning" @onclick="ToggleFavoriteAsync">@(_selectedNote.IsFavorite ?
                                                                                                                                    "Unfavorite" : "Favorite")</button>
                        }
                        @if (IsOwner(_selectedNote))
                        {
                            <button class="btn btn-outline-secondary" @onclick="OpenShareDialogAsync">Share</button>
                        }
                        <button class="btn btn-outline-secondary" @onclick="ToggleVersionPanel">
                            @(_showVersionPanel ? "Hide History" : "History")
                        </button>
                        @if (IsOwner(_selectedNote))
                        {
                            <button class="btn btn-outline-danger" @onclick="DeleteNoteFromDetailAsync">Delete</button>
                        }
                    </div>

                    @if (_showVersionPanel)
                    {
                        <div class="notes-version-panel">
                            <h4>Version History</h4>
                            @if (_versions.Count == 0)
                            {
                                <p>No previous versions.</p>
                            }
                            else
                            {
                                @foreach (var version in _versions.OrderByDescending(v => v.VersionNumber))
                                {
                                    <div class="version-item">
                                        <span>v@(version.VersionNumber) — @version.CreatedAt.ToLocalTime().ToString("g")</span>
                                        @if (CanEdit(_selectedNote))
                                        {
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => RestoreVersionAsync(version.Id)">Restore</button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                    <div class="notes-cross-module-links">
                        <CrossModuleLinkList Requests="BuildNoteLinkRequests(_selectedNote)" />
                    </div>
                    <MarkdownEditor Content="@_selectedNote.Content" Renderer="MarkdownRenderer" PreviewOnly="true" />
                </div>
            }
        else if (!_isLoading)
            {
                <div class="notes-placeholder">
                    <p>Select a note or create a new one to get started.</p>
                </div>
            }
        </div>
    </div>

    @if (_showShareDialog && _selectedNote is not null)
    {
        <DncShareDialog ItemName="@_selectedNote.Title" ItemCount="1" AllowPermissionEditing="false"
                        PermissionOptions="NotePermissionOptions" ExistingShares="_shareDialogShares"
                        IsLoadingShares="_isLoadingShareDialogShares" OnClose="CloseShareDialogAsync"
                        OnShareCreated="HandleShareCreatedAsync" OnShareRemoved="HandleShareRemovedAsync" />
    }

<DncConfirmDialog @ref="_confirmDialog" />

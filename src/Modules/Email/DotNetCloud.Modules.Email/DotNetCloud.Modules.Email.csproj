<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Email</RootNamespace>
    <AssemblyName>DotNetCloud.Modules.Email</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetCloud.Modules.Email.Data" />
    <InternalsVisibleTo Include="DotNetCloud.Modules.Email.Tests" />
  </ItemGroup>

  <!--
    The module library carries contracts only (models, service interfaces, events, the HTTP client).
    Its UI is served from DotNetCloud.Modules.Email.Host/wwwroot and framed by the core, so this
    project has no Razor SDK, no ASP.NET Core framework reference and no dependency on the core's
    Blazor component library (Track C decoupling).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core\DotNetCloud.Core.csproj" />
  </ItemGroup>

  <!-- The domain library needs logging + DI abstractions only; not the ASP.NET Core framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>

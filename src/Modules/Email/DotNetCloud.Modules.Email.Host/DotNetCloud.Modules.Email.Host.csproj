<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Email.Host</RootNamespace>
    <AssemblyName>dotnetcloud.email</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishWithPackageReferences>false</PublishWithPackageReferences>
    <PublishReadyToCompile>false</PublishReadyToCompile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\email_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <!--
    The supervisor reads <modules>/<id>/manifest.json to decide how a module runs: a v2 manifest
    makes it sandboxed (private data dir + isolated data store) and gives it consent scopes. A
    bundled deploy publishes this host straight into that directory, so the file must travel with
    the binaries — without it the supervisor falls back to a v1 default manifest, withholds the
    module directories and the host dies on the read-only /opt tree.
  -->
  <ItemGroup>
    <Content Include="..\manifest.json"
             Link="manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Modules.Email\DotNetCloud.Modules.Email.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Email.Data\DotNetCloud.Modules.Email.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Email.Data.SqlServer\DotNetCloud.Modules.Email.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
    <!-- The SDK is the only sanctioned way a module reaches the core. Email uses it for the
         IFileDirectory/IFileWriter capabilities (browse and save the user's files). -->
    <ProjectReference Include="..\..\..\SDK\DotNetCloud.Modules.Sdk\DotNetCloud.Modules.Sdk.csproj" />
    <!-- The module UI. This is the standard hosted-Blazor-WebAssembly shape: referencing the
         WebAssembly project contributes its published files as this host's static web assets, so the
         frame the core loads at /apps/dotnetcloud.email/ is served by the module process itself. -->
    <ProjectReference Include="..\DotNetCloud.Modules.Email.Web\DotNetCloud.Modules.Email.Web.csproj" />
  </ItemGroup>

</Project>

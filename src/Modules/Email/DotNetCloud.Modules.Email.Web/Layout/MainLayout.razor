@inherits LayoutComponentBase
@inject ModuleFrameBridge Bridge

@* The shell is deliberately thin: the ported Email UI brings its own sidebar-plus-reader layout. The
   theme is *not* repeated here — the bridge writes it onto the document element, and a second copy on
   this wrapper goes stale. The bridge is still injected so the layout re-renders when the shell's
   theme changes. *@
<div class="email-root">
    @Body
</div>

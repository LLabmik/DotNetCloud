{
    "manifestVersion": 2,
    "id": "dotnetcloud.email",
    "name": "Email",
    "version": "1.1.0",
    "description": "Email client with IMAP/POP3 sync, sending, rules, and Gmail OAuth support.",
    "publisher": {
        "id": "dotnetcloud",
        "name": "DotNetCloud",
        "url": "https://dotnetcloud.net"
    },
    "moduleApiVersion": 1,
    "minCoreVersion": "0.7.0",
    "dataStore": "isolated",
    "handlesUserErasure": true,
    "capabilities": [
        "IAuditLogger",
        "ISearchProvider"
    ],
    "userConsentScopes": [
        "mail:read",
        "mail:write"
    ],
    "events": {
        "publishes": [
            "EmailAccountAddedEvent",
            "EmailAccountRemovedEvent",
            "EmailThreadCreatedEvent",
            "EmailMessageReceivedEvent",
            "EmailSentEvent",
            "EmailRuleTriggeredEvent"
        ],
        "subscribes": []
    },
    "ui": {
        "type": "iframe",
        "entryPath": "/",
        "navItems": [
            {
                "id": "email",
                "label": "Email",
                "icon": "mail",
                "path": "/"
            }
        ],
        "widget": {
            "path": "/widget/index.html"
        }
    }
}
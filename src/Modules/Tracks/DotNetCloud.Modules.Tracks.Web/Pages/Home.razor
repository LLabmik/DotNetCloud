@page "/"
@inject TracksApi Api

<PageTitle>Tracks</PageTitle>

<main class="tracks-home">
    <h1>Tracks</h1>

    <p class="tracks-home__lead">
        This is the Blazor WebAssembly shell of the Tracks module. It is served by the module host and
        framed by the core at <code>/apps/dotnetcloud.tracks/</code>; every asset and API reference is
        relative, because the core proxy strips that prefix.
    </p>

    <section class="tracks-home__status">
        <h2>Module host</h2>
        @if (_info is null)
        {
            <p>@_status</p>
        }
        else
        {
            <dl>
                <dt>Module</dt>
                <dd>@_info.Module</dd>
                <dt>Version</dt>
                <dd>@_info.Version</dd>
                <dt>Status</dt>
                <dd>@_info.Status</dd>
            </dl>
        }
    </section>
</main>

@code {
    private TracksApi.ModuleInfo? _info;
    private string _status = "Contacting the module host…";

    protected override async Task OnInitializedAsync()
    {
        _info = await Api.GetModuleInfoAsync();
        if (_info is null)
        {
            // Expected while the UI is opened outside the core proxy: the relative api/info path then
            // does not resolve to a module host.
            _status = "The module host is not reachable from this address.";
        }
    }
}

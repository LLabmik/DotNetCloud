<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Tracks.Host</RootNamespace>
    <AssemblyName>dotnetcloud.tracks</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Prevent publishing static web assets to avoid conflicts when Core.Server publishes.
         Module.Host projects are referenced by Core.Server, and their assets would collide
         with Core.Server's own assets. These settings ensure only Core.Server's assets are published. -->
    <PublishWithPackageReferences>false</PublishWithPackageReferences>
    <PublishReadyToCompile>false</PublishReadyToCompile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\tracks_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Modules.Tracks\DotNetCloud.Modules.Tracks.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Tracks.Data\DotNetCloud.Modules.Tracks.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Tracks.Data.SqlServer\DotNetCloud.Modules.Tracks.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
    <!-- The module UI. This is the standard hosted-Blazor-WebAssembly shape: referencing the
         WebAssembly project contributes its published files as this host's static web assets, so
         the frame the core loads at /apps/dotnetcloud.tracks/ is served by the module process
         itself. No copy step, no duplicated output. -->
    <ProjectReference Include="..\DotNetCloud.Modules.Tracks.Web\DotNetCloud.Modules.Tracks.Web.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Chat.Host</RootNamespace>
    <AssemblyName>dotnetcloud.chat</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Prevent publishing static web assets to avoid conflicts when Core.Server publishes.
         Module.Host projects are referenced by Core.Server, and their assets would collide
         with Core.Server's own assets. These settings ensure only Core.Server's assets are published. -->
    <PublishWithPackageReferences>false</PublishWithPackageReferences>
    <PublishReadyToCompile>false</PublishReadyToCompile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\chat_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Modules.Chat\DotNetCloud.Modules.Chat.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Chat.Data\DotNetCloud.Modules.Chat.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Modules.Chat.Data.SqlServer\DotNetCloud.Modules.Chat.Data.SqlServer.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Auth\DotNetCloud.Core.Auth.csproj" />
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The supervisor only learns a module's capabilities from this file. Without it the module runs
         on a default manifest with no capabilities, so no grants are created and every capability call
         is denied at runtime (ModuleAccessEvaluator). -->
    <Content Include="..\manifest.json"
             Link="manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

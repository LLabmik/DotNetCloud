@namespace DotNetCloud.Modules.Chat.Widget

@if (_loading)
{
    <div class="widget-loading">Loading…</div>
}
else if (_error is not null)
{
    <div class="widget-empty">@_error</div>
}
else if (_items.Count == 0)
{
    <div class="widget-empty">@EmptyMessage</div>
}
else
{
    <ul class="widget-list">
        @foreach (var item in _items)
        {
            <li class="widget-list-item">
                @if (item.Type == "DirectMessage")
                {
                    @* Presence dots appear on Direct Message rows only — a Group row is not a single user. *@
                    <span class="presence-dot @GetPresenceClass(item.Id)"
                          title="@GetPresenceLabel(item.Id)"
                          aria-label="@GetPresenceLabel(item.Id)"></span>
                }
                <a class="widget-list-item-title" href="@HrefFor(item)">@item.Name</a>
            </li>
        }
    </ul>
}

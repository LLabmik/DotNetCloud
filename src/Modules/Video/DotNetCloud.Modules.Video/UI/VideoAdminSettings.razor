@namespace DotNetCloud.Modules.Video.UI

<div class="settings-section">
    <h3>TMDB Enrichment</h3>
    <p class="settings-description">
        The Movie Database (TMDB) provides metadata for movies and TV series including
        overviews, ratings, genres, posters, and episode information.
    </p>

    <div class="form-group">
        <label for="tmdb-api-key">TMDB API Key</label>
        <input id="tmdb-api-key"
               type="password"
               class="form-control"
               placeholder="Enter your TMDB API key"
               @bind="Settings.TmdbApiKey" />
        <small class="form-text text-muted">
            Get a free API key at
            <a href="https://www.themoviedb.org/settings/api" target="_blank" rel="noopener">themoviedb.org/settings/api</a>.
            Required for automatic metadata enrichment of movies and TV series.
        </small>
    </div>

    @if (!string.IsNullOrWhiteSpace(Settings.TmdbApiKey))
    {
        <div class="form-group">
            <label>Coverage</label>
            <ul class="coverage-list">
                <li>🎬 Movie metadata (titles, overviews, ratings, genres, release dates)</li>
                <li>📺 TV series metadata (seasons, episodes, status, ratings)</li>
                <li>🎥 Movie franchise collections (Star Wars, LOTR, etc.)</li>
                <li>🖼 Poster art for movies, series, and seasons</li>
            </ul>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }

    @if (IsSaved)
    {
        <div class="alert alert-success" role="alert">
            Settings saved successfully.
        </div>
    }

    <div class="form-actions">
        <button type="button" class="btn btn-primary" @onclick="SaveSettings" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : "Save Settings")
        </button>
    </div>
</div>

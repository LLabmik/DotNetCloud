@namespace DotNetCloud.Modules.Video.UI
@using DotNetCloud.UI.Shared.Components.Navigation

@using DotNetCloud.Core.DTOs
@using DotNetCloud.Core.Authorization
@using DotNetCloud.Modules.Video.Services
@using Microsoft.JSInterop
@inject IVideoService VideoService
@inject IVideoCollectionService CollectionService
@inject ISubtitleService SubtitleService
@inject IWatchProgressService WatchProgressService
@inject IVideoMetadataService MetadataService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject DotNetCloud.Core.Services.IUserSettingsService UserSettingsService
@inject DotNetCloud.Core.Services.IMediaLibraryScanner MediaLibraryScanner
@inject DotNetCloud.Modules.Files.Services.IFileService FileService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject DotNetCloud.Modules.Video.Events.IVideoIndexingCallback VideoIndexingCallback
@inject IJSRuntime Js
@inject Microsoft.Extensions.Logging.ILogger<VideoPage> Logger
@inject IVideoEnrichmentService EnrichmentService
@inject IVideoEnrichmentBackgroundQueue EnrichmentBackgroundQueue
@inject IVideoSeriesService SeriesService
@inject VideoScanProgressState ScanProgress

<div class="video-layout">
    @* ─── Sidebar ─── *@
    <aside class="video-sidebar @(_sidebarCollapsed ? "collapsed" : "")">
        <div class="video-sidebar-header">
            @if (!_sidebarCollapsed)
            {
                <h2 class="video-sidebar-title">Video</h2>
            }
            <button class="video-sidebar-toggle" @onclick="ToggleSidebar" title="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
                <span>@(_sidebarCollapsed ? "▶" : "◀")</span>
            </button>
        </div>

        <div class="video-sidebar-content">
        <nav class="video-nav">
            <button class="video-nav-item @(_section == Section.Home ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Home)" title="Home">
                <span class="nav-icon">🏠</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Home</span>
                }
            </button>
            <button class="video-nav-item @(_section == Section.Library ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Library)" title="Library">
                <span class="nav-icon">🎬</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Library</span>
                }
            </button>
            <button class="video-nav-item @(_section == Section.Series ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Series)" title="Series">
                <span class="nav-icon">📺</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Series</span>
                }
            </button>
            <button class="video-nav-item @(_section == Section.Collections ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Collections)" title="Collections">
                <span class="nav-icon">📁</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Collections</span>
                }
            </button>
            <button class="video-nav-item @(_section == Section.Favorites ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Favorites)" title="Favorites">
                <span class="nav-icon">⭐</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Favorites</span>
                }
            </button>
        </nav>

        <div class="video-nav-separator"></div>
        <nav class="video-nav">
            <button class="video-nav-item @(_section == Section.Settings ? "active" : "")"
                    @onclick="() => SwitchSection(Section.Settings)" title="Library Settings">
                <span class="nav-icon">⚙</span>
                @if (!_sidebarCollapsed)
                {
                    <span class="video-nav-text">Library Settings</span>
                }
            </button>
        </nav>

        @* ── Collections in sidebar ── *@
        @if (!_sidebarCollapsed && _collections.Count > 0)
        {
            <div class="video-nav-separator"></div>
            <div class="sidebar-collections">
                <div class="sidebar-collections-header">
                    <span class="label-muted">Collections</span>
                    <button class="btn-icon" @onclick="BeginCreateCollection" title="New Collection">+</button>
                </div>
                @foreach (var coll in _collections)
                {
                    var capturedColl = coll;
                    <button class="sidebar-collection-item @(_selectedCollectionId == capturedColl.Id ? "active" : "")"
                            @onclick="() => SelectCollectionAsync(capturedColl.Id)">
                        <span class="coll-icon">📂</span>
                        <span class="coll-name">@capturedColl.Name</span>
                        <span class="coll-count">@capturedColl.VideoCount</span>
                    </button>
                }
            </div>
        }
        </div>

        <ModuleHelpLink ModuleId="video" Collapsed="_sidebarCollapsed" />
    </aside>

    @* ─── Main Content ─── *@
    <main class="video-main">
        @* Toolbar *@
        <div class="video-toolbar">
            <div class="toolbar-left">
                @if (_breadcrumb.Count > 0)
                {
                    @foreach (var crumb in _breadcrumb)
                    {
                        <button type="button" class="breadcrumb-item" @onclick="crumb.Action">@crumb.Label</button>
                        <span class="breadcrumb-sep">›</span>
                    }
                }
                <h3 class="section-title">@GetSectionTitle()</h3>
            </div>
            <div class="toolbar-right">
                <div class="search-box">
                    <input type="text" placeholder="Search videos…"
                           @bind="_searchQuery" @bind:event="oninput"
                           @onkeyup="HandleSearchKeyUp" />
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="video-loading">
                <div class="loading-spinner"></div>
                <p>Loading…</p>
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="video-error">
                <p>@_errorMessage</p>
                <button class="btn-retry" @onclick="LoadCurrentSectionAsync">Retry</button>
            </div>
        }
        else
        {
            @* ─── Home ─── *@
            @if (_section == Section.Home && !_playerOpen && _searchResults is null)
            {
                <div class="home-content">
                    @if (_continueWatching.Count > 0)
                    {
                        <section class="video-section">
                            <h4>Continue Watching</h4>
                            <div class="video-carousel">
                                @foreach (var wp in _continueWatching)
                                {
                                    var capturedWp = wp;
                                    <div class="video-card continue-card"
                                         @onclick="() => OpenPlayerForContinueAsync(capturedWp)">
                                        <div class="video-thumb">
                                            <img src="@GetThumbnailUrl(capturedWp.VideoId)" alt="@capturedWp.VideoTitle" loading="lazy" />
                                            <div class="video-progress-bar">
                                                <div class="video-progress-fill" style="width: @capturedWp.ProgressPercent%"></div>
                                            </div>
                                            <span class="thumb-overlay-play">▶</span>
                                        </div>
                                        <div class="video-card-info">
                                            <span class="video-card-title">@capturedWp.VideoTitle</span>
                                            <span class="video-card-meta">@((int)capturedWp.ProgressPercent)% watched</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (_recentVideos.Count > 0)
                    {
                        <section class="video-section">
                            <h4>Recently Added</h4>
                            <div class="videos-toolbar">
                                <button class="btn-icon" @onclick="PrevRecentPageAsync" disabled="@(_recentPage == 0)" title="Previous page">
                                    <span>◀</span>
                                </button>
                                @if (!string.IsNullOrWhiteSpace(FirstRecentVideoTitle))
                                {
                                    <span class="page-edge-name page-edge-name-start" title="@FirstRecentVideoTitle">@FirstRecentVideoTitle</span>
                                }
                                <div class="videos-page-info">
                                    <span>Showing @(_recentVideos.Count == 0 ? 0 : _recentPage * RecentPageSize + 1)-@(_recentPage * RecentPageSize + _recentVideos.Count) of @_totalRecentVideos videos</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(LastRecentVideoTitle))
                                {
                                    <span class="page-edge-name page-edge-name-end" title="@LastRecentVideoTitle">@LastRecentVideoTitle</span>
                                }
                                <button class="btn-icon" @onclick="NextRecentPageAsync" disabled="@(!_hasMoreRecent)" title="Next page">
                                    <span>▶</span>
                                </button>
                            </div>
                            <div class="video-grid">
                                @foreach (var video in _recentVideos)
                                {
                                    var capturedVideo = video;
                                    <div class="video-card"
                                         @onclick="() => OpenVideoDetailAsync(capturedVideo)">
                                        <div class="video-thumb">
                                            <img src="@GetThumbnailUrl(capturedVideo.Id)" alt="@capturedVideo.Title" loading="lazy" />
                                            <span class="thumb-duration">@FormatDuration(capturedVideo.Duration)</span>
                                            <span class="thumb-overlay-play">▶</span>
                                        </div>
                                        <div class="video-card-info">
                                            <span class="video-card-title">@capturedVideo.Title</span>
                                            <span class="video-card-meta">@FormatFileSize(capturedVideo.SizeBytes) · @FormatResolution(capturedVideo.Width, capturedVideo.Height)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (_continueWatching.Count == 0 && _recentVideos.Count == 0)
                    {
                        <div class="video-empty">
                            <div class="empty-icon">🎬</div>
                            <h4>No videos in your library</h4>
                            <p>Upload video files through the Files module. Supported formats: MP4, MKV, AVI, MOV, WEBM, FLV.</p>
                        </div>
                    }
                </div>
            }

            @* ─── Library (unified view — series first, then standalone videos, single paging) ─── *@
            @if (_section == Section.Library && !_playerOpen && _searchResults is null)
            {
                @if (_libraryContent is null || (_libraryContent.Series.Count == 0 && _libraryContent.StandaloneVideos.Count == 0))
                {
                    <div class="video-empty">
                        <div class="empty-icon">🎬</div>
                        <h4>Your video library is empty</h4>
                        <p>Upload video files through the Files module, then configure a library path in Settings.</p>
                    </div>
                }
                else
                {
                    var pageStart = _videoPage * VideoPageSize + 1;
                    var pageEnd = _videoPage * VideoPageSize + _libraryContent.Series.Count + _libraryContent.StandaloneVideos.Count;

                    @* ── Unified toolbar (single paging for the combined view) ── *@
                    <div class="videos-toolbar">
                        <button class="btn-icon" @onclick="PrevVideoPageAsync" disabled="@(_videoPage == 0)" title="Previous page">
                            <span>◀</span>
                        </button>
                        <div class="videos-page-info">
                            <span>Showing @pageStart-@pageEnd of @_totalVideos items</span>
                        </div>
                        <button class="btn-icon" @onclick="NextVideoPageAsync" disabled="@(!_hasMoreVideos)" title="Next page">
                            <span>▶</span>
                        </button>
                    </div>

                    @if (_libraryPaging)
                    {
                        <div class="video-loading" style="padding: 48px 0;">
                            <div class="loading-spinner"></div>
                            <p>Loading…</p>
                        </div>
                    }
                    else
                    {
                    <section class="video-section">
                        @* ── Series cards (shown first) ── *@
                        @if (_libraryContent.Series.Count > 0)
                        {
                            <div class="series-grid">
                                @foreach (var series in _libraryContent.Series)
                                {
                                    var capturedSeries = series;
                                    <div class="series-card"
                                         @onclick="() => OpenSeriesDetailAsync(capturedSeries)">
                                        <div class="series-card-poster">
                                            @if (series.HasExternalPoster)
                                            {
                                                <img src="@GetSeriesThumbnailUrl(series.Id)" alt="@series.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="series-card-poster-placeholder">
                                                    <span class="series-placeholder-icon">📺</span>
                                                </div>
                                            }
                                            <div class="series-card-type-badge">
                                                @(series.Type == "TvSeries" ? "TV Series" : "Franchise")
                                            </div>
                                        </div>
                                        <div class="series-card-info">
                                            <span class="series-card-title">@series.Name</span>
                                            <span class="series-card-meta">
                                                @if (series.Year.HasValue)
                                                {
                                                    <text>@series.Year.Value</text>
                                                    if (series.TotalEpisodes > 0) { <text> · </text> }
                                                }
                                                @if (series.TotalEpisodes > 0)
                                                {
                                                    if (series.Type == "TvSeries")
                                                    {
                                                        <text>@series.TotalSeasons seasons · @series.TotalEpisodes episodes</text>
                                                    }
                                                    else
                                                    {
                                                        <text>@series.TotalEpisodes videos</text>
                                                    }
                                                }
                                            </span>
                                            @if (series.TmdbRating.HasValue)
                                            {
                                                <span class="series-card-rating">★ @series.TmdbRating.Value.ToString("F1")</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @* ── Standalone video cards (shown after series) ── *@
                        @if (_libraryContent.StandaloneVideos.Count > 0)
                        {
                            <div class="video-grid padded">
                                @foreach (var video in _libraryContent.StandaloneVideos)
                                {
                                    var capturedVideo = video;
                                    <div class="video-card"
                                         @onclick="() => OpenVideoDetailAsync(capturedVideo)">
                                        <div class="video-thumb">
                                            <img src="@GetThumbnailUrl(capturedVideo.Id)" alt="@capturedVideo.Title" loading="lazy" />
                                            <span class="thumb-duration">@FormatDuration(capturedVideo.Duration)</span>
                                            @if (capturedVideo.WatchPositionTicks.HasValue && capturedVideo.Duration.Ticks > 0)
                                            {
                                                <div class="video-progress-bar">
                                                    <div class="video-progress-fill" style="width: @GetWatchPercent(capturedVideo)%"></div>
                                                </div>
                                            }
                                            <span class="thumb-overlay-play">▶</span>
                                        </div>
                                        <div class="video-card-info">
                                            <span class="video-card-title">@capturedVideo.Title</span>
                                            <span class="video-card-meta">
                                                @FormatFileSize(capturedVideo.SizeBytes)
                                                @if (capturedVideo.ViewCount > 0)
                                                {
                                                    <text> · @capturedVideo.ViewCount views</text>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                    }
                }
            }

            @* ─── Collections list ─── *@
            @if (_section == Section.Collections && _selectedCollection is null && !_playerOpen && _searchResults is null)
            {
                <div class="collections-grid">
                    @foreach (var coll in _collections)
                    {
                        var capturedColl = coll;
                        <div class="collection-card"
                             @onclick="() => SelectCollectionAsync(capturedColl.Id)">
                            <div class="collection-card-icon">📁</div>
                            <div class="collection-card-info">
                                <span class="collection-card-title">@capturedColl.Name</span>
                                <span class="collection-card-meta">@capturedColl.VideoCount videos · @FormatDuration(capturedColl.TotalDuration)</span>
                                @if (!string.IsNullOrWhiteSpace(capturedColl.Description))
                                {
                                    <span class="collection-card-desc">@capturedColl.Description</span>
                                }
                            </div>
                            <div class="collection-card-actions" @onclick:stopPropagation="true">
                                <button type="button" class="btn-icon-action" @onclick="() => BeginEditCollection(capturedColl)" title="Edit">✎</button>
                                <button type="button" class="btn-icon-action danger" @onclick="() => DeleteCollectionAsync(capturedColl.Id)" title="Delete">🗑</button>
                            </div>
                        </div>
                    }
                    @if (_collections.Count == 0)
                    {
                        <div class="video-empty">
                            <div class="empty-icon">📁</div>
                            <h4>No collections yet</h4>
                            <p>Create a collection to organize your videos.</p>
                            <button type="button" class="btn-primary" @onclick="BeginCreateCollection" style="margin-top:12px">Create Collection</button>
                        </div>
                    }
                </div>
            }

            @* ─── Collection detail ─── *@
            @if (_section == Section.Collections && _selectedCollection is not null && !_playerOpen && _searchResults is null)
            {
                <div class="collection-detail">
                    <div class="collection-detail-header">
                        <div>
                            <h3>@_selectedCollection.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(_selectedCollection.Description))
                            {
                                <p class="collection-desc">@_selectedCollection.Description</p>
                            }
                            <span class="collection-meta-detail">@_selectedCollection.VideoCount videos · @FormatDuration(_selectedCollection.TotalDuration)</span>
                        </div>
                    </div>

                    @if (_collectionContent is not null)
                    {
                        @* ── Series in collection (shown first) ── *@
                        @if (_collectionContent.Series.Count > 0)
                        {
                            <section class="video-section">
                                <h4>Series</h4>
                                <div class="series-grid">
                                    @foreach (var series in _collectionContent.Series)
                                    {
                                        var capturedSeries = series;
                                        <div class="series-card"
                                             @onclick="() => OpenSeriesDetailAsync(capturedSeries)">
                                            <div class="series-card-poster">
                                                @if (series.HasExternalPoster)
                                                {
                                                    <img src="@GetSeriesThumbnailUrl(series.Id)" alt="@series.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <div class="series-card-poster-placeholder">
                                                        <span class="series-placeholder-icon">📺</span>
                                                    </div>
                                                }
                                                <div class="series-card-type-badge">
                                                    @(series.Type == "TvSeries" ? "TV Series" : "Franchise")
                                                </div>
                                            </div>
                                            <div class="series-card-info">
                                                <span class="series-card-title">@series.Name</span>
                                                <span class="series-card-meta">
                                                    @if (series.Year.HasValue)
                                                    {
                                                        <text>@series.Year.Value</text>
                                                        if (series.TotalEpisodes > 0) { <text> · </text> }
                                                    }
                                                    @if (series.TotalEpisodes > 0)
                                                    {
                                                        if (series.Type == "TvSeries")
                                                        {
                                                            <text>@series.TotalSeasons seasons · @series.TotalEpisodes episodes</text>
                                                        }
                                                        else
                                                        {
                                                            <text>@series.TotalEpisodes videos</text>
                                                        }
                                                    }
                                                </span>
                                                @if (series.TmdbRating.HasValue)
                                                {
                                                    <span class="series-card-rating">★ @series.TmdbRating.Value.ToString("F1")</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                        @* ── Standalone videos in collection ── *@
                        @if (_collectionContent.StandaloneVideos.Count > 0)
                        {
                            <section class="video-section">
                                <h4>Videos</h4>
                                <div class="video-grid">
                                    @foreach (var video in _collectionContent.StandaloneVideos)
                                    {
                                        var capturedVideo = video;
                                        <div class="video-card"
                                             @onclick="() => OpenVideoDetailAsync(capturedVideo)">
                                            <div class="video-thumb">
                                                <img src="@GetThumbnailUrl(capturedVideo.Id)" alt="@capturedVideo.Title" loading="lazy" />
                                                <span class="thumb-duration">@FormatDuration(capturedVideo.Duration)</span>
                                                <span class="thumb-overlay-play">▶</span>
                                            </div>
                                            <div class="video-card-info">
                                                <span class="video-card-title">@capturedVideo.Title</span>
                                                <span class="video-card-meta">@FormatFileSize(capturedVideo.SizeBytes)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                        @if (_collectionContent.Series.Count == 0 && _collectionContent.StandaloneVideos.Count == 0)
                        {
                            <div class="video-empty" style="padding: 32px;">
                                <p>This collection is empty.</p>
                            </div>
                        }
                    }
                </div>
            }

            @* ─── Favorites ─── *@
            @if (_section == Section.Favorites && !_playerOpen && _searchResults is null)
            {
                @if (_favoriteVideos.Count == 0)
                {
                    <div class="video-empty">
                        <div class="empty-icon">⭐</div>
                        <h4>No favorites yet</h4>
                        <p>Favorite videos to see them here.</p>
                    </div>
                }
                else
                {
                    <div class="video-grid padded">
                        @foreach (var video in _favoriteVideos)
                        {
                            var capturedVideo = video;
                            <div class="video-card"
                                 @onclick="() => OpenVideoDetailAsync(capturedVideo)">
                                <div class="video-thumb">
                                    <img src="@GetThumbnailUrl(capturedVideo.Id)" alt="@capturedVideo.Title" loading="lazy" />
                                    <span class="thumb-duration">@FormatDuration(capturedVideo.Duration)</span>
                                    <span class="thumb-overlay-play">▶</span>
                                </div>
                                <div class="video-card-info">
                                    <span class="video-card-title">@capturedVideo.Title</span>
                                    <span class="video-card-meta">@FormatFileSize(capturedVideo.SizeBytes) · @capturedVideo.ViewCount views</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @* ─── Series list ─── *@
            @if (_section == Section.Series && _selectedSeries is null && !_playerOpen && _searchResults is null)
            {
                @if (_seriesList.Count == 0)
                {
                    <div class="video-empty">
                        <div class="empty-icon">📺</div>
                        <h4>No series yet</h4>
                        <p>Series are auto-detected when scanning your video library. Files named like "Show.Name.S01E01.mp4" or organized in "Show Name/Season 01/" folders are grouped automatically.</p>
                    </div>
                }
                else
                {
                    @if (_totalSeries > SeriesPageSize)
                    {
                        <div class="videos-toolbar">
                            <button class="btn-icon" @onclick="PrevSeriesPageAsync" disabled="@(_seriesPage == 0)" title="Previous page">
                                <span>◀</span>
                            </button>
                            @if (!string.IsNullOrWhiteSpace(FirstSeriesName))
                            {
                                <span class="page-edge-name page-edge-name-start" title="@FirstSeriesName">@FirstSeriesName</span>
                            }
                            <div class="videos-page-info">
                                <span>Showing @(_seriesPage * SeriesPageSize + 1)-@(_seriesPage * SeriesPageSize + _seriesList.Count) of @_totalSeries series</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(LastSeriesName))
                            {
                                <span class="page-edge-name page-edge-name-end" title="@LastSeriesName">@LastSeriesName</span>
                            }
                            <button class="btn-icon" @onclick="NextSeriesPageAsync" disabled="@(!_hasMoreSeries)" title="Next page">
                                <span>▶</span>
                            </button>
                        </div>
                    }
                    <div class="series-grid">
                        @foreach (var series in _seriesList)
                        {
                            var capturedSeries = series;
                            <div class="series-card"
                                 @onclick="() => OpenSeriesDetailAsync(capturedSeries)">
                                <div class="series-card-poster">
                                    @if (series.HasExternalPoster)
                                    {
                                        <img src="@GetSeriesThumbnailUrl(series.Id)" alt="@series.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="series-card-poster-placeholder">
                                            <span class="series-placeholder-icon">📺</span>
                                        </div>
                                    }
                                    <div class="series-card-type-badge">
                                        @(series.Type == "TvSeries" ? "TV Series" : "Franchise")
                                    </div>
                                </div>
                                <div class="series-card-info">
                                    <span class="series-card-title">@series.Name</span>
                                    <span class="series-card-meta">
                                        @if (series.Year.HasValue)
                                        {
                                            <text>@series.Year.Value</text>
                                            if (series.TotalEpisodes > 0) { <text> · </text> }
                                        }
                                        @if (series.TotalEpisodes > 0)
                                        {
                                            if (series.Type == "TvSeries")
                                            {
                                                <text>@series.TotalSeasons seasons · @series.TotalEpisodes episodes</text>
                                            }
                                            else
                                            {
                                                <text>@series.TotalEpisodes videos</text>
                                            }
                                        }
                                    </span>
                                    @if (series.TmdbRating.HasValue)
                                    {
                                        <span class="series-card-rating">★ @series.TmdbRating.Value.ToString("F1")</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @* ─── Series detail (TV Series — seasons) ─── *@
            @if (_section == Section.Series && _selectedSeries is not null && _selectedSeason is null && !_playerOpen && _searchResults is null)
            {
                <div class="series-detail">
                    <div class="series-detail-header">
                        <div class="series-detail-poster">
                            @if (_selectedSeries.HasExternalPoster)
                            {
                                <img src="@GetSeriesThumbnailUrl(_selectedSeries.Id)" alt="@_selectedSeries.Name" />
                            }
                            else
                            {
                                <div class="series-detail-poster-placeholder">
                                    <span>📺</span>
                                </div>
                            }
                        </div>
                        <div class="series-detail-info">
                            <div class="series-detail-type-badge">
                                @(_selectedSeries.Type == "TvSeries" ? "TV Series" : "Movie Franchise")
                            </div>
                            <h3>@_selectedSeries.Name</h3>
                            @if (_selectedSeries.TmdbRating.HasValue)
                            {
                                <div class="series-detail-rating">★ @_selectedSeries.TmdbRating.Value.ToString("F1") / 10</div>
                            }
                            @if (_selectedSeries.Year.HasValue || _selectedSeries.Status is not null)
                            {
                                <div class="series-detail-year-status">
                                    @if (_selectedSeries.Year.HasValue)
                                    {
                                        <span>@_selectedSeries.Year.Value</span>
                                    }
                                    @if (_selectedSeries.Status is not null)
                                    {
                                        <span class="series-detail-status">@_selectedSeries.Status</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedSeries.Genres))
                            {
                                <div class="tmdb-genres" style="margin-top: 8px;">
                                    @foreach (var genre in _selectedSeries.Genres.Split(", "))
                                    {
                                        <span class="tmdb-genre-tag">@genre</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedSeries.Description))
                            {
                                <p class="series-detail-desc">@_selectedSeries.Description</p>
                            }
                            <div class="series-detail-stats">
                                <span>@_selectedSeries.TotalSeasons seasons</span>
                                <span>·</span>
                                <span>@_selectedSeries.TotalEpisodes episodes</span>
                            </div>
                        </div>
                    </div>

                    @if (_selectedSeries.Type == "TvSeries")
                    {
                        <div class="seasons-list">
                            <h4 class="seasons-list-title">Seasons</h4>
                            @if (_seriesSeasons.Count == 0)
                            {
                                <div class="video-empty" style="padding: 32px;">
                                    <p>No seasons found in this series.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var season in _seriesSeasons)
                                {
                                    var capturedSeason = season;
                                    <div class="season-card"
                                         @onclick="() => OpenSeasonDetailAsync(capturedSeason)">
                                        <div class="season-card-poster">
                                            @if (season.HasExternalPoster)
                                            {
                                                <img src="/api/v1/videos/season/@season.Id/thumbnail" alt="@(season.Name ?? $"Season {season.SeasonNumber}")" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="season-card-poster-placeholder">
                                                    <span class="season-placeholder-num">@season.SeasonNumber</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="season-card-info">
                                            <span class="season-card-name">@(season.Name ?? $"Season {season.SeasonNumber}")</span>
                                            <span class="season-card-meta">@season.EpisodeCount episodes</span>
                                            @if (!string.IsNullOrWhiteSpace(season.Overview))
                                            {
                                                <span class="season-card-overview">@season.Overview</span>
                                            }
                                            @if (season.AirDate.HasValue)
                                            {
                                                <span class="season-card-airdate">@season.AirDate.Value.ToString("yyyy")</span>
                                            }
                                        </div>
                                        <div class="season-card-arrow">›</div>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        @* Movie franchise — show videos in order *@
                        <div class="series-videos-list">
                            <h4 class="seasons-list-title">Videos</h4>
                            @if (_seriesVideos.Count == 0)
                            {
                                <div class="video-empty" style="padding: 32px;">
                                    <p>No videos in this franchise yet.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var item in _seriesVideos)
                                {
                                    var capturedItem = item;
                                    <div class="episode-row"
                                         @onclick="() => OpenSeriesVideoAsync(capturedItem)">
                                        <div class="episode-row-num">@item.SortOrder</div>
                                        <div class="episode-row-thumb">
                                            @if (item.Video is not null)
                                            {
                                                <img src="@GetThumbnailUrl(item.Video.Id)" alt="@(item.EpisodeTitle ?? item.Video?.Title ?? "")" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="episode-row-thumb-placeholder">🎬</div>
                                            }
                                            <span class="thumb-overlay-play">▶</span>
                                        </div>
                                        <div class="episode-row-info">
                                            <span class="episode-row-title">@(item.EpisodeTitle ?? item.Video?.Title ?? "Unknown")</span>
                                            @if (item.Video is not null)
                                            {
                                                <span class="episode-row-meta">
                                                    @FormatDuration(item.Video.Duration) · @FormatFileSize(item.Video.SizeBytes)
                                                </span>
                                            }
                                        </div>
                                        <div class="episode-row-play">▶</div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @* ─── Season detail (episodes) ─── *@
            @if (_section == Section.Series && _selectedSeries is not null && _selectedSeason is not null && !_playerOpen && _searchResults is null)
            {
                <div class="season-detail">
                    <div class="season-detail-header">
                        <div>
                            <h3>@(_selectedSeason.Name ?? $"Season {_selectedSeason.SeasonNumber}")</h3>
                            <span class="season-detail-meta">@_selectedSeason.EpisodeCount episodes</span>
                            @if (!string.IsNullOrWhiteSpace(_selectedSeason.Overview))
                            {
                                <p class="season-detail-overview">@_selectedSeason.Overview</p>
                            }
                        </div>
                    </div>

                    <div class="episodes-list">
                        @if (_seasonEpisodes.Count == 0)
                        {
                            <div class="video-empty" style="padding: 32px;">
                                <p>No episodes in this season yet.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var episode in _seasonEpisodes)
                            {
                                var capturedEpisode = episode;
                                <div class="episode-row"
                                     @onclick="() => OpenEpisodeVideoAsync(capturedEpisode)">
                                    <div class="episode-row-num">@episode.EpisodeNumber</div>
                                    <div class="episode-row-thumb">
                                        @if (episode.Video is not null)
                                        {
                                            <img src="@GetThumbnailUrl(episode.Video.Id)" alt="@(episode.Title ?? episode.Video?.Title ?? "")" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="episode-row-thumb-placeholder">🎬</div>
                                        }
                                        <span class="thumb-overlay-play">▶</span>
                                    </div>
                                    <div class="episode-row-info">
                                        <span class="episode-row-title">@(episode.Title ?? episode.Video?.Title ?? $"Episode {episode.EpisodeNumber}")</span>
                                        @if (!string.IsNullOrWhiteSpace(episode.Overview))
                                        {
                                            <span class="episode-row-overview">@episode.Overview</span>
                                        }
                                        @if (episode.Video is not null)
                                        {
                                            <span class="episode-row-meta">
                                                @FormatDuration(episode.Video.Duration) · @FormatFileSize(episode.Video.SizeBytes)
                                            </span>
                                        }
                                    </div>
                                    <div class="episode-row-play">▶</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @* ─── Search Results ─── *@
            @if (_searchResults is not null && !_playerOpen)
            {
                <div class="search-results">
                    <h4>Results for "@_searchQuery"</h4>

                    @* ── Series matches ── *@
                    @if (_searchResults.Series.Count > 0)
                    {
                        <section class="video-section">
                            <h5>Series</h5>
                            <div class="series-grid">
                                @foreach (var series in _searchResults.Series)
                                {
                                    var capturedSeries = series;
                                    <div class="series-card"
                                         @onclick="() => OpenSeriesDetailAsync(capturedSeries)">
                                        <div class="series-card-poster">
                                            @if (series.HasExternalPoster)
                                            {
                                                <img src="@GetSeriesThumbnailUrl(series.Id)" alt="@series.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="series-card-poster-placeholder">
                                                    <span class="series-placeholder-icon">📺</span>
                                                </div>
                                            }
                                            <div class="series-card-type-badge">
                                                @(series.Type == "TvSeries" ? "TV Series" : "Franchise")
                                            </div>
                                        </div>
                                        <div class="series-card-info">
                                            <span class="series-card-title">@series.Name</span>
                                            <span class="series-card-meta">
                                                @if (series.Year.HasValue)
                                                {
                                                    <text>@series.Year.Value</text>
                                                    if (series.TotalEpisodes > 0) { <text> · </text> }
                                                }
                                                @if (series.TotalEpisodes > 0)
                                                {
                                                    if (series.Type == "TvSeries")
                                                    {
                                                        <text>@series.TotalSeasons seasons · @series.TotalEpisodes episodes</text>
                                                    }
                                                    else
                                                    {
                                                        <text>@series.TotalEpisodes videos</text>
                                                    }
                                                }
                                            </span>
                                            @if (series.TmdbRating.HasValue)
                                            {
                                                <span class="series-card-rating">★ @series.TmdbRating.Value.ToString("F1")</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @* ── Video matches ── *@
                    @if (_searchResults.StandaloneVideos.Count > 0)
                    {
                        <section class="video-section">
                            <h5>Videos</h5>
                            <div class="video-grid padded">
                                @foreach (var video in _searchResults.StandaloneVideos)
                                {
                                    var capturedVideo = video;
                                    <div class="video-card"
                                         @onclick="() => OpenVideoDetailAsync(capturedVideo)">
                                        <div class="video-thumb">
                                            <img src="@GetThumbnailUrl(capturedVideo.Id)" alt="@capturedVideo.Title" loading="lazy" />
                                            <span class="thumb-duration">@FormatDuration(capturedVideo.Duration)</span>
                                            <span class="thumb-overlay-play">▶</span>
                                        </div>
                                        <div class="video-card-info">
                                            <span class="video-card-title">@capturedVideo.Title</span>
                                            <span class="video-card-meta">@FormatFileSize(capturedVideo.SizeBytes)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (_searchResults.Series.Count == 0 && _searchResults.StandaloneVideos.Count == 0)
                    {
                        <div class="video-empty" style="padding: 32px;">
                            <p>No results found for "@_searchQuery".</p>
                        </div>
                    }
                </div>
            }

            @* ─── Library Settings ─── *@
            @if (_section == Section.Settings)
            {
                <div class="module-settings-section">
                    <div class="settings-card">
                        <h4>Video Library</h4>
                        <p class="hint">Select one or more Files folders for your video library. Owned folders and
                            admin shared folders mounted under _DotNetCloud are both supported, and overlapping folders are deduplicated during scans.</p>
                        <div class="form-group">
                            <label>Selected Sources</label>
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                                @if (_librarySources.Count == 0)
                                {
                                    <div class="hint" style="padding: 12px; border: 1px dashed rgba(255,255,255,0.16); border-radius: 12px;">
                                        No sources selected yet. Add folders from your library or from _DotNetCloud shared mounts.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var source in _librarySources)
                                    {
                                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; background: rgba(255,255,255,0.03);">
                                            <div style="display: flex; flex-direction: column; gap: 4px; min-width: 0;">
                                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                                    <span class="tag-chip">@GetLibrarySourceKindLabel(source)</span>
                                                    <strong>@source.DisplayName</strong>
                                                </div>
                                                <span class="hint" style="word-break: break-word;">@source.DisplayPath</span>
                                            </div>
                                            <button type="button" class="btn btn-outline btn-sm" @onclick="() => RemoveLibrarySource(source)">Remove</button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="settings-actions">
                            <button type="button" class="btn btn-outline btn-sm" @onclick="OpenDirectoryBrowser">Add Source…</button>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveLibraryPathAsync"
                                    disabled="@_settingsSaving">
                                @(_settingsSaving ? "Saving..." : "Save Sources")
                            </button>
                            <button type="button" class="btn btn-outline btn-sm" @onclick="ScanLibraryAsync"
                                    disabled="@(_settingsScanning || _librarySources.Count == 0)">
                                @(_settingsScanning ? "Scanning..." : "Scan Now")
                            </button>
                            @if (_isScanActive)
                            {
                                <button type="button" class="btn btn-danger btn-sm" @onclick="StopScan">
                                    ⏹ Stop Indexing
                                </button>
                            }
                        </div>
                        @* ─── Scan Progress Panel ─── *@
                        @if (_isScanActive)
                        {
                            var p = _currentScanProgress;
                            <div class="scan-progress-panel">
                                @if (p is not null)
                                {
                                    <div class="scan-progress-header">
                                        <span class="scan-phase">@p.Phase</span>
                                        <span class="scan-elapsed">@FormatDuration(p.ElapsedTime)</span>
                                    </div>
                                    <div class="scan-progress-bar">
                                        @if (p.Phase == "Discovering files..." || p.TotalFiles == 0)
                                        {
                                            <div class="scan-progress-fill indeterminate"></div>
                                        }
                                        else
                                        {
                                            <div class="scan-progress-fill" style="width: @(p.PercentComplete)%"></div>
                                        }
                                    </div>
                                    <div class="scan-progress-detail">
                                        @if (!string.IsNullOrEmpty(p.CurrentFile))
                                        {
                                            <span class="scan-current-file" title="@p.CurrentFile">@TruncateFileName(p.CurrentFile, 60)</span>
                                        }
                                        <div class="scan-counts">
                                            @if (p.FilesDiscovered > 0 && p.TotalFiles == 0)
                                            {
                                                <span class="scan-count discovered">@p.FilesDiscovered files found</span>
                                            }
                                            else
                                            {
                                                <span class="scan-count added">+@p.TracksAdded added</span>
                                                <span class="scan-count updated">↻@p.TracksUpdated updated</span>
                                                <span class="scan-count skipped">→@p.TracksSkipped skipped</span>
                                                @if (p.TracksFailed > 0)
                                                {
                                                    <span class="scan-count failed">✕@p.TracksFailed failed</span>
                                                }
                                                @if (p.AlbumArtFetched > 0)
                                                {
                                                    <span class="scan-count art">🎨@p.AlbumArtFetched covers</span>
                                                }
                                                @if (p.AlbumArtRemaining > 0)
                                                {
                                                    <span class="scan-count art">⌛@p.AlbumArtRemaining art left</span>
                                                }
                                                @if (p.TmdbEnriched > 0)
                                                {
                                                    <span class="scan-count tmdb">🎬@p.TmdbEnriched TMDB</span>
                                                }
                                                @if (p.ScreenshotFallback > 0)
                                                {
                                                    <span class="scan-count fallback">🖼️@p.ScreenshotFallback screenshots</span>
                                                }
                                            }
                                        </div>
                                        @if (p.TotalFiles > 0)
                                        {
                                            <span class="scan-file-count">@p.FilesProcessed / @p.TotalFiles files (@p.PercentComplete%)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="scan-progress-header">
                                        <span class="scan-phase">Scan starting…</span>
                                    </div>
                                    <div class="scan-progress-bar">
                                        <div class="scan-progress-fill indeterminate"></div>
                                    </div>
                                }
                            </div>
                        }

                        @if (_scanResult is not null)
                        {
                            <div class="scan-result-banner">
                                Found @_scanResult.TotalFound · Imported @_scanResult.Imported · Skipped @_scanResult.Skipped
                                @if (_scanResult.Removed > 0)
                                {
                                    <span> · Removed @_scanResult.Removed</span>
                                }
                                @if (_scanResult.Failed > 0)
                                {
                                    <span class="text-danger"> · Failed @_scanResult.Failed</span>
                                }
                            </div>
                        }

                        @* ─── Enrichment Result Banner ─── *@
                        @if (_lastEnrichmentResult is not null && !_isScanActive)
                        {
                            <div class="enrichment-result-banner" style="margin-top: 12px; padding: 12px; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; background: rgba(255,255,255,0.03);">
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                    <strong>Enrichment Complete</strong>
                                    <span class="hint">@FormatDuration(_lastEnrichmentResult.ElapsedTime)</span>
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px;">
                                    <span>🎬 @_lastEnrichmentResult.TmdbEnriched from TMDB</span>
                                    <span>🖼️ @_lastEnrichmentResult.ScreenshotFallback screenshot fallback</span>
                                    <span>✅ @_lastEnrichmentResult.FilesProcessed / @_lastEnrichmentResult.TotalFiles files processed</span>
                                    @if (_lastEnrichmentResult.TracksFailed > 0)
                                    {
                                        <span class="text-danger">✕ @_lastEnrichmentResult.TracksFailed failed</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_settingsError))
                        {
                            <div class="alert alert-danger" style="margin-top: 12px; font-size: 13px;">@_settingsError</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_settingsSuccess))
                        {
                            <div class="alert alert-success" style="margin-top: 12px; font-size: 13px;">@_settingsSuccess</div>
                        }

                        @if (_tmdbAvailable)
                        {
                            <div class="enrichment-settings" style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--color-border, rgba(255,255,255,0.08));">
                                <h5 style="margin-bottom: 10px;">TMDB Enrichment</h5>
                                <p class="hint" style="margin-bottom: 8px;">Auto-fetch movie posters and metadata from TMDB for videos in your library.</p>
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; cursor: pointer;">
                                    <input type="checkbox" checked="@_autoFetchMetadata" @onchange="OnAutoFetchMetadataChanged" />
                                    Auto-fetch movie metadata from TMDB after library scan
                                </label>
                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; cursor: pointer;">
                                    <input type="checkbox" checked="@_autoFetchPosters" @onchange="OnAutoFetchPostersChanged" />
                                    Auto-fetch movie posters from TMDB after library scan
                                </label>
                                <button class="btn btn-outline btn-sm" style="margin-top: 10px;"
                                        @onclick="EnrichLibraryAsync" disabled="@_settingsEnriching">
                                    @(_settingsEnriching ? "Enriching..." : "Enrich Library")
                                </button>
                                @if (!string.IsNullOrWhiteSpace(_enrichmentToast))
                                {
                                    <div class="alert alert-info" style="margin-top: 8px; font-size: 13px;">@_enrichmentToast</div>
                                }
                            </div>
                        }

                        <div class="settings-danger-zone" style="margin-top: 24px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.08);">
                            <h5 style="color: var(--color-danger, #e55); margin-bottom: 8px;">Reset Collection</h5>
                            <p class="hint" style="margin-bottom: 8px;">Deletes all indexed video metadata (videos, collections, subtitles, watch progress, watch history, shares).
                                Your actual video files are NOT affected. After resetting, click Scan Now to rebuild from scratch.</p>
                            <button class="btn btn-outline btn-sm" style="border-color: var(--color-danger, #e55); color: var(--color-danger, #e55);"
                                    @onclick="() => _showResetConfirm = true">
                                Reset Collection
                            </button>
                        </div>
                    </div>
                </div>
            }

            @* ── Reset Collection Confirmation Modal ── *@
            @if (_showResetConfirm)
            {
                <DncModal Title="Reset Video Collection" StartVisible OnClose="() => _showResetConfirm = false">
                    <ChildContent>
                        <p>Are you sure you want to <strong>reset</strong> the video collection?</p>
                        <p class="tracks-modal-warning">⚠️ This deletes all indexed video metadata (videos, collections, subtitles, watch progress, watch history, shares). Your actual video files are NOT affected.</p>
                    </ChildContent>
                    <Footer>
                        <button class="btn btn-danger" @onclick="ResetCollectionAsync" disabled="@_settingsResetting">
                            @(_settingsResetting ? "Resetting..." : "Yes, Reset")
                        </button>
                        <button class="btn btn-secondary" @onclick="() => _showResetConfirm = false">Cancel</button>
                    </Footer>
                </DncModal>
            }

            @* ─── Directory Browser Dialog ─── *@
            @if (_showDirBrowser)
            {
                <div class="folder-picker-overlay" @onclick="HideDirectoryBrowser">
                    <div class="folder-picker-dialog" @onclick:stopPropagation>
                        <div class="folder-picker-header">
                            <h3>Select Folder</h3>
                            <button type="button" class="btn-icon" @onclick="HideDirectoryBrowser" title="Close">✕</button>
                        </div>

                        <nav class="folder-picker-breadcrumbs">
                            <button type="button" class="btn btn-sm" @onclick="DirBrowserNavigateToRoot">
                                Home
                            </button>
                            @for (int i = 0; i < _dirBrowserBreadcrumbs.Count; i++)
                            {
                                var idx = i;
                                <span class="separator">/</span>
                                <button type="button" class="btn btn-sm" @onclick="() => DirBrowserNavigateToCrumb(idx)">@_dirBrowserBreadcrumbs[idx].Name</button>
                            }
                        </nav>

                        <div class="folder-picker-current-path">
                            <span class="path-label">Path:</span> @GetDirBrowserPath()
                        </div>

                        <div class="folder-picker-list">
                            @if (_dirBrowserBreadcrumbs.Count > 0)
                            {
                                <button type="button" class="folder-picker-item" @onclick="DirBrowserGoUp">
                                    📁 ..
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(_dirBrowserError))
                            {
                                <p class="text-muted folder-picker-empty">@_dirBrowserError</p>
                            }
                            else if (_dirBrowserFolders.Count == 0)
                            {
                                <p class="text-muted folder-picker-empty">No subfolders</p>
                            }
                            else
                            {
                                @foreach (var folder in _dirBrowserFolders)
                                {
                                    var capturedFolder = folder;
                                    <button type="button" class="folder-picker-item"
                                            @onclick="() => DirBrowserNavigate(capturedFolder.Id, capturedFolder.Name)">
                                        📁 @capturedFolder.Name
                                    </button>
                                }
                            }
                        </div>

                        <div class="folder-picker-actions">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="ConfirmDirectoryBrowserAsync">
                                Add this folder
                            </button>
                            <button type="button" class="btn btn-sm" @onclick="HideDirectoryBrowser">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @* ─── Video Player ─── *@
            @if (_playerOpen && _playerVideo is not null)
            {
                <div class="player-view">
                    <div id="player-container" class="player-container">
                        <video id="video-player"
                               class="video-player"
                               poster="@(_playerVideo.HasExternalPoster ? GetThumbnailUrl(_playerVideo.Id) : null)"
                               controls
                               autoplay
                               preload="auto"
                               src="@GetStreamUrl(_playerVideo!.Id)">
                            @if (_playerSubtitles.Count > 0)
                            {
                                @foreach (var sub in _playerSubtitles)
                                {
                                    <track kind="subtitles" label="@(sub.Label ?? sub.Language)"
                                           srclang="@sub.Language"
                                           src="@GetSubtitleUrl(sub.Id)"
                                           default="@sub.IsDefault" />
                                }
                            }
                        </video>

                        @if (_codecErrorMessage is not null)
                        {
                            <div class="codec-error-overlay">
                                <div class="codec-error-card">
                                    <button type="button" class="codec-error-close" @onclick="DismissCodecError" title="Dismiss" aria-label="Close error">&times;</button>
                                    <div class="codec-error-icon">⚠️</div>
                                    <h4>Video Cannot Be Played</h4>
                                    <p>@(_codecErrorGuidance ?? "Your browser was unable to play this video. This can happen if the video uses an unsupported codec or if the file failed to load.")</p>
                                    <p class="codec-error-diagnostic">@_codecErrorMessage</p>
                                    <div class="codec-error-instructions">
                                        <strong>Suggestions:</strong>
                                        <ul>
                                            <li>Try refreshing the page</li>
                                            <li>Try <strong>Google Chrome</strong> or <strong>Mozilla Firefox</strong>, which support more video formats than Edge</li>
                                            <li>On Edge, install the free
                                                <a href="ms-windows-store://pdp/?productid=9n4wgh0z6vhq" target="_blank" rel="noopener">HEVC Video Extensions</a>
                                                from the Microsoft Store for H.265 video support</li>
                                        </ul>
                                    </div>
                                    <p class="codec-error-alt">Server-side transcoding is in progress — if this message persists, try refreshing the page.</p>
                                </div>
                            </div>
                        }

                        @if (_noAudioDetected)
                        {
                            <div class="no-audio-banner">
                                <span class="no-audio-icon">🔇</span>
                                <span>
                                    <strong>No audio:</strong> This video may have an audio codec your browser cannot decode.
                                    Server-side transcoding should handle this — try refreshing if audio doesn't start within a few seconds.
                                </span>
                            </div>
                        }
                    </div>

                    <div class="player-info-panel">
                        <div class="player-info-header">
                            <div class="player-title-section">
                                <h3>@_playerVideo.Title</h3>
                                @if (_streamStrategy is not null)
                                {
                                    <span class="stream-strategy-badge stream-strategy-@_streamStrategy">
                                        @(_streamStrategy switch
                                        {
                                            "direct" => "Direct Play",
                                            "remux" => "Remuxing",
                                            "transcode" => "Transcoding",
                                            _ => _streamStrategy
                                        })
                                    </span>
                                }
                                @if (_playerSeriesContext is not null)
                                {
                                    <div class="player-series-context">
                                        @if (_playerSeriesContext.Series is not null)
                                        {
                                            <button type="button" class="breadcrumb-item" @onclick="() => NavigateToSeriesFromPlayer()">
                                                @_playerSeriesContext.Series.Name
                                            </button>
                                        }
                                        @if (_playerSeriesContext.Season is not null)
                                        {
                                            <span class="breadcrumb-sep">›</span>
                                            <button type="button" class="breadcrumb-item" @onclick="() => NavigateToSeasonFromPlayer()">
                                                @(_playerSeriesContext.Season.Name ?? $"Season {_playerSeriesContext.Season.SeasonNumber}")
                                            </button>
                                        }
                                        @if (_playerSeriesContext.EpisodeNumber.HasValue)
                                        {
                                            <span class="breadcrumb-sep">›</span>
                                            <span class="player-series-ep">Episode @_playerSeriesContext.EpisodeNumber.Value</span>
                                        }
                                        @if (_playerSeriesContext.SortOrder.HasValue)
                                        {
                                            <span class="player-series-ep">#@_playerSeriesContext.SortOrder.Value in franchise</span>
                                        }
                                    </div>
                                }
                                <span class="player-meta">
                                    @FormatResolution(_playerVideo.Width, _playerVideo.Height) ·
                                    @FormatFileSize(_playerVideo.SizeBytes) ·
                                    @_playerVideo.ViewCount views
                                </span>
                            </div>

                            <div class="player-actions">
                                <button type="button" class="btn-icon-action" @onclick="ToggleFavoriteAsync"
                                        title="@(_playerVideo.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                                    @(_playerVideo.IsFavorite ? "★" : "☆")
                                </button>
                                <button type="button" class="btn-icon-action" @onclick="() => _showAddToCollection = true" title="Add to collection">📁</button>
                                @if (_tmdbAvailable)
                                {
                                    <button type="button" class="btn-icon-action"
                                            @onclick="() => EnrichVideoAsync(_playerVideo!.Id)"
                                            disabled="@(_enrichingVideo && _enrichingVideoId == _playerVideo!.Id)"
                                            title="Fetch movie poster and metadata from TMDB">
                                        @if (_enrichingVideo && _enrichingVideoId == _playerVideo!.Id)
                                        {
                                            <span class="enrich-spinner"></span>
                                            <span>Fetching...</span>
                                        }
                                        else
                                        {
                                            <span>🎬</span>
                                        }
                                    </button>
                                }
                                <button type="button" class="btn-close-player" @onclick="ClosePlayer">✕ Close</button>
                            </div>
                        </div>

                        @* TMDB Enrichment Info *@
                        @if (_playerVideo.HasExternalPoster || _playerVideo.Overview is not null || _playerVideo.TmdbRating is not null || _playerVideo.ReleaseDate is not null
                            || _playerVideo.TmdbTagline is not null || _playerVideo.TmdbOriginalLanguage is not null || _playerVideo.TmdbOriginalTitle is not null)
                        {
                            <div class="tmdb-info-section">
                                @if (_playerVideo.HasExternalPoster)
                                {
                                    <img class="tmdb-poster" src="@GetThumbnailUrl(_playerVideo.Id)" alt="@_playerVideo.Title" />
                                }
                                <div class="tmdb-details">
                                    @if (_playerVideo.TmdbTagline is not null)
                                    {
                                        <p class="tmdb-tagline">@_playerVideo.TmdbTagline</p>
                                    }
                                    @if (_playerVideo.TmdbRating is not null)
                                    {
                                        <div class="tmdb-rating">
                                            <span class="tmdb-rating-star">★</span>
                                            <span>@_playerVideo.TmdbRating.Value.ToString("F1")</span>
                                            <span class="tmdb-rating-max">/ 10</span>
                                            @if (_playerVideo.TmdbVoteCount.HasValue)
                                            {
                                                <span class="tmdb-vote-count">· @_playerVideo.TmdbVoteCount.Value.ToString("N0") votes</span>
                                            }
                                        </div>
                                    }
                                    @if (_playerVideo.ReleaseDate is not null)
                                    {
                                        <span class="tmdb-release-year">@_playerVideo.ReleaseDate.Value.ToString("yyyy")</span>
                                    }
                                    @if (_playerVideo.Genres is not null)
                                    {
                                        <div class="tmdb-genres">
                                            @foreach (var genre in _playerVideo.Genres.Split(", "))
                                            {
                                                <span class="tmdb-genre-tag">@genre</span>
                                            }
                                        </div>
                                    }
                                    @if (_playerVideo.TmdbOriginalLanguage is not null || _playerVideo.TmdbOriginalTitle is not null)
                                    {
                                        <div class="tmdb-original-info">
                                            @if (_playerVideo.TmdbOriginalTitle is not null && !string.Equals(_playerVideo.TmdbOriginalTitle, _playerVideo.Title, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="tmdb-original-title">Original title: @_playerVideo.TmdbOriginalTitle</span>
                                            }
                                            @if (_playerVideo.TmdbOriginalLanguage is not null && !string.Equals(_playerVideo.TmdbOriginalLanguage, "en", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="tmdb-original-lang">@GetLanguageLabel(_playerVideo.TmdbOriginalLanguage)</span>
                                            }
                                        </div>
                                    }
                                    @if (_playerVideo.Overview is not null)
                                    {
                                        <p class="tmdb-overview">@_playerVideo.Overview</p>
                                    }
                                </div>
                            </div>
                        }

                        @* Technical Metadata *@
                        @if (_playerMetadata is not null)
                        {
                            <div class="metadata-grid">
                                <div class="metadata-item">
                                    <span class="metadata-label">Codec</span>
                                    <span class="metadata-value">@_playerMetadata.VideoCodec / @_playerMetadata.AudioCodec</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Framerate</span>
                                    <span class="metadata-value">@_playerMetadata.FrameRate fps</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Bitrate</span>
                                    <span class="metadata-value">@FormatBitrate(_playerMetadata.Bitrate)</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Container</span>
                                    <span class="metadata-value">@_playerMetadata.ContainerFormat</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Audio Tracks</span>
                                    <span class="metadata-value">@_playerMetadata.AudioTrackCount</span>
                                </div>
                                <div class="metadata-item">
                                    <span class="metadata-label">Subtitles</span>
                                    <span class="metadata-value">@_playerSubtitles.Count available</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </main>

    @* ─── Add to Collection Dialog ─── *@
    @if (_showAddToCollection)
    {
        <div class="dialog-overlay" @onclick="() => _showAddToCollection = false">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <h4>Add to Collection</h4>
                    <button class="btn-icon" @onclick="() => _showAddToCollection = false" aria-label="Close" title="Close">X</button>
                </div>
                <div class="collection-select-list">
                    @foreach (var coll in _collections)
                    {
                        var capturedColl = coll;
                        <button type="button" class="collection-select-item"
                                @onclick="() => AddToCollectionAsync(capturedColl.Id)">
                            <span>📂</span> @capturedColl.Name
                        </button>
                    }
                    @if (_collections.Count == 0)
                    {
                        <p class="empty-hint">No collections yet. Create one first.</p>
                    }
                </div>
                <div class="dialog-actions">
                    <button type="button" class="btn-cancel" @onclick="() => _showAddToCollection = false">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* ─── Create/Edit Collection Dialog ─── *@
    @if (_showCreateCollectionDialog || _showEditCollectionDialog)
    {
        <div class="dialog-overlay" @onclick="CloseCollectionDialog">
            <div class="dialog-panel" @onclick:stopPropagation="true">
                <div class="dialog-header">
                    <h4>@(_showEditCollectionDialog ? "Edit Collection" : "Create Collection")</h4>
                    <button class="btn-icon" @onclick="CloseCollectionDialog" aria-label="Close" title="Close">X</button>
                </div>
                <div class="dialog-form">
                    <label>Name
                        <input type="text" @bind="_collectionName" placeholder="Collection name" />
                    </label>
                    <label>Description
                        <textarea @bind="_collectionDescription" placeholder="Optional description" rows="2"></textarea>
                    </label>
                </div>
                <div class="dialog-actions">
                    <button type="button" class="btn-primary" @onclick="SaveCollectionAsync">
                        @(_showEditCollectionDialog ? "Save" : "Create")
                    </button>
                    <button type="button" class="btn-cancel" @onclick="CloseCollectionDialog">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

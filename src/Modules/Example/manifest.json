{
  "manifestVersion": 2,
  "id": "dotnetcloud.example",
  "name": "Example",
  "version": "1.0.2",
  "description": "Reference implementation of a DotNetCloud module. Demonstrates lifecycle management, capability usage, event publishing, gRPC services, and Blazor UI components.",
  "publisher": {
    "id": "dotnetcloud",
    "name": "DotNetCloud",
    "url": "https://dotnetcloud.net"
  },
  "moduleApiVersion": 1,
  "minCoreVersion": "0.7.0",
  "dataStore": "isolated",
  "handlesUserErasure": true,
  "capabilities": ["INotificationService", "IStorageProvider", "IAuditLogger"],
  "userConsentScopes": [],
  "events": {
    "publishes": ["NoteCreatedEvent", "NoteDeletedEvent"],
    "subscribes": []
  }
}

@namespace DotNetCloud.Modules.Example.UI

@* 
    Example module page - Demonstrates how modules provide Blazor UI components
    that the core web shell can load dynamically via the module plugin system.
    Layout: sidebar + main content area.
*@

<div class="example-page-layout">
    <ExampleSidebar />

    <div class="example-page-main">
        <div class="page-header">
            <h1>Example Notes</h1>
            <p class="text-muted">Reference module demonstrating notes management.</p>
        </div>

        <div class="example-actions">
            <button class="btn btn-primary" @onclick="ShowCreateForm">
                + New Note
            </button>
        </div>

        @if (_showForm)
        {
            <ExampleNoteForm OnSave="HandleNoteSaved" OnCancel="HideCreateForm" />
        }

        @if (_notes.Count == 0 && !_showForm)
        {
            <div class="empty-state">
                <p>No notes yet. Create your first note!</p>
            </div>
        }
        else
        {
            <div class="notes-grid">
                @foreach (var note in _notes)
                {
                    <ExampleNoteDisplay Note="note" OnDelete="HandleNoteDeleted" />
                }
            </div>
        }
    </div>
</div>

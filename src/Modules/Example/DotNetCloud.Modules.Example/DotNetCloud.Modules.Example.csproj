<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Modules.Example</RootNamespace>
    <AssemblyName>DotNetCloud.Modules.Example</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Deliberately a plain class library: the module's UI is served by its own host process
    (DotNetCloud.Modules.Example.Host, phase A5), so the module depends on no core UI assembly and
    the core references nothing from it. That is the dogfooded third-party shape.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core\DotNetCloud.Core.csproj" />
  </ItemGroup>

  <!-- The domain library needs logging + DI abstractions only; not the ASP.NET Core framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>

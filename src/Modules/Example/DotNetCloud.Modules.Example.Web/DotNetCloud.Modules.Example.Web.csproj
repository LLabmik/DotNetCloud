<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- The module UI is served out of the module host's wwwroot; the framework's ICU data is not
         needed, and leaving it out keeps the packaged .dncpkg small. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frame bridge and its Blazor bootstrap are the SDK's files, not copies: one
         implementation, no npm. The bridge patches window.fetch so every request carries the frame
         ticket and the module assertion. -->
    <Content Include="..\..\..\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js"
             Link="wwwroot\js\dncModuleBridge.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleFrame.js"
             Link="wwwroot\js\dncModuleFrame.js"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleBoot.js"
             Link="wwwroot\js\dncModuleBoot.js"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Browser-safe by design: DotNetCloud.Core only references Microsoft.AspNetCore.Http.Abstractions,
         and UI.Shared is the same Razor Class Library the server-side Blazor app uses (MaterialIcon). -->
    <ProjectReference Include="..\..\..\Core\DotNetCloud.Core\DotNetCloud.Core.csproj" />
    <ProjectReference Include="..\..\..\UI\DotNetCloud.UI.Shared\DotNetCloud.UI.Shared.csproj" />
    <ProjectReference Include="..\..\..\SDK\DotNetCloud.Modules.Sdk.Web\DotNetCloud.Modules.Sdk.Web.csproj" />
    <!-- The browser-side services (API client) live in a plain library so they can be unit tested;
         this project only adds the Razor components. -->
    <ProjectReference Include="..\DotNetCloud.Modules.Example.Web.Services\DotNetCloud.Modules.Example.Web.Services.csproj" />
  </ItemGroup>

</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DotNetCloud.Client.SyncTray.ViewModels"
        x:Class="DotNetCloud.Client.SyncTray.Views.SyncProgressWindow"
        x:DataType="vm:SyncProgressViewModel"
        Title="DotNetCloud Sync — Progress"
        Width="400"
        Height="360"
        MinWidth="320"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark"
        Background="#0D1118"
        Foreground="#E6ECF5"
        CanResize="True"
        SystemDecorations="Full"
        ShowInTaskbar="True">

    <Window.Styles>
        <!-- Header text -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4F7FF" />
        </Style>

        <!-- Summary label -->
        <Style Selector="TextBlock.summary">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8B9DC3" />
        </Style>

        <!-- Transfer item card -->
        <Style Selector="Border.transfer-item">
            <Setter Property="Background" Value="#151C29" />
            <Setter Property="BorderBrush" Value="#263247" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Active transfer highlight -->
        <Style Selector="Border.transfer-item-active">
            <Setter Property="Background" Value="#141E2D" />
            <Setter Property="BorderBrush" Value="#2F86CE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Progress bar styling -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#2F86CE" />
            <Setter Property="Background" Value="#1A2333" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <DockPanel Grid.Row="0" Margin="12">

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Classes="header"
                       Text="Sync Progress"
                       VerticalAlignment="Center" />
            <TextBlock Classes="summary"
                       Text="{Binding SyncSummary}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Pending queue summary -->
        <Border DockPanel.Dock="Top"
                Background="#111823"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,0,0,10"
                IsVisible="{Binding HasPendingItems}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="↑" FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalPendingUploads, StringFormat='{}{0} pending'}"
                               FontSize="11" Foreground="#8B9DC3" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="↓" FontSize="13" Foreground="#2196F3" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalPendingDownloads, StringFormat='{}{0} pending'}"
                               FontSize="11" Foreground="#8B9DC3" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Full-sync progress -->
        <Border DockPanel.Dock="Top"
                Background="#111823"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10"
                IsVisible="{Binding ShowFullSyncProgress}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding FullSyncPhaseLabel, FallbackValue='Synchronizing…'}"
                           FontSize="11"
                           Foreground="#8B9DC3" />
                <ProgressBar Value="{Binding FullSyncProgressPercent}"
                             Minimum="0"
                             Maximum="100"
                             Height="6"
                             CornerRadius="3" />
                <TextBlock Text="{Binding FullSyncProgressText}"
                           FontSize="10"
                           Foreground="#556688"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Error / conflict banner -->
        <Border DockPanel.Dock="Top"
                Background="#2D1111"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10"
                IsVisible="{Binding IsErrorBanner}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✗" FontSize="14" Foreground="#FF7B88" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BannerMessage}"
                           FontSize="11"
                           Foreground="#FF7B88"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="View Details"
                           FontSize="11"
                           Foreground="#64B5F6"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           PointerPressed="OnViewDetailsClicked" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="#2D2611"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10"
                IsVisible="{Binding IsConflictBanner}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⚠" FontSize="14" Foreground="#FFC107" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BannerMessage}"
                           FontSize="11"
                           Foreground="#FFC107"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Open Conflict Editor"
                           FontSize="11"
                           Foreground="#64B5F6"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           PointerPressed="OnOpenConflictsClicked" />
            </StackPanel>
        </Border>

        <!-- State-aware empty state -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !HasActiveTransfers}">
            <TextBlock Text="{Binding StatusGlyph}"
                       FontSize="36"
                       Foreground="#8B9DC3"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="16"
                       Foreground="#C8D2E8"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
            <TextBlock Text="{Binding StatusSubMessage}"
                       FontSize="12"
                       Foreground="#556688"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Transfer list -->
        <ScrollViewer IsVisible="{Binding HasActiveTransfers}">
            <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ActiveTransferViewModel">
                        <Border Classes.transfer-item="{Binding IsComplete}"
                                Classes.transfer-item-active="{Binding !IsComplete}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="4">

                                <!-- Direction glyph -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding DirectionGlyph}"
                                           FontSize="16"
                                           Foreground="#64B5F6"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <!-- File name -->
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding FileName}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Speed or Done -->
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{Binding SpeedLabel}"
                                           FontSize="11"
                                           Foreground="#64B5F6"
                                           IsVisible="{Binding !IsComplete}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="✓ Done"
                                           FontSize="11"
                                           Foreground="#4CAF50"
                                           IsVisible="{Binding IsComplete}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Progress bar -->
                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             Value="{Binding PercentComplete}"
                                             Minimum="0" Maximum="100"
                                             Height="6"
                                             IsVisible="{Binding !IsComplete}" />

                                <!-- Bytes / ETA -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding BytesLabel}"
                                           FontSize="10"
                                           Foreground="#6B7FA0"
                                           IsVisible="{Binding !IsComplete}" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{Binding Eta}"
                                           FontSize="10"
                                           Foreground="#6B7FA0"
                                           IsVisible="{Binding !IsComplete}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

    <!-- Footer bar -->
    <Border Grid.Row="1"
            Background="#111823"
            Padding="12,8"
            Margin="12,0,12,12"
            CornerRadius="6"
            IsVisible="True">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding FooterText}"
                       FontSize="10"
                       Foreground="#556688"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{Binding PauseResumeText}"
                    Command="{Binding PauseResumeCommand}"
                    FontSize="10"
                    Padding="10,4"
                    Background="#1A2333"
                    Foreground="#8B9DC3"
                    BorderBrush="#263247"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding ShowPauseResume}" />
            <Button Grid.Column="1"
                    Content="Sync Now"
                    Command="{Binding SyncNowCommand}"
                    FontSize="10"
                    Padding="10,4"
                    Background="#1A2333"
                    Foreground="#64B5F6"
                    BorderBrush="#2F86CE"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding ShowSyncNow}" />
        </Grid>
    </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dotnetcloud-updater</AssemblyName>
    <RootNamespace>DotNetCloud.Client.Updater</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Self-contained single-file so the helper can be copied to a temp location
      and run standalone while it replaces the main app's files on disk.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

</Project>

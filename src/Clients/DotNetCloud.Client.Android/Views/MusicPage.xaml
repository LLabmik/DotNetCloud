<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DotNetCloud.Client.Android.Views.MusicPage"
    x:Name="MusicPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DotNetCloud.Client.Android.ViewModels"
    xmlns:dto="clr-namespace:DotNetCloud.Core.DTOs;assembly=DotNetCloud.Core"
    xmlns:conv="clr-namespace:DotNetCloud.Client.Android.Converters"
    xmlns:views="clr-namespace:DotNetCloud.Client.Android.Views"
    x:DataType="vm:MusicViewModel"
    Shell.NavBarIsVisible="true"
    Shell.BackgroundColor="#1E293B"
    Shell.ForegroundColor="#F1F5F9"
    BackgroundColor="#0F172A">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              VerticalOptions="Center">
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="6"
                                   VerticalOptions="Center">
                <Image Source="logo.png"
                       HeightRequest="36"
                       WidthRequest="36"
                       VerticalOptions="Center"/>
                <Label Text="Music"
                       VerticalOptions="Center"
                       TextColor="#F1F5F9"
                       FontSize="18"/>
            </HorizontalStackLayout>

            <!-- Repeat icon button — visible during playback, cycles through Off→One→All→Off -->
            <Grid Grid.Column="1"
                  IsVisible="{Binding CurrentTrack, Converter={StaticResource IsNotNull}}"
                  WidthRequest="44"
                  HeightRequest="44"
                  VerticalOptions="Center"
                  Padding="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CycleRepeatCommand}"/>
                </Grid.GestureRecognizers>
                <Label Text="{Binding RepeatIcon}"
                       FontSize="16"
                       VerticalOptions="Center"
                       HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsRepeatActive}"
                                     Value="True">
                            <Setter Property="TextColor"
                                    Value="#0EA5E9"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsRepeatActive}"
                                     Value="False">
                            <Setter Property="TextColor"
                                    Value="#94A3B8"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <!-- Repeat label — shown to the right of the repeat icon -->
            <Label Grid.Column="2"
                   Text="{Binding RepeatLabel}"
                   FontSize="10"
                   TextColor="#94A3B8"
                   VerticalOptions="Center"
                   IsVisible="{Binding CurrentTrack, Converter={StaticResource IsNotNull}}"/>

            <!-- Search icon button — always visible, toggles search panel -->
            <Grid Grid.Column="3"
                  WidthRequest="44"
                  HeightRequest="44"
                  VerticalOptions="Center"
                  Padding="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSearchCommand}"/>
                </Grid.GestureRecognizers>
                <Label Text="🔍"
                       FontSize="16"
                       TextColor="#94A3B8"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Grid>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IsNotNullConverter x:Key="IsNotNull"/>
            <conv:InvertBoolConverter x:Key="InvertBool"/>
            <conv:TimeSpanToMmSsConverter x:Key="TimeSpanToMmSs"/>
            <conv:BoolToPlayPauseIconConverter x:Key="PlayPauseIcon"/>
            <conv:IsViewSelectedConverter x:Key="IsViewSelectedConverter"/>
            <conv:TabSelectedConverter x:Key="TabSelectedConverter"/>
            <conv:TrackIsCurrentConverter x:Key="TrackIsCurrentConverter"/>
            <conv:AlphabetLetterHighlightConverter x:Key="AlphabetLetterHighlight"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Now-playing bar (album art + controls + seek) ──────── -->
        <Border
            Grid.Row="0"
            IsVisible="{Binding CurrentTrack, Converter={StaticResource IsNotNull}}"
            BackgroundColor="#1E293B"
            Stroke="#334155"
            StrokeShape="RoundRectangle 8"
            Padding="8,8,8,4"
            Margin="4">

            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="4">

                <!-- Row 0: Album art + track info + controls -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="48,*,Auto"
                      ColumnSpacing="8">
                    <!-- Album art thumbnail -->
                    <Border
                        Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="0"
                        BackgroundColor="#334155">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCurrentSourceCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <!-- Fallback placeholder when no album art -->
                            <BoxView
                                WidthRequest="48"
                                HeightRequest="48"
                                Color="#334155"
                                IsVisible="{Binding HasAlbumArt, Converter={StaticResource InvertBool}}"/>
                            <!-- Album art image (loaded via IAlbumArtCache) -->
                            <Image
                                Source="{Binding AlbumArtImage}"
                                IsVisible="{Binding HasAlbumArt}"
                                Aspect="AspectFill"
                                WidthRequest="48"
                                HeightRequest="48"/>
                        </Grid>
                    </Border>

                    <!-- Track info -->
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label
                            Text="{Binding CurrentTrack.Title}"
                            TextColor="#F1F5F9"
                            FontSize="14"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToCurrentSourceCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            Text="{Binding CurrentTrack.ArtistName}"
                            TextColor="#94A3B8"
                            FontSize="12"
                            LineBreakMode="TailTruncation">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToPlayingArtistCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Playback controls -->
                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Button
                            Text="⏮"
                            FontSize="18"
                            BackgroundColor="Transparent"
                            TextColor="#F1F5F9"
                            Command="{Binding PlayPreviousCommand}"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"/>
                        <Button
                            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}"
                            FontSize="22"
                            BackgroundColor="#0EA5E9"
                            TextColor="#FFFFFF"
                            Command="{Binding TogglePlayPauseCommand}"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>
                        <Button
                            Text="⏭"
                            FontSize="18"
                            BackgroundColor="Transparent"
                            TextColor="#F1F5F9"
                            Command="{Binding PlayNextCommand}"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 1: Seek slider -->
                <Slider
                    x:Name="SeekSlider"
                    Grid.Row="1"
                    Value="{Binding CurrentPositionSeconds}"
                    Maximum="{Binding DurationSeconds}"
                    MinimumTrackColor="#0EA5E9"
                    MaximumTrackColor="#334155"
                    ThumbColor="#0EA5E9"
                    Minimum="0"
                    DragStarted="OnSeekDragStarted"
                    DragCompleted="OnSeekDragCompleted"/>

            </Grid>
        </Border>

        <!-- ── Search panel (toggleable) ───────────────────────────── -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsSearchOpen}"
            BackgroundColor="#1E293B"
            StrokeThickness="0"
            Padding="8,6">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
                <Entry
                    x:Name="SearchEntry"
                    Placeholder="{Binding SearchPlaceholderText}"
                    PlaceholderColor="#475569"
                    TextColor="#F1F5F9"
                    BackgroundColor="#0F172A"
                    Text="{Binding SearchQuery, Mode=TwoWay}"
                    ReturnType="Search"
                    Completed="OnSearchCompleted"/>
                <Label
                    Grid.Column="1"
                    Text="✕"
                    TextColor="#94A3B8"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    WidthRequest="44"
                    HeightRequest="36">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- ── Content area ────────────────────────────────────────── -->
        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto,*">

            <!-- Header row: back button + segmented tab bar -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">
                <!-- Back button (visible in contextual views) -->
                <Button
                    Grid.Column="0"
                    Text="◀"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    Margin="4,0,0,0"/>

                <!-- Segmented tab bar -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="0"
                    HorizontalOptions="Center"
                    Padding="8,8,8,4">

                    <Button
                        Text="Artists"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Artists}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadArtistsCommand}"/>
                    <Button
                        Text="Albums"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Albums}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadAlbumsCommand}"/>
                    <Button
                        Text="Tracks"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Tracks}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadTracksCommand}"/>
                    <Button
                        Text="Playlists"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Playlists}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadPlaylistsCommand}"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Search results indicator (visible only when search is active) -->
            <Label
                Grid.Row="1"
                Text="{Binding SearchResultText}"
                TextColor="#94A3B8"
                FontSize="13"
                HorizontalOptions="Center"
                Padding="8,4"
                IsVisible="{Binding IsSearchOpen}"
                LineBreakMode="TailTruncation"/>

            <!-- Loading indicator -->
            <ActivityIndicator
                Grid.Row="2"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#0EA5E9"
                HeightRequest="40"
                VerticalOptions="Start"/>

            <!-- Error message -->
            <VerticalStackLayout
                Grid.Row="2"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                VerticalOptions="Start"
                Padding="16,8">
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444"
                    FontSize="14"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Artists view: alphabet strip + collection -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Artists}"
                  ColumnDefinitions="32,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding ArtistAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border StrokeThickness="0"
                                    Margin="2,1"
                                    HeightRequest="30"
                                    WidthRequest="28"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 6">
                                <Border.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}">
                                        <Binding Path="."/>
                                        <Binding Path="BindingContext.SelectedLetter"
                                                Source="{x:Reference MusicPageRoot}"/>
                                    </MultiBinding>
                                </Border.BackgroundColor>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       FontFamily="monospace"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}"
                                                ConverterParameter="fg">
                                            <Binding Path="."/>
                                            <Binding Path="BindingContext.SelectedLetter"
                                                    Source="{x:Reference MusicPageRoot}"/>
                                        </MultiBinding>
                                    </Label.TextColor>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Artist items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="ArtistsCollectionView"
                    ItemsSource="{Binding Artists}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreArtistsCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ArtistDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="Auto,*,Auto">
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    CornerRadius="24"
                                    Color="#334155"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Margin="12,0,0,0">
                                    <Label Text="{Binding Name}"
                                           TextColor="#F1F5F9"
                                           FontSize="16"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding AlbumCount, StringFormat='{0} albums'}"
                                           TextColor="#94A3B8"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    TextColor="#64748B"
                                    FontSize="20"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Albums view: alphabet strip + collection -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Albums}"
                  ColumnDefinitions="32,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding AlbumAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border StrokeThickness="0"
                                    Margin="2,1"
                                    HeightRequest="30"
                                    WidthRequest="28"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 6">
                                <Border.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}">
                                        <Binding Path="."/>
                                        <Binding Path="BindingContext.SelectedLetter"
                                                Source="{x:Reference MusicPageRoot}"/>
                                    </MultiBinding>
                                </Border.BackgroundColor>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       FontFamily="monospace"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}"
                                                ConverterParameter="fg">
                                            <Binding Path="."/>
                                            <Binding Path="BindingContext.SelectedLetter"
                                                    Source="{x:Reference MusicPageRoot}"/>
                                        </MultiBinding>
                                    </Label.TextColor>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Album items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="AlbumsCollectionView"
                    ItemsSource="{Binding Albums}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreAlbumsCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MusicAlbumDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="48,*,Auto"
                                  ColumnSpacing="12">
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    CornerRadius="4"
                                    Color="#334155"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           TextColor="#F1F5F9"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ArtistName}"
                                           TextColor="#94A3B8"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Year, StringFormat='{0}'}"
                                    TextColor="#64748B"
                                    FontSize="12"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Tracks view: alphabet strip + collection -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Tracks}"
                  ColumnDefinitions="32,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding TrackAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border StrokeThickness="0"
                                    Margin="2,1"
                                    HeightRequest="30"
                                    WidthRequest="28"
                                    Padding="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 6">
                                <Border.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}">
                                        <Binding Path="."/>
                                        <Binding Path="BindingContext.SelectedLetter"
                                                Source="{x:Reference MusicPageRoot}"/>
                                    </MultiBinding>
                                </Border.BackgroundColor>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}"
                                       FontFamily="monospace"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.TextColor>
                                        <MultiBinding Converter="{StaticResource AlphabetLetterHighlight}"
                                                ConverterParameter="fg">
                                            <Binding Path="."/>
                                            <Binding Path="BindingContext.SelectedLetter"
                                                    Source="{x:Reference MusicPageRoot}"/>
                                        </MultiBinding>
                                    </Label.TextColor>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Track items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="TracksCollectionView"
                    ItemsSource="{Binding Tracks}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreTracksCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:TrackDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                                <Grid.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource TrackIsCurrentConverter}">
                                        <Binding Path="."/>
                                        <Binding Path="BindingContext.CurrentTrack"
                                                Source="{x:Reference MusicPageRoot}"/>
                                    </MultiBinding>
                                </Grid.BackgroundColor>
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding TrackNumber, StringFormat='{0}'}"
                                    TextColor="#64748B"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    WidthRequest="24"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           TextColor="#F1F5F9"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ArtistName}"
                                           TextColor="#94A3B8"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Duration, Converter={StaticResource TimeSpanToMmSs}}"
                                    TextColor="#64748B"
                                    FontSize="12"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding Playlists}"
                IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Playlists}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlaylistDto">
                        <Grid Padding="12,8"
                              ColumnDefinitions="48,*,Auto"
                              ColumnSpacing="12">
                            <BoxView
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                Color="#334155"/>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       TextColor="#F1F5F9"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding TrackCount, StringFormat='{0} tracks'}"
                                       TextColor="#94A3B8"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                Text="›"
                                TextColor="#64748B"
                                FontSize="20"
                                VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Letter-jump loading overlay: declared last so it paints above the lists.
                 InputTransparent so the user can keep tapping rail letters while it shows. -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding IsLetterJumpLoading}"
                  InputTransparent="True">
                <Border BackgroundColor="#CC1E293B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLetterJumpLoading}"
                                       Color="#0EA5E9"
                                       WidthRequest="44"
                                       HeightRequest="44"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

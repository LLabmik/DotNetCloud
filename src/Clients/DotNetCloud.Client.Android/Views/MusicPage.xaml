<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DotNetCloud.Client.Android.Views.MusicPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DotNetCloud.Client.Android.ViewModels"
    xmlns:dto="clr-namespace:DotNetCloud.Core.DTOs;assembly=DotNetCloud.Core"
    xmlns:conv="clr-namespace:DotNetCloud.Client.Android.Converters"
    xmlns:views="clr-namespace:DotNetCloud.Client.Android.Views"
    x:DataType="vm:MusicViewModel"
    Shell.NavBarIsVisible="true"
    Shell.BackgroundColor="#1E293B"
    Shell.ForegroundColor="#F1F5F9"
    BackgroundColor="#0F172A">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto"
              VerticalOptions="Center">
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="6"
                                   VerticalOptions="Center">
                <Image Source="logo.png"
                       HeightRequest="36"
                       WidthRequest="36"
                       VerticalOptions="Center"/>
                <Label Text="Music"
                       VerticalOptions="Center"
                       TextColor="#F1F5F9"
                       FontSize="18"/>
            </HorizontalStackLayout>

            <!-- EQ icon button — visible during playback, navigates to EQ view -->
            <Grid Grid.Column="1"
                  IsVisible="{Binding CurrentTrack, Converter={StaticResource IsNotNull}}"
                  WidthRequest="44"
                  HeightRequest="44"
                  VerticalOptions="Center"
                  HorizontalOptions="End"
                  Padding="8">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoadEqPresetsCommand}"/>
                </Grid.GestureRecognizers>
                <!-- EQ icon: matches Blazor SVG (viewBox 0 0 16 16, scaled ×1.5 to 24).
                     Uses Line+Ellipse shapes instead of Path for reliable Android rendering. -->
                <AbsoluteLayout WidthRequest="24"
                                HeightRequest="24"
                                VerticalOptions="Center"
                                HorizontalOptions="Center">
                    <!-- Bar 1: line from (3,14) to (3,5) scaled → (4.5,21) to (4.5,7.5) -->
                    <Line X1="4.5"
                            Y1="21"
                            X2="4.5"
                            Y2="7.5"
                          Stroke="#94A3B8"
                            StrokeThickness="2.5"
                            StrokeLineCap="Round"
                          AbsoluteLayout.LayoutBounds="0,0,24,24"
                            AbsoluteLayout.LayoutFlags="None"/>
                    <!-- Bar 2: line from (8,14) to (8,3) scaled → (12,21) to (12,4.5) -->
                    <Line X1="12"
                            Y1="21"
                            X2="12"
                            Y2="4.5"
                          Stroke="#94A3B8"
                            StrokeThickness="2.5"
                            StrokeLineCap="Round"
                          AbsoluteLayout.LayoutBounds="0,0,24,24"
                            AbsoluteLayout.LayoutFlags="None"/>
                    <!-- Bar 3: line from (13,14) to (13,7) scaled → (19.5,21) to (19.5,10.5) -->
                    <Line X1="19.5"
                            Y1="21"
                            X2="19.5"
                            Y2="10.5"
                          Stroke="#94A3B8"
                            StrokeThickness="2.5"
                            StrokeLineCap="Round"
                          AbsoluteLayout.LayoutBounds="0,0,24,24"
                            AbsoluteLayout.LayoutFlags="None"/>
                    <!-- Knob 1: circle center (3,5) r=1.5 scaled → (4.5,7.5) r=2.25≈2 -->
                    <Ellipse WidthRequest="4"
                            HeightRequest="4"
                            Fill="#94A3B8"
                             AbsoluteLayout.LayoutBounds="2.5,5.5,4,4"
                            AbsoluteLayout.LayoutFlags="None"/>
                    <!-- Knob 2: circle center (8,3) r=1.5 scaled → (12,4.5) r=2 -->
                    <Ellipse WidthRequest="4"
                            HeightRequest="4"
                            Fill="#94A3B8"
                             AbsoluteLayout.LayoutBounds="10,2.5,4,4"
                            AbsoluteLayout.LayoutFlags="None"/>
                    <!-- Knob 3: circle center (13,7) r=1.5 scaled → (19.5,10.5) r=2 -->
                    <Ellipse WidthRequest="4"
                            HeightRequest="4"
                            Fill="#94A3B8"
                             AbsoluteLayout.LayoutBounds="17.5,8.5,4,4"
                            AbsoluteLayout.LayoutFlags="None"/>
                </AbsoluteLayout>
            </Grid>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IsNotNullConverter x:Key="IsNotNull"/>
            <conv:InvertBoolConverter x:Key="InvertBool"/>
            <conv:TimeSpanToMmSsConverter x:Key="TimeSpanToMmSs"/>
            <conv:BoolToPlayPauseIconConverter x:Key="PlayPauseIcon"/>
            <conv:IsViewSelectedConverter x:Key="IsViewSelectedConverter"/>
            <conv:TabSelectedConverter x:Key="TabSelectedConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Now-playing bar (album art + controls + seek) ──────── -->
        <Border
            Grid.Row="0"
            IsVisible="{Binding CurrentTrack, Converter={StaticResource IsNotNull}}"
            BackgroundColor="#1E293B"
            Stroke="#334155"
            StrokeShape="RoundRectangle 8"
            Padding="8,8,8,4"
            Margin="4">

            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="4">

                <!-- Row 0: Album art + track info + controls -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="48,*,Auto"
                      ColumnSpacing="8">
                    <!-- Album art thumbnail -->
                    <Border
                        Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 4"
                        StrokeThickness="0"
                        BackgroundColor="#334155">
                        <Grid>
                            <!-- Fallback placeholder when no album art -->
                            <BoxView
                                WidthRequest="48"
                                HeightRequest="48"
                                Color="#334155"
                                IsVisible="{Binding HasAlbumArt, Converter={StaticResource InvertBool}}"/>
                            <!-- Album art image (loaded via IAlbumArtCache) -->
                            <Image
                                Source="{Binding AlbumArtImage}"
                                IsVisible="{Binding HasAlbumArt}"
                                Aspect="AspectFill"
                                WidthRequest="48"
                                HeightRequest="48"/>
                        </Grid>
                    </Border>

                    <!-- Track info -->
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label
                            Text="{Binding CurrentTrack.Title}"
                            TextColor="#F1F5F9"
                            FontSize="14"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation"/>
                        <Label
                            Text="{Binding CurrentTrack.ArtistName}"
                            TextColor="#94A3B8"
                            FontSize="12"
                            LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>

                    <!-- Playback controls -->
                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Button
                            Text="⏮"
                            FontSize="18"
                            BackgroundColor="Transparent"
                            TextColor="#F1F5F9"
                            Command="{Binding PlayPreviousCommand}"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"/>
                        <Button
                            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}"
                            FontSize="22"
                            BackgroundColor="#0EA5E9"
                            TextColor="#FFFFFF"
                            Command="{Binding TogglePlayPauseCommand}"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"/>
                        <Button
                            Text="⏭"
                            FontSize="18"
                            BackgroundColor="Transparent"
                            TextColor="#F1F5F9"
                            Command="{Binding PlayNextCommand}"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 1: Seek slider -->
                <Slider
                    x:Name="SeekSlider"
                    Grid.Row="1"
                    Value="{Binding CurrentPositionSeconds}"
                    Maximum="{Binding DurationSeconds}"
                    MinimumTrackColor="#0EA5E9"
                    MaximumTrackColor="#334155"
                    ThumbColor="#0EA5E9"
                    Minimum="0"
                    DragStarted="OnSeekDragStarted"
                    DragCompleted="OnSeekDragCompleted"/>

            </Grid>
        </Border>

        <!-- ── Content area ────────────────────────────────────────── -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*">

            <!-- Header row: back button + segmented tab bar -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">
                <!-- Back button (visible in contextual views) -->
                <Button
                    Grid.Column="0"
                    Text="◀"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}"
                    WidthRequest="36"
                    HeightRequest="36"
                    Padding="0"
                    Margin="4,0,0,0"/>

                <!-- Segmented tab bar -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="0"
                    HorizontalOptions="Center"
                    Padding="8,8,8,4">

                    <Button
                        Text="Artists"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Artists}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadArtistsCommand}"/>
                    <Button
                        Text="Albums"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Albums}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadAlbumsCommand}"/>
                    <Button
                        Text="Tracks"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Tracks}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadTracksCommand}"/>
                    <Button
                        Text="Playlists"
                        BackgroundColor="{Binding CurrentView, Converter={StaticResource TabSelectedConverter}, ConverterParameter=Playlists}"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="16"
                        Padding="16,6"
                        Margin="2,0"
                        Command="{Binding LoadPlaylistsCommand}"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- Loading indicator -->
            <ActivityIndicator
                Grid.Row="1"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#0EA5E9"
                HeightRequest="40"
                VerticalOptions="Start"/>

            <!-- Error message -->
            <VerticalStackLayout
                Grid.Row="1"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                VerticalOptions="Start"
                Padding="16,8">
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF4444"
                    FontSize="14"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Artists view: alphabet strip + collection -->
            <Grid Grid.Row="1"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Artists}"
                  ColumnDefinitions="28,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding ArtistAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="2,6"
                                   HeightRequest="32">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Artist items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="ArtistsCollectionView"
                    ItemsSource="{Binding Artists}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreArtistsCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ArtistDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="Auto,*,Auto">
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    CornerRadius="24"
                                    Color="#334155"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Margin="12,0,0,0">
                                    <Label Text="{Binding Name}"
                                           TextColor="#F1F5F9"
                                           FontSize="16"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding AlbumCount, StringFormat='{0} albums'}"
                                           TextColor="#94A3B8"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    TextColor="#64748B"
                                    FontSize="20"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Albums view: alphabet strip + collection -->
            <Grid Grid.Row="1"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Albums}"
                  ColumnDefinitions="28,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding AlbumAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="2,6"
                                   HeightRequest="32">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Album items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="AlbumsCollectionView"
                    ItemsSource="{Binding Albums}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreAlbumsCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MusicAlbumDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="48,*,Auto"
                                  ColumnSpacing="12">
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    CornerRadius="4"
                                    Color="#334155"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           TextColor="#F1F5F9"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ArtistName}"
                                           TextColor="#94A3B8"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Year, StringFormat='{0}'}"
                                    TextColor="#64748B"
                                    FontSize="12"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Tracks view: alphabet strip + collection -->
            <Grid Grid.Row="1"
                  IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Tracks}"
                  ColumnDefinitions="28,*">
                <!-- Alphabet strip -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding TrackAlphabet}"
                                BackgroundColor="#1E293B"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Padding="2,6"
                                   HeightRequest="32">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScrollToCharacterCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <!-- Track items -->
                <CollectionView
                    Grid.Column="1"
                    x:Name="TracksCollectionView"
                    ItemsSource="{Binding Tracks}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                    RemainingItemsThreshold="5"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreTracksCommand}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:TrackDto">
                            <Grid Padding="12,8"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding TrackNumber, StringFormat='{0}'}"
                                    TextColor="#64748B"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    WidthRequest="24"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           TextColor="#F1F5F9"
                                           FontSize="15"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ArtistName}"
                                           TextColor="#94A3B8"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Duration, Converter={StaticResource TimeSpanToMmSs}}"
                                    TextColor="#64748B"
                                    FontSize="12"
                                    VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Playlists}"
                IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Playlists}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PlaylistDto">
                        <Grid Padding="12,8"
                              ColumnDefinitions="48,*,Auto"
                              ColumnSpacing="12">
                            <BoxView
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                Color="#334155"/>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       TextColor="#F1F5F9"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding TrackCount, StringFormat='{0} tracks'}"
                                       TextColor="#94A3B8"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                            <Label
                                Grid.Column="2"
                                Text="›"
                                TextColor="#64748B"
                                FontSize="20"
                                VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- EQ view — server presets, current band levels, reset    -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <ScrollView
                Grid.Row="1"
                IsVisible="{Binding CurrentView, Converter={StaticResource IsViewSelectedConverter}, ConverterParameter=Eq}">
                <VerticalStackLayout Spacing="12"
                                     Padding="12,8">

                    <!-- EQ unavailable banner -->
                    <Border
                        IsVisible="{Binding EqAvailable, Converter={StaticResource InvertBool}}"
                        BackgroundColor="#422222"
                        Stroke="#E53935"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,8">
                        <Label
                            Text="⚠ Equalizer not available — start playback to enable"
                            TextColor="#F1F5F9"
                            FontSize="13"
                            HorizontalOptions="Center"/>
                    </Border>

                    <!-- Band count info -->
                    <Label
                        IsVisible="{Binding EqAvailable}"
                        FontSize="12"
                        TextColor="#94A3B8">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Bands: "/>
                                <Span Text="{Binding NumberOfBands}"
                                      FontAttributes="Bold"
                                      TextColor="#F1F5F9"/>
                                <Span Text=" (device: "/>
                                <Span Text="{Binding PhysicalBandCount}"
                                      TextColor="#94A3B8"/>
                                <Span Text=" physical)"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Interactive EQ band sliders (horizontal, stacked vertically) -->
                    <Border
                        IsVisible="{Binding EqAvailable}"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,12">
                        <ScrollView Orientation="Vertical"
                                    HorizontalOptions="Fill"
                                    HeightRequest="300">
                            <VerticalStackLayout
                                Spacing="8"
                                HorizontalOptions="Fill"
                                BindableLayout.ItemsSource="{Binding EqBands}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EqBandModel">
                                        <Grid ColumnDefinitions="36,*,48"
                                              ColumnSpacing="8"
                                              HorizontalOptions="Fill"
                                              HeightRequest="36">
                                            <Label Text="{Binding FrequencyLabel}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#F1F5F9"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"/>
                                            <Slider
                                                Grid.Column="1"
                                                Value="{Binding GainDb, Mode=TwoWay}"
                                                Minimum="-12"
                                                Maximum="12"
                                                MinimumTrackColor="#0EA5E9"
                                                MaximumTrackColor="#334155"
                                                ThumbColor="#0EA5E9"
                                                VerticalOptions="Center"
                                                ValueChanged="OnEqSliderValueChanged"/>
                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding GainDb, StringFormat='{0:F1} dB'}"
                                                FontSize="11"
                                                TextColor="#94A3B8"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>

                    <!-- Reset EQ button -->
                    <Button
                        IsVisible="{Binding EqAvailable}"
                        Text="Reset EQ (Flat)"
                        BackgroundColor="#475569"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="8"
                        Padding="12,8"
                        Command="{Binding ResetEqCommand}"
                        HorizontalOptions="Center"/>

                    <!-- Save current EQ as preset -->
                    <Button
                        IsVisible="{Binding EqAvailable}"
                        Text="💾 Save Current as Preset"
                        BackgroundColor="#475569"
                        TextColor="#F1F5F9"
                        FontSize="13"
                        CornerRadius="8"
                        Padding="12,8"
                        Command="{Binding OpenSavePresetDialogCommand}"
                        HorizontalOptions="Center"/>

                    <!-- ── Save EQ Preset Dialog ── -->
                    <Border
                        IsVisible="{Binding ShowSavePresetDialog}"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeShape="RoundRectangle 8"
                        Padding="16,12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Save EQ Preset"
                                   TextColor="#F1F5F9"
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                            <Entry Placeholder="Preset name..."
                                   PlaceholderColor="#64748B"
                                   Text="{Binding NewPresetName, Mode=TwoWay}"
                                   TextColor="#F1F5F9"
                                   BackgroundColor="#0F172A"
                                   FontSize="14"/>
                            <!-- Existing presets to overwrite -->
                            <Label Text="Or overwrite an existing preset:"
                                   TextColor="#94A3B8"
                                   FontSize="11"
                                   IsVisible="{Binding HasEqPresets}"/>
                            <CollectionView
                                ItemsSource="{Binding EqPresets}"
                                SelectionMode="None"
                                HeightRequest="120">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:EqPresetDto">
                                        <Border BackgroundColor="Transparent"
                                                Stroke="#334155"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="10,6"
                                                Margin="0,2">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MusicViewModel}}, Path=SelectEqPresetForOverwriteCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Name}"
                                                   TextColor="#F1F5F9"
                                                   FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <HorizontalStackLayout Spacing="8"
                                                   HorizontalOptions="End">
                                <Button Text="Cancel"
                                        BackgroundColor="#475569"
                                        TextColor="#F1F5F9"
                                        FontSize="13"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        Command="{Binding CloseSavePresetDialogCommand}"/>
                                <Button Text="Save"
                                        BackgroundColor="#0EA5E9"
                                        TextColor="#FFFFFF"
                                        FontSize="13"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        Command="{Binding SaveEqPresetCommand}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Section header -->
                    <Label
                        Text="Server Presets"
                        TextColor="#94A3B8"
                        FontSize="12"
                        FontAttributes="Bold"
                        Margin="0,8,0,0"/>

                    <!-- EQ presets list -->
                    <CollectionView
                        ItemsSource="{Binding EqPresets}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:EqPresetDto">
                                <Grid
                                    Padding="12,8"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        Spacing="2">
                                        <Label
                                            Text="{Binding Name}"
                                            TextColor="#F1F5F9"
                                            FontSize="14"
                                            FontAttributes="Bold"/>
                                        <Label
                                            IsVisible="{Binding IsBuiltIn}"
                                            Text="Built-in"
                                            TextColor="#64748B"
                                            FontSize="11"/>
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Text="Apply"
                                        BackgroundColor="#0EA5E9"
                                        TextColor="#FFFFFF"
                                        FontSize="12"
                                        CornerRadius="8"
                                        Padding="12,6"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ApplyEqPresetCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

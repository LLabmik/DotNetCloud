<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DotNetCloud.Client.Android.Views.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DotNetCloud.Client.Android.ViewModels"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Semi-transparent header overlay -->
        <Border
            Grid.Row="0"
            BackgroundColor="#800F172A"
            StrokeThickness="0"
            Padding="8,8"
            IsVisible="{Binding IsHeaderVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- Back button -->
                <ImageButton
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Command="{Binding CloseCommand}"
                    HeightRequest="40"
                    WidthRequest="40">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="OpenSansRegular"
                            Glyph="←"
                            Size="22"
                            Color="#F1F5F9"/>
                    </ImageButton.Source>
                </ImageButton>

                <!-- File name -->
                <Label
                    Grid.Column="1"
                    Text="{Binding FileName}"
                    TextColor="#F1F5F9"
                    FontSize="15"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Margin="8,0"/>

                <!-- Position indicator (e.g. "3 / 15") -->
                <Label
                    Grid.Column="2"
                    Text="{Binding PositionText}"
                    TextColor="#94A3B8"
                    FontSize="13"
                    VerticalOptions="Center"
                    Margin="4,0"/>

                <!-- Info / metadata button -->
                <ImageButton
                    Grid.Column="3"
                    BackgroundColor="Transparent"
                    Command="{Binding ToggleMetadataCommand}"
                    HeightRequest="40"
                    WidthRequest="40">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="OpenSansRegular"
                            Glyph="ⓘ"
                            Size="20"
                            Color="#94A3B8"/>
                    </ImageButton.Source>
                </ImageButton>

                <!-- Share button -->
                <ImageButton
                    Grid.Column="4"
                    BackgroundColor="Transparent"
                    Command="{Binding ShareCommand}"
                    HeightRequest="40"
                    WidthRequest="40">
                    <ImageButton.Source>
                        <FontImageSource
                            FontFamily="MaterialIcons"
                            Glyph="&#xe80d;"
                            Size="22"
                            Color="#94A3B8"/>
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Border>

        <!-- Carousel image area — smooth native swipe transitions -->
        <Grid
            Grid.Row="1"
            VerticalOptions="Fill"
            HorizontalOptions="Fill">

            <!-- Initial loading indicator (hidden once first image loads) -->
            <ActivityIndicator
                IsRunning="{Binding IsViewerLoading}"
                IsVisible="{Binding IsViewerLoading}"
                Color="#7C3AED"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

            <!-- CarouselView for smooth drag-to-swipe -->
            <CarouselView
                x:Name="CarouselView"
                ItemsSource="{Binding CarouselItems}"
                Position="{Binding CurrentPosition, Mode=TwoWay}"
                Loop="False"
                PeekAreaInsets="0"
                IsSwipeEnabled="True"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                IsVisible="{Binding IsViewerLoading, Converter={StaticResource InvertBool}}">

                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageCarouselItem">
                        <Grid>
                            <!-- Per-item loading spinner -->
                            <ActivityIndicator
                                IsRunning="{Binding IsItemLoading}"
                                IsVisible="{Binding IsItemLoading}"
                                Color="#475569"
                                HeightRequest="32"
                                WidthRequest="32"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                            <!-- The image itself -->
                            <Image
                                Source="{Binding Source}"
                                Aspect="AspectFit"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                IsVisible="{Binding IsItemLoading, Converter={StaticResource InvertBool}}">

                                <Image.GestureRecognizers>
                                    <!-- Single tap toggles the header overlay -->
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleHeaderCommand}"/>

                                    <!-- Double tap toggles between 1x and 3x zoom -->
                                    <TapGestureRecognizer
                                        NumberOfTapsRequired="2"
                                        Tapped="OnImageDoubleTapped"/>

                                    <!-- Pinch to zoom (up to 5x). PanGestureRecognizer is deliberately
                                         omitted — it conflicts with PinchGestureRecognizer on the same
                                         element and causes the image to flash back to 1x during pinch. -->
                                    <PinchGestureRecognizer
                                        PinchUpdated="OnImagePinchUpdated"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>

        <!-- EXIF metadata panel (collapsible) -->
        <Border
            Grid.Row="2"
            BackgroundColor="#CC0F172A"
            StrokeThickness="0"
            Padding="16,12"
            IsVisible="{Binding IsMetadataExpanded}">
            <ScrollView
                HeightRequest="200">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Image Info"
                        TextColor="#94A3B8"
                        FontSize="13"
                        FontAttributes="Bold"
                        Margin="0,0,0,4"/>

                    <!-- Dimensions -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding DimensionsDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Dimensions:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding DimensionsDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Date taken -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding DateTakenDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Date:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding DateTakenDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Camera -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding CameraDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Camera:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding CameraDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Lens -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding LensDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Lens:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding LensDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Camera settings (aperture · shutter · ISO · focal length) -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding SettingsDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Settings:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding SettingsDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- Flash -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding FlashDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Flash:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding FlashDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- GPS -->
                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible="{Binding GpsDisplay, Converter={StaticResource IsNotNullOrEmpty}}">
                        <Label Text="Location:"
                               TextColor="#64748B"
                               FontSize="13"
                               WidthRequest="90"/>
                        <Label Text="{Binding GpsDisplay}"
                               TextColor="#F1F5F9"
                               FontSize="13"/>
                    </HorizontalStackLayout>

                    <!-- No metadata fallback -->
                    <Label
                        Text="No EXIF data available for this image."
                        TextColor="#64748B"
                        FontSize="13"
                        FontAttributes="Italic"
                        IsVisible="{Binding HasMetadata, Converter={StaticResource InvertBool}}"/>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>

</ContentPage>

<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:DotNetCloud.Client.Android.Converters"
             xmlns:local="clr-namespace:DotNetCloud.Client.Android"
             x:Class="DotNetCloud.Client.Android.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared value converters used throughout the app -->
            <converters:InvertBoolConverter x:Key="InvertBool"/>
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty"/>
            <converters:IsNotNullConverter x:Key="IsNotNull"/>
            <converters:IsNullConverter x:Key="IsNull"/>
            <converters:IsNotZeroConverter x:Key="IsNotZero"/>
            <converters:UnreadToBoldConverter x:Key="UnreadToBold"/>
            <converters:MentionToBadgeColorConverter x:Key="MentionToBadgeColor"/>
            <converters:OnlineStatusToColorConverter x:Key="OnlineStatusToColor"/>
            <converters:ViewToggleConverter x:Key="ViewToggleConverter"/>
            <converters:ViewVisibilityConverter x:Key="ViewVisibilityConverter"/>
            <converters:TodayBackgroundConverter x:Key="TodayBackgroundConverter"/>
            <converters:DayTextColorConverter x:Key="DayTextColorConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToStringConverter x:Key="BoolToString"/>
            <converters:FirstCharConverter x:Key="FirstChar"/>
            <converters:ChannelTypeToIconConverter x:Key="ChannelTypeToIcon"/>

            <!-- Calendar FAB shadow -->
            <Shadow x:Key="FabShadow"
                    Brush="#0EA5E9"
                    Offset="0,4"
                    Radius="8"
                    Opacity="0.4"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>


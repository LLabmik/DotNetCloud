<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<application
		android:allowBackup="true"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"
		android:label="@string/app_name">

		<!-- Chat connection service (keeps SignalR alive while the app is running). Deliberately
		     NOT a foreground service: a dataSync FGS spends the Android 15/16 rolling 24-hour
		     budget and could crash-loop the app once exhausted. Background message delivery uses the
		     app's own conditional poll of GET /api/v1/chat/alerts (see ChatAlertJobService below) —
		     no distributor app, no push server and no Google infrastructure. -->
		<service
			android:name=".ChatConnectionService"
			android:exported="false" />

		<!-- Music playback foreground service -->
		<service
			android:name=".MusicPlaybackService"
			android:foregroundServiceType="mediaPlayback"
			android:exported="false" />

		<!-- Periodic background media auto-upload job (JobScheduler). Uses NO foreground
		     service, so it never consumes the Android 15/16 dataSync 24-hour budget. -->
		<service
			android:name=".MediaUploadJobService"
			android:permission="android.permission.BIND_JOB_SERVICE"
			android:exported="false" />

		<!-- Background chat-alert poll (JobScheduler, id 3108). Complements the media job: this is
		     what tells the user about new messages while the app is closed. Uses NO foreground
		     service, so it never consumes the Android 15/16 dataSync 24-hour budget. -->
		<service
			android:name=".ChatAlertJobService"
			android:permission="android.permission.BIND_JOB_SERVICE"
			android:exported="false" />

		<!-- Allow-while-idle alarm that runs one poll directly while the device dozes (Doze defers
		     ordinary jobs to a maintenance window, so the job alone cannot bound the latency).
		     Requires SCHEDULE_EXACT_ALARM for the exact variant — already requested for calendar
		     reminders; the inexact variant is used when the user has not granted it. -->
		<receiver
			android:name=".ChatAlertAlarmReceiver"
			android:exported="false" />

		<!-- Calendar reminder alarm receiver (internal only) -->
		<receiver
			android:name=".CalendarAlarmReceiver"
			android:exported="false" />

		<!-- Calendar boot receiver — reschedules alarms after device reboot -->
		<receiver
			android:name=".CalendarBootReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>

	</application>

	<!-- Network -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Push notifications (Android 13+) -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Foreground services: music playback only. FOREGROUND_SERVICE_DATA_SYNC was removed along
	     with the chat dataSync FGS (that type is capped to a rolling 24-hour budget on Android 15+). -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

	<!-- Equalizer (AudioEffect) requires this to adjust band levels -->
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

	<!-- Photo auto-upload: read media -->
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
	<!-- READ_EXTERNAL_STORAGE covers API 29-32 (Android 10-12); Android 13+ uses READ_MEDIA_* above -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

	<!-- Camera for photo/video capture removed: the platform camera app owns capture, and the
	     camera roll is backed up via MediaStore (READ_MEDIA_IMAGES/READ_MEDIA_VIDEO below).
	     Dropping CAMERA also removes the quirk where declaring the permission makes
	     ACTION_IMAGE_CAPTURE require an explicit runtime grant.
	     ACCESS_FINE_LOCATION was only ever requested so the camera app could embed GPS EXIF. -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

	<!-- Battery optimization exemption — required for reliable background sync -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

	<!-- Exact alarm scheduling for calendar reminders (API 31+) -->
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

	<!-- Reschedule calendar alarms after device reboot -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

</manifest>

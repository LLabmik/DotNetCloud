<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <!-- Required: The server project has no .razor files (they live in UI.Web),
         so the SDK sets RequiresAspNetWebAssets=false, which prevents the
         Microsoft.AspNetCore.App.Internal.Assets package from being resolved.
         That package provides _framework/blazor.web.js. Force it on. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetCloud.Core.Server.Tests" />
    <InternalsVisibleTo Include="DotNetCloud.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- Microsoft.OpenApi comes transitively from Microsoft.AspNetCore.OpenApi at a vulnerable
         2.0.0 (GHSA-v5pm-xwqc-g5wc / CVE-2026-49451). Override to patched 2.7.5 — NOT 3.x,
         which breaks the OpenApi source generator (IOpenApiMediaType.Example is read-only in 3.x). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <!-- Microsoft.OpenApi comes transitively from Microsoft.AspNetCore.OpenApi;
         explicit reference to 3.9.0 breaks the source generator. -->
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Core\DotNetCloud.Core.csproj" />
    <ProjectReference Include="..\DotNetCloud.Core.Auth\DotNetCloud.Core.Auth.csproj" />
    <ProjectReference Include="..\DotNetCloud.Core.Data\DotNetCloud.Core.Data.csproj" />
    <ProjectReference Include="..\DotNetCloud.Core.Grpc\DotNetCloud.Core.Grpc.csproj" />
    <ProjectReference Include="..\DotNetCloud.Core.Schema\DotNetCloud.Core.Schema.csproj" />
    <ProjectReference Include="..\DotNetCloud.Core.ServiceDefaults\DotNetCloud.Core.ServiceDefaults.csproj" />
    <!-- Module main (RCL) projects retained for Blazor UI component registration. -->
    <ProjectReference Include="..\..\Modules\Calendar\DotNetCloud.Modules.Calendar\DotNetCloud.Modules.Calendar.csproj" />
    <ProjectReference Include="..\..\Modules\Calendar\DotNetCloud.Modules.Calendar.Data\DotNetCloud.Modules.Calendar.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\DotNetCloud.Modules.Chat\DotNetCloud.Modules.Chat.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\DotNetCloud.Modules.Chat.Data\DotNetCloud.Modules.Chat.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Contacts\DotNetCloud.Modules.Contacts\DotNetCloud.Modules.Contacts.csproj" />
    <ProjectReference Include="..\..\Modules\Contacts\DotNetCloud.Modules.Contacts.Data\DotNetCloud.Modules.Contacts.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Files\DotNetCloud.Modules.Files\DotNetCloud.Modules.Files.csproj" />
    <ProjectReference Include="..\..\Modules\Notes\DotNetCloud.Modules.Notes\DotNetCloud.Modules.Notes.csproj" />
    <ProjectReference Include="..\..\Modules\Notes\DotNetCloud.Modules.Notes.Data\DotNetCloud.Modules.Notes.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Tracks\DotNetCloud.Modules.Tracks\DotNetCloud.Modules.Tracks.csproj" />
    <ProjectReference Include="..\..\Modules\Tracks\DotNetCloud.Modules.Tracks.Data\DotNetCloud.Modules.Tracks.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Photos\DotNetCloud.Modules.Photos\DotNetCloud.Modules.Photos.csproj" />
    <ProjectReference Include="..\..\Modules\Photos\DotNetCloud.Modules.Photos.Data\DotNetCloud.Modules.Photos.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Music\DotNetCloud.Modules.Music\DotNetCloud.Modules.Music.csproj" />
    <ProjectReference Include="..\..\Modules\Music\DotNetCloud.Modules.Music.Data\DotNetCloud.Modules.Music.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Video\DotNetCloud.Modules.Video\DotNetCloud.Modules.Video.csproj" />
    <ProjectReference Include="..\..\Modules\Video\DotNetCloud.Modules.Video.Data\DotNetCloud.Modules.Video.Data.csproj" />
    <ProjectReference Include="..\..\Modules\AI\DotNetCloud.Modules.AI\DotNetCloud.Modules.AI.csproj" />
    <ProjectReference Include="..\..\Modules\AI\DotNetCloud.Modules.AI.Data\DotNetCloud.Modules.AI.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks\DotNetCloud.Modules.Bookmarks.csproj" />
    <ProjectReference Include="..\..\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Data\DotNetCloud.Modules.Bookmarks.Data.csproj" />
    <ProjectReference Include="..\..\Modules\Email\DotNetCloud.Modules.Email\DotNetCloud.Modules.Email.csproj" />
    <ProjectReference Include="..\..\Modules\Email\DotNetCloud.Modules.Email.Data\DotNetCloud.Modules.Email.Data.csproj" />
    <ProjectReference Include="..\..\Modules\About\DotNetCloud.Modules.About\DotNetCloud.Modules.About.csproj" />
    <ProjectReference Include="..\..\UI\DotNetCloud.UI.Web\DotNetCloud.UI.Web.csproj" />
    <ProjectReference Include="..\..\UI\DotNetCloud.UI.Web.Client\DotNetCloud.UI.Web.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC client protos for process-isolated modules -->
    <Protobuf Include="..\..\Modules\Contacts\DotNetCloud.Modules.Contacts.Host\Protos\contacts_service.proto"
              GrpcServices="Client"
              Link="Protos\contacts_service.proto" />
    <Protobuf Include="..\..\Modules\Calendar\DotNetCloud.Modules.Calendar.Host\Protos\calendar_service.proto"
              GrpcServices="Client"
              Link="Protos\calendar_service.proto" />
    <Protobuf Include="..\..\Modules\Chat\DotNetCloud.Modules.Chat.Host\Protos\chat_service.proto"
              GrpcServices="Client"
              Link="Protos\chat_service.proto" />
    <Protobuf Include="..\..\Modules\Files\DotNetCloud.Modules.Files.Host\Protos\files_service.proto"
              GrpcServices="Both"
              Link="Protos\files_service.proto" />
    <Protobuf Include="..\..\Modules\Notes\DotNetCloud.Modules.Notes.Host\Protos\notes_service.proto"
              GrpcServices="Client"
              Link="Protos\notes_service.proto" />
    <Protobuf Include="..\..\Modules\Tracks\DotNetCloud.Modules.Tracks.Host\Protos\tracks_service.proto"
              GrpcServices="Client"
              Link="Protos\tracks_service.proto" />
    <Protobuf Include="..\..\Modules\Music\DotNetCloud.Modules.Music.Host\Protos\music_service.proto"
              GrpcServices="Client"
              Link="Protos\music_service.proto" />
    <Protobuf Include="..\..\Modules\Photos\DotNetCloud.Modules.Photos.Host\Protos\photos_service.proto"
              GrpcServices="Client"
              Link="Protos\photos_service.proto" />
    <Protobuf Include="..\..\Modules\Video\DotNetCloud.Modules.Video.Host\Protos\video_service.proto"
              GrpcServices="Client"
              Link="Protos\video_service.proto" />
    <!-- Search proto NOT included directly here. Search.Client is referenced
         transitively via Files.Data (which provides the generated SearchService types). -->
    <Protobuf Include="..\..\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Host\Protos\bookmarks_service.proto"
              GrpcServices="Client"
              Link="Protos\bookmarks_service.proto" />
    <Protobuf Include="..\..\Modules\Email\DotNetCloud.Modules.Email.Host\Protos\email_service.proto"
              GrpcServices="Client"
              Link="Protos\email_service.proto" />
    <Protobuf Include="..\..\Modules\About\DotNetCloud.Modules.About.Host\Protos\about_service.proto"
              GrpcServices="Client"
              Link="Protos\about_service.proto" />
    <Protobuf Include="..\..\Modules\AI\DotNetCloud.Modules.AI.Host\Protos\ai_service.proto"
              GrpcServices="Client"
              Link="Protos\ai_service.proto" />
  </ItemGroup>

  <ItemGroup>
    <None Update="certs\*.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>

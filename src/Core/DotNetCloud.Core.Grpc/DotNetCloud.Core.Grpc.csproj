<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetCloud.Core.Grpc</RootNamespace>
    <AssemblyName>DotNetCloud.Core.Grpc</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Shared module-host Kestrel binding (Unix sockets / named pipes) lives here so all 14 module
    hosts bind the endpoint the supervisor assigned instead of re-implementing it. The framework
    reference also supplies Microsoft.AspNetCore.Http.Abstractions and
    Microsoft.Extensions.Hosting.Abstractions, which used to be explicit package references
    (NU1510: they are redundant once the framework reference exists).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\module_lifecycle.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\module_capabilities.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\module_api.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\token_introspection.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCloud.Core\DotNetCloud.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetCloud.Core.Server.Tests" />
  </ItemGroup>

  </Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <!-- MediaCachePathResolver reads storage-path configuration shared by core and module hosts. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- The manifest loader (ModuleLoading/) reports validation failures through ILogger<T>. The
         abstraction is browser-safe, so the WASM-side SDK keeps compiling against this assembly. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>


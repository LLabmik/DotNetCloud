@namespace DotNetCloud.UI.Web.Components.Modules

<div class="module-app-host module-app-host--@StateToken" data-module="@ModuleId">
    @if (_requestedScopes.Count > 0)
    {
        @* An inline bar above the frame, not an overlay: a module UI usually owns the bottom of its
           own page (the Music player does), and a floating card covered it. *@
        <div class="module-app-consent" role="region" aria-label="Permission request">
            <span class="module-app-consent-icon">
                <MaterialIcon Icon="shield" />
            </span>
            <div class="module-app-consent-body">
                <p class="module-app-consent-title">@ConsentModuleName is asking for permission</p>
                <ul class="module-app-consent-scopes">
                    @foreach (var scope in _requestedScopes)
                    {
                        <li>@DescribeScope(scope)</li>
                    }
                </ul>
            </div>
            <div class="module-app-consent-actions">
                <a class="module-app-consent-review" href="@ConnectedAppsHref">Review</a>
                <button type="button" class="module-app-consent-approve" @onclick="ApproveConsentAsync" disabled="@_consentBusy">
                    <MaterialIcon Icon="check" Size="MaterialIconSize.Sm" />
                    <span>@(_consentBusy ? "Approving…" : "Approve")</span>
                </button>
                <button type="button" class="module-app-consent-dismiss" @onclick="DismissConsent" title="Dismiss" aria-label="Dismiss the permission request">
                    <MaterialIcon Icon="close" Size="MaterialIconSize.Sm" />
                </button>
            </div>
        </div>
    }

    @if (ShowFrame)
    {
        <iframe @ref="_frame" src="@Source" class="module-app-frame" title="@Title"
                sandbox="allow-scripts allow-forms allow-popups allow-modals" referrerpolicy="no-referrer"
                loading="eager"></iframe>
    }

    @if (_state == ModuleAppHostState.Starting)
    {
        <div class="module-app-overlay module-app-overlay--busy" role="status" aria-live="polite">
            <div class="module-app-spinner" aria-hidden="true"></div>
            <p class="module-app-overlay-title">Starting @Title…</p>
        </div>
    }
    else if (_state is ModuleAppHostState.Stopped or ModuleAppHostState.Failed)
    {
        <div class="module-app-overlay" role="alert">
            <MaterialIcon Icon="widgets" Size="MaterialIconSize.Xl" />
            <p class="module-app-overlay-title">@Title is not available</p>
            <p class="module-app-overlay-text">@_failureMessage</p>
            <button type="button" class="module-app-retry" @onclick="RetryAsync">
                <MaterialIcon Icon="refresh" Size="MaterialIconSize.Sm" />
                <span>Try again</span>
            </button>
        </div>
    }
</div>

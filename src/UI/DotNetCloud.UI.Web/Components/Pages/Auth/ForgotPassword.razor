@page "/auth/forgot-password"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Logging
@using DotNetCloud.Core.Data.Entities.Identity
@layout AuthLayout

<PageTitle>Forgot Password - DotNetCloud</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img class="auth-logo" src="/_content/DotNetCloud.UI.Web/logo.png" alt="DotNetCloud" />
            <h1>Forgot Password</h1>
            <p>Enter your username or email to receive a reset link</p>
        </div>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="forgot-password">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="identifier">Username or Email</label>
                <InputText id="identifier" class="input" @bind-Value="_model!.Identifier"
                           placeholder="Bill.Jones or you@example.com" autocomplete="username" />
                <ValidationMessage For="() => _model!.Identifier" />
            </div>

            @if (_submitted && _noEmailOnFile)
            {
                <div class="alert alert-warning">
                    This account has no email address on file. Please contact your administrator to reset your password.
                </div>
            }
            else if (_submitted)
            {
                <div class="alert alert-success">
                    If an account exists with that username or email, a reset link has been sent.
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full" disabled="@_submitting">
                    @(_submitting ? "Sending..." : "Send Reset Link")
                </button>
            </div>
        </EditForm>

        <div class="auth-footer">
            <a href="/auth/login">Back to login</a>
        </div>
    </div>
</div>

@code {
    [Inject] private UserManager<ApplicationUser> UserManager { get; set; } = default!;
    [Inject] private ILogger<ForgotPassword> Logger { get; set; } = default!;

    [SupplyParameterFromForm]
    private ForgotPasswordModel? _model { get; set; }

    private bool _submitting;
    private bool _submitted;
    private bool _noEmailOnFile;

    protected override void OnInitialized()
    {
        _model ??= new();
    }

    private async Task SubmitAsync()
    {
        _model ??= new();
        _noEmailOnFile = false;
        _submitting = true;
        try
        {
            var user = await UserManager.FindByNameAsync(_model.Identifier)
                ?? await UserManager.FindByEmailAsync(_model.Identifier);

            if (user is not null && !string.IsNullOrEmpty(user.Email))
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                Logger.LogInformation("Password reset token generated for {Identifier}", _model.Identifier);
            }
            else if (user is not null && string.IsNullOrEmpty(user.Email))
            {
                // Account exists but has no email on file — cannot deliver a reset link.
                _noEmailOnFile = true;
            }

            _submitted = true;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ForgotPasswordModel
    {
        public string Identifier { get; set; } = string.Empty;
    }
}

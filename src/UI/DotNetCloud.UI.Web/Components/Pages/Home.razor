@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using DotNetCloud.UI.Web.Services
@implements IDisposable

<PageTitle>DotNetCloud</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        @{
            var user = authContext.User;
            var roleClaims = user.FindAll(ClaimTypes.Role).Select(c =>
        c.Value).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            var accountName = user.Identity?.Name ?? "Unknown";
            var displayName = user.FindFirst("name")?.Value
                ?? user.FindFirst(ClaimTypes.GivenName)?.Value
                ?? user.FindFirst("display_name")?.Value
                ?? accountName;
        }

        <div class="page-header dashboard-header">
            <div>
                <h1>Welcome, @displayName</h1>
                <p class="text-muted">Your personal DotNetCloud home base.</p>
            </div>
        </div>

        <div class="dashboard-grid">
            <section class="dashboard-card">
                <div class="card-icon">👤</div>
                <div class="card-content">
                    <h3>Account</h3>
                    <p class="card-value card-value-small">@accountName</p>
                    @if (roleClaims.Count > 0)
                    {
                        <div class="role-badges">
                            @foreach (var role in roleClaims)
                            {
                                <span class="badge badge-muted">@role</span>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="dashboard-card">
                <div class="card-icon">🧩</div>
                <div class="card-content">
                    <h3>Available Apps</h3>
                    <p class="card-value">@ModuleRegistry.NavItems.Count</p>
                    <p class="text-muted">Module experiences available from your sidebar.</p>
                </div>
            </section>

            <AuthorizeView Policy="RequireAdmin">
                <Authorized Context="adminContext">
                    <section class="dashboard-card card-healthy">
                        <div class="card-icon">🛠</div>
                        <div class="card-content">
                            <h3>Administration</h3>
                            <p class="text-muted">You have administrative access.</p>
                            <a href="/admin" class="card-link">Open Admin Dashboard</a>
                        </div>
                    </section>
                </Authorized>
                <NotAuthorized>
                    <section class="dashboard-card">
                        <div class="card-icon">🔐</div>
                        <div class="card-content">
                            <h3>Security</h3>
                            <p class="text-muted">Your account has standard user permissions.</p>
                        </div>
                    </section>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <section class="widgets-section">
            <div class="widgets-section-header">
                <h2>Your Widgets</h2>
                <button type="button" class="widget-refresh-btn" title="Refresh widgets"
                        aria-label="Refresh widgets" @onclick="RefreshWidgets">
                    <MaterialIcon Icon="refresh" />
                </button>
            </div>
            @if (WidgetRegistry.Widgets.Count == 0)
            {
                <p class="text-muted">No widgets are available yet.</p>
            }
            else
            {
                <div class="widget-grid">
                    @foreach (var widget in WidgetRegistry.Widgets)
                    {
                        <WidgetCard Title="@widget.Title" Icon="@widget.Icon" Href="@widget.Href">
                            <DynamicComponent @key="widget.ModuleId + ':' + _widgetRefreshToken"
                                              Type="@widget.ComponentType" />
                        </WidgetCard>
                    }
                </div>
            }
        </section>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private ModuleUiRegistry ModuleRegistry { get; set; } = default!;
    [Inject] private WidgetUiRegistry WidgetRegistry { get; set; } = default!;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        WidgetRegistry.OnChange += OnWidgetsChanged;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        WidgetRegistry.OnChange -= OnWidgetsChanged;
    }

    private void OnWidgetsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private int _widgetRefreshToken;

    /// <summary>
    /// Force-refreshes widget data by bumping the remount key, which recreates each widget
    /// component so its <c>OnInitializedAsync</c> re-runs and reloads fresh data.
    /// </summary>
    private void RefreshWidgets()
    {
        _widgetRefreshToken++;
    }
}

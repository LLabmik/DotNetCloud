@using DotNetCloud.Core.DTOs.Home
@using DotNetCloud.UI.Web.Services
@namespace DotNetCloud.UI.Web.Components.Home
@implements IDisposable

<div class="widget-customizer" role="region" aria-label="Customize widgets">
    <div class="widget-customizer-head">
        <h3>Customize widgets</h3>
        <button type="button" class="widget-customizer-close" aria-label="Close customization" @onclick="CloseAsync">
            <MaterialIcon Icon="close" Size="MaterialIconSize.Sm" />
        </button>
    </div>

    <fieldset class="widget-style-group">
        <legend>Style</legend>
        @foreach (var token in HomeWidgetStyles.All)
        {
            var active = string.Equals(LayoutService.StyleToken, token, StringComparison.Ordinal);
            <label class="widget-style-option @(active ? "is-active" : string.Empty)">
                <input type="radio" name="widget-style" value="@token" checked="@active"
                       @onchange="() => SelectStyleAsync(token)" />
                <span class="widget-style-text">
                    <span class="widget-style-name">@HomeWidgetStyles.GetDisplayName(token)</span>
                    <span class="widget-style-desc">@HomeWidgetStyles.GetDescription(token)</span>
                </span>
            </label>
        }
    </fieldset>

    <div class="widget-manage-head">
        <h4>Widgets</h4>
        <button type="button" class="widget-reset-btn @(_confirmingReset ? "is-confirming" : string.Empty)"
                @onclick="ConfirmResetAsync">
            @(_confirmingReset ? "Click again to confirm" : "Reset to default")
        </button>
    </div>

    <ul class="widget-manage-list">
        @for (var index = 0; index < LayoutService.Slots.Count; index++)
        {
            var slot = LayoutService.Slots[index];
            var position = index + 1;
            <li class="widget-manage-row @(IsDragging(slot) ? "is-dragging" : string.Empty)" draggable="true"
                @ondragstart="() => _draggingModuleId = slot.ModuleId" @ondragover:preventDefault="true"
                @ondrop="() => DropAsync(slot.ModuleId)" @ondragend="() => _draggingModuleId = null">
                <span class="widget-manage-handle" aria-hidden="true">
                    <MaterialIcon Icon="drag_indicator" Size="MaterialIconSize.Sm" />
                </span>
                <input type="checkbox" id="widget-visible-@slot.ModuleId" checked="@slot.Visible"
                       @onchange="e => SetVisibleAsync(slot, e.Value is true)" />
                <label class="widget-manage-title" for="widget-visible-@slot.ModuleId">
                    @slot.Descriptor.Title
                </label>
                <span class="widget-manage-moves">
                    <button type="button" class="widget-manage-move" disabled="@(index == 0)"
                            aria-label="@($"Move {@slot.Descriptor.Title} up")" @onclick="() => MoveAsync(slot, -1)">
                        <MaterialIcon Icon="expand_less" Size="MaterialIconSize.Sm" />
                    </button>
                    <button type="button" class="widget-manage-move" disabled="@(index == LayoutService.Slots.Count - 1)"
                            aria-label="@($"Move {@slot.Descriptor.Title} down")" @onclick="() => MoveAsync(slot, 1)">
                        <MaterialIcon Icon="expand_more" Size="MaterialIconSize.Sm" />
                    </button>
                </span>
                <span class="widget-manage-position">@position</span>
            </li>
        }
    </ul>

    <p class="widget-customizer-status" aria-live="polite">
        @if (LayoutService.LastError is not null)
        {
            <span class="widget-customizer-error">@LayoutService.LastError</span>
        }
        else
        {
            @_status
        }
    </p>
</div>

@code {
    /// <summary>The layout service that owns the user's preferences.</summary>
    [Inject]
    private HomeWidgetLayoutService LayoutService { get; set; } = default!;

    /// <summary>Raised when the user closes the panel.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private string? _draggingModuleId;
    private string _status = "Drag to reorder, or use the arrows.";
    private bool _confirmingReset;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        LayoutService.OnChange += OnLayoutChanged;
        await LayoutService.EnsureLoadedAsync();
    }

    /// <inheritdoc />
    public void Dispose() => LayoutService.OnChange -= OnLayoutChanged;

    private void OnLayoutChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsDragging(HomeWidgetSlot slot)
        => _draggingModuleId is not null
            && string.Equals(_draggingModuleId, slot.ModuleId, StringComparison.OrdinalIgnoreCase);

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task SelectStyleAsync(string token)
    {
        await LayoutService.SetStyleAsync(token);
        _status = $"Style set to {HomeWidgetStyles.GetDisplayName(token)}.";
    }

    private async Task SetVisibleAsync(HomeWidgetSlot slot, bool visible)
    {
        await LayoutService.SetVisibilityAsync(slot.ModuleId, visible);
        _status = visible
            ? $"{slot.Descriptor.Title} shown."
            : $"{slot.Descriptor.Title} hidden.";
    }

    /// <summary>
    /// Moves the widget one position up or down. The slot (not a loop index) identifies the widget:
    /// a lambda that captured the <c>@for</c> index would close over the loop variable and see its
    /// final value (the slot count) when the event finally fires.
    /// </summary>
    /// <param name="slot">The slot whose widget is being moved.</param>
    /// <param name="delta">-1 to move up, +1 to move down.</param>
    private async Task MoveAsync(HomeWidgetSlot slot, int delta)
    {
        var currentIndex = LayoutService.GetPosition(slot.ModuleId);
        var targetIndex = currentIndex + delta;

        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= LayoutService.Slots.Count)
        {
            return;
        }

        await LayoutService.MoveAsync(slot.ModuleId, delta);
        _status = $"{slot.Descriptor.Title} moved to position {targetIndex + 1}.";
    }

    /// <summary>
    /// Moves the dragged widget into the dropped-on widget's slot. Both ends are module ids, so a
    /// re-render between drag start and drop cannot leave a stale index behind.
    /// </summary>
    /// <param name="targetModuleId">The module whose row the drag ended on.</param>
    private async Task DropAsync(string targetModuleId)
    {
        if (_draggingModuleId is not { } draggedModuleId
            || string.Equals(draggedModuleId, targetModuleId, StringComparison.OrdinalIgnoreCase))
        {
            _draggingModuleId = null;
            return;
        }

        var title = LayoutService.Slots
            .FirstOrDefault(candidate => string.Equals(
                candidate.ModuleId,
                draggedModuleId,
                StringComparison.OrdinalIgnoreCase))
            ?.Descriptor.Title ?? draggedModuleId;

        await LayoutService.MoveToModuleAsync(draggedModuleId, targetModuleId);

        var position = LayoutService.GetPosition(draggedModuleId);
        _draggingModuleId = null;
        _status = position >= 0
            ? $"{title} moved to position {position + 1}."
            : $"{title} reordered.";
    }

    private async Task ConfirmResetAsync()
    {
        if (!_confirmingReset)
        {
            _confirmingReset = true;
            _status = "Reset restores the default style, order and visibility.";
            return;
        }

        _confirmingReset = false;
        await LayoutService.ResetAsync();
        _status = "Layout reset to default.";
    }
}

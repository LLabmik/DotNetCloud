@using DotNetCloud.Core.DTOs.Home
@using DotNetCloud.UI.Web.Services
@namespace DotNetCloud.UI.Web.Components.Home
@implements IDisposable

<div class="widget-customizer" role="region" aria-label="Customize widgets">
    <div class="widget-customizer-head">
        <h3>Customize widgets</h3>
        <button type="button" class="widget-customizer-close" aria-label="Close customization" @onclick="CloseAsync">
            <MaterialIcon Icon="close" Size="MaterialIconSize.Sm" />
        </button>
    </div>

    <fieldset class="widget-style-group">
        <legend>Style</legend>
        @foreach (var token in HomeWidgetStyles.All)
        {
            var active = string.Equals(LayoutService.StyleToken, token, StringComparison.Ordinal);
            <label class="widget-style-option @(active ? "is-active" : string.Empty)">
                <input type="radio" name="widget-style" value="@token" checked="@active"
                       @onchange="() => SelectStyleAsync(token)" />
                <span class="widget-style-text">
                    <span class="widget-style-name">@HomeWidgetStyles.GetDisplayName(token)</span>
                    <span class="widget-style-desc">@HomeWidgetStyles.GetDescription(token)</span>
                </span>
            </label>
        }
    </fieldset>

    <div class="widget-manage-head">
        <h4>Widgets</h4>
        <button type="button" class="widget-reset-btn @(_confirmingReset ? "is-confirming" : string.Empty)"
                @onclick="ConfirmResetAsync">
            @(_confirmingReset ? "Click again to confirm" : "Reset to default")
        </button>
    </div>

    <ul class="widget-manage-list">
        @for (var index = 0; index < LayoutService.Slots.Count; index++)
        {
            var slot = LayoutService.Slots[index];
            var position = index + 1;
            <li class="widget-manage-row @(IsDragging(slot) ? "is-dragging" : string.Empty)" draggable="true"
                @ondragstart="() => _draggingModuleId = slot.ModuleId" @ondragover:preventDefault="true"
                @ondrop="() => DropAsync(slot.ModuleId)" @ondragend="() => _draggingModuleId = null">
                <span class="widget-manage-handle" aria-hidden="true">
                    <MaterialIcon Icon="drag_indicator" Size="MaterialIconSize.Sm" />
                </span>
                <input type="checkbox" id="widget-visible-@slot.ModuleId" checked="@slot.Visible"
                       @onchange="e => SetVisibleAsync(slot, e.Value is true)" />
                <label class="widget-manage-title" for="widget-visible-@slot.ModuleId">
                    @slot.Descriptor.Title
                </label>
                <span class="widget-manage-moves">
                    <button type="button" class="widget-manage-move" disabled="@(index == 0)"
                            aria-label="@($"Move {@slot.Descriptor.Title} up")" @onclick="() => MoveAsync(slot, -1)">
                        <MaterialIcon Icon="expand_less" Size="MaterialIconSize.Sm" />
                    </button>
                    <button type="button" class="widget-manage-move" disabled="@(index == LayoutService.Slots.Count - 1)"
                            aria-label="@($"Move {@slot.Descriptor.Title} down")" @onclick="() => MoveAsync(slot, 1)">
                        <MaterialIcon Icon="expand_more" Size="MaterialIconSize.Sm" />
                    </button>
                </span>
                <span class="widget-manage-position">@position</span>
            </li>
        }
    </ul>

    <p class="widget-customizer-status" aria-live="polite">
        @if (LayoutService.LastError is not null)
        {
            <span class="widget-customizer-error">@LayoutService.LastError</span>
        }
        else
        {
            @_status
        }
    </p>
</div>

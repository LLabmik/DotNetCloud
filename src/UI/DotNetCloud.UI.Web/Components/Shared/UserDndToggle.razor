@namespace DotNetCloud.UI.Web.Components.Shared
@using DotNetCloud.Modules.Chat.Services
@using System.Security.Claims
@inject INotificationPreferenceStore NotificationPrefs
@inject AuthenticationStateProvider AuthStateProvider

@*
    Quick Do Not Disturb toggle for the top bar user menu area.
    Shows a moon icon that toggles DND on/off with a single click.
*@

@if (_isLoaded)
{
    <button class="dnd-toggle @(_isDnd ? "dnd-active" : "")" type="button"
            title="@(_isDnd ? "Do Not Disturb is ON — click to disable" : "Do Not Disturb is OFF — click to enable")"
            aria-label="@(_isDnd ? "Disable Do Not Disturb" : "Enable Do Not Disturb")" @onclick="ToggleDndAsync">
        <MaterialIcon Icon="@(_isDnd ? "do_not_disturb_on" : "do_not_disturb_off")" Size="MaterialIconSize.Sm" />
    </button>
}

<style>
    .dnd-toggle {
        background: none;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        padding: 4px 6px;
        color: var(--color-text-secondary, #94a3b8);
        transition: all 0.15s;
        display: flex;
        align-items: center;
    }

    .dnd-toggle:hover {
        background: var(--color-surface-hover, rgba(255, 255, 255, 0.08));
        color: var(--color-text, #f1f5f9);
    }

    .dnd-toggle.dnd-active {
        color: #ef4444;
        border-color: rgba(239, 68, 68, 0.3);
    }

    .dnd-toggle.dnd-active:hover {
        background: rgba(239, 68, 68, 0.12);
    }
</style>

@code {
    private bool _isLoaded;
    private bool _isDnd;
    private Guid _userId;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.FindFirst("sub")?.Value;

        if (Guid.TryParse(userIdClaim, out _userId))
        {
            var prefs = NotificationPrefs.Get(_userId);
            _isDnd = prefs.DoNotDisturb;
            _isLoaded = true;
        }
    }

    private async Task ToggleDndAsync()
    {
        if (_userId == Guid.Empty)
            return;

        _isDnd = !_isDnd;
        NotificationPrefs.Update(_userId, NotificationPrefs.Get(_userId) with { DoNotDisturb = _isDnd });

        await InvokeAsync(StateHasChanged);
    }
}

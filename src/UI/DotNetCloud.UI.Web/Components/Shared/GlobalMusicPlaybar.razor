@using DotNetCloud.Core.Authorization
@using DotNetCloud.Core.DTOs
@using DotNetCloud.Core.Services
@using DotNetCloud.Modules.Music.UI
@using DotNetCloud.Modules.Music.Services
@using DotNetCloud.UI.Web.Services
@using Microsoft.Extensions.Logging
@using System.Text.Json
@inject MusicPlaybackState Playback
@inject ModuleUiRegistry ModuleRegistry
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserSettingsService UserSettingsService
@inject IJSRuntime Js
@inject ILogger<GlobalMusicPlaybar> Logger
@inject IPlaylistService PlaylistService
@inject ActivePlaylistContext ActivePlaylist
@implements IAsyncDisposable

@if (_musicModuleEnabled && Playback.NowPlaying is not null)
{
    <div class="global-music-playbar">
        <div class="gmp-track-info">
            <div class="gmp-art">
                @if (Playback.NowPlaying.AlbumId.HasValue)
                {
                    <a href="" @onclick="NavigateToPlayingAlbum"
                       @onclick:preventDefault title="View album">
                        @* The old markup used an inline onerror="" to swap in the fallback SVG, but the
                           hardened CSP (no 'unsafe-inline'/'unsafe-hashes' for script) blocks inline
                           event handlers. Track the failure in component state instead. *@
                        @if (_albumArtFailedForAlbumId == Playback.NowPlaying.AlbumId)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none"
                                 style="width:100%;height:100%">
                                <defs>
                                    <linearGradient id="gmpbg" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#cbd5e1" />
                                        <stop offset="100%" stop-color="#94a3b8" />
                                    </linearGradient>
                                </defs>
                                <rect width="200" height="200" rx="12" fill="url(#gmpbg)" />
                                <circle cx="100" cy="96" r="56" fill="#475569" opacity="0.55" />
                                <circle cx="100" cy="96" r="12" fill="#cbd5e1" />
                                <circle cx="100" cy="96" r="4" fill="#475569" />
                            </svg>
                        }
                        else
                        {
                            <img src="@MusicPlaybackState.GetAlbumArtUrl(Playback.NowPlaying.AlbumId.Value)" alt=""
                                 @onerror="OnAlbumArtError" />
                        }
                    </a>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none" style="width:100%;height:100%">
                        <defs>
                            <linearGradient id="gmpbg2" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#cbd5e1" />
                                <stop offset="100%" stop-color="#94a3b8" />
                            </linearGradient>
                        </defs>
                        <rect width="200" height="200" rx="12" fill="url(#gmpbg2)" />
                        <circle cx="100" cy="96" r="56" fill="#475569" opacity="0.55" />
                        <circle cx="100" cy="96" r="12" fill="#cbd5e1" />
                        <circle cx="100" cy="96" r="4" fill="#475569" />
                    </svg>
                }
            </div>
            <div class="gmp-text">
                <a class="gmp-title" href="" @onclick="NavigateToCurrentContext"
                   @onclick:preventDefault>@Playback.NowPlaying.Title</a>
                <span class="gmp-artist-album">
                    <a class="gmp-artist-link" href="" @onclick="() => NavigateToArtistPage(Playback.NowPlaying.ArtistId)" @onclick:preventDefault>@Playback.NowPlaying.ArtistName</a>
                    @if (!string.IsNullOrEmpty(Playback.NowPlaying.AlbumTitle) && Playback.NowPlaying.AlbumId.HasValue)
                    {
                        <span class="gmp-separator"> · </span>
                        <a class="gmp-album-link" href="" @onclick="NavigateToPlayingAlbum" @onclick:preventDefault>@Playback.NowPlaying.AlbumTitle</a>
                    }
                    else if (!string.IsNullOrEmpty(Playback.NowPlaying.AlbumTitle))
                    {
                        <span class="gmp-separator"> · </span>
                        <span>@Playback.NowPlaying.AlbumTitle</span>
                    }
                </span>
                @if (ActivePlaylist.PlaylistId.HasValue)
                {
                    <a class="gmp-playlist" href="" @onclick="NavigateToActivePlaylistAsync"
                       @onclick:preventDefault title="View playlist">
                        <span class="gmp-playlist-icon">📃</span>
                        @ActivePlaylist.PlaylistName
                    </a>
                }
            </div>
            <button class="gmp-star" @onclick="ToggleStarAsync">
                @(Playback.NowPlaying.IsStarred ? "★" : "☆")
            </button>
        </div>

        <div class="gmp-controls">
            <div class="gmp-buttons">
                <button class="gmp-btn" @onclick="ToggleShuffleAsync" title="Shuffle">
                    <span class="@(Playback.Shuffle ? "active-control" : "")">⇄</span>
                </button>
                <button class="gmp-btn" @onclick="PlayPreviousAsync" title="Previous">⏮</button>
                <button class="gmp-btn gmp-play-pause" @onclick="TogglePlayPauseAsync"
                        title="@(Playback.IsPlaying ? "Pause" : "Play")">
                    @(Playback.IsPlaying ? "⏸" : "▶")
                </button>
                <button class="gmp-btn" @onclick="PlayNextAsync" title="Next">⏭</button>
                <button class="gmp-btn" @onclick="CycleRepeatAsync" title="Repeat: @RepeatLabel">
                    <MaterialIcon Icon="@(Playback.Repeat == RepeatMode.One ? "repeat_one" : "repeat")"
                                  Size="MaterialIconSize.Sm" CssClass="@RepeatModeCssClass" />
                </button>
                <span class="gmp-repeat-label @RepeatModeCssClass">@RepeatLabel</span>
                </div>
                <div class="gmp-progress">
                    <span class="gmp-time">@MusicPlaybackState.FormatDuration(Playback.PlaybackPosition)</span>
                    <div class="gmp-progress-bar" @onclick="SeekAsync">
                        <div class="gmp-progress-fill" style="width: @Playback.GetProgressPercent()%"></div>
                    </div>
                    <span class="gmp-time">@MusicPlaybackState.FormatDuration(Playback.NowPlaying.Duration)</span>
                </div>
            </div>

            <div class="gmp-extras">
                <button class="gmp-btn" @onclick="Playback.ToggleQueue" title="Queue">
                    <span class="@(Playback.ShowQueue ? "active-control" : "")">☰</span>
                </button>
                <button class="gmp-btn" @onclick="ToggleEqualizerAsync" title="Equalizer">
                    <span class="@(Playback.ShowEqualizer ? "active-control" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"
                             stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                            <line x1="3" y1="14" x2="3" y2="5" />
                            <line x1="8" y1="14" x2="8" y2="3" />
                            <line x1="13" y1="14" x2="13" y2="7" />
                            <circle cx="3" cy="5" r="1.5" fill="currentColor" stroke="none" />
                            <circle cx="8" cy="3" r="1.5" fill="currentColor" stroke="none" />
                            <circle cx="13" cy="7" r="1.5" fill="currentColor" stroke="none" />
                        </svg>
                    </span>
                </button>
                <div class="gmp-volume">
                    <button class="gmp-btn" @onclick="ToggleMuteAsync" title="Volume">
                        @(Playback.Muted ? "🔇" : Playback.Volume > 50 ? "🔊" : "🔉")
                    </button>
                    <input type="range" min="0" max="100" value="@Playback.Volume" @oninput="OnVolumeChangedAsync"
                           class="gmp-volume-slider" />
                </div>
                <button class="gmp-btn gmp-close-btn" @onclick="StopAsync" title="Stop">✕</button>
            </div>
        </div>

        @* ─── Queue Slide-Out Panel ─── *@
        @if (Playback.ShowQueue)
        {
            <aside class="gmp-queue-panel">
                <div class="gmp-panel-header">
                    <h4>Play Queue</h4>
                    <div class="gmp-queue-header-actions">
                        @if (Playback.Queue.Count > 0)
                        {
                            <div class="gmp-queue-save-wrapper">
                                <button class="gmp-btn gmp-btn-sm" @onclick="ToggleSaveQueueMenu">💾 Save</button>
                                @if (_showSaveQueueMenu)
                                {
                                    <div class="gmp-queue-save-dropdown">
                                        <button @onclick="ShowSaveQueueAsNewDialog">Save as New Playlist…</button>
                                        @if (_playlists.Count > 0)
                                        {
                                            <div class="gmp-queue-save-divider"></div>
                                            @foreach (var pl in _playlists)
                                            {
                                                <button @onclick="() => AddQueueToExistingPlaylistAsync(pl.Id)">Add to @pl.Name</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button class="btn-icon" @onclick="Playback.ToggleQueue">✕</button>
                    </div>
                </div>
                <div class="gmp-queue-list">
                    @if (Playback.Queue.Count == 0)
                    {
                        <p class="gmp-queue-empty">Queue is empty</p>
                    }
                    @foreach (var (track, index) in Playback.Queue.Select((t, i) => (t, i)))
                    {
                        <div class="gmp-queue-item @(Playback.NowPlaying?.Id == track.Id ? "playing" : "")">
                            <span class="gmp-queue-num">@(index + 1)</span>
                            <div class="gmp-queue-info">
                                <span class="gmp-queue-title" @onclick="() => Playback.PlayQueueAt(index)" style="cursor:pointer">@track.Title</span>
                                <span class="gmp-queue-artist"><a class="gmp-artist-link" href="" @onclick="() => NavigateToArtistPage(track.ArtistId)" @onclick:preventDefault @onclick:stopPropagation="true">@track.ArtistName</a></span>
                            </div>
                            <div class="gmp-queue-item-actions">
                                <button class="gmp-queue-item-menu-btn" @onclick="() => ToggleQueueItemMenu(index)">⋯</button>
                                @if (_queueItemMenuIndex == index)
                                {
                                    <div class="gmp-queue-item-dropdown">
                                        @foreach (var pl in _playlists)
                                        {
                                            <button @onclick="() => AddTrackToPlaylistFromQueueAsync(pl.Id, track.Id)">Add to @pl.Name</button>
                                        }
                                    </div>
                                }
                                <button class="gmp-queue-remove" @onclick="() => Playback.RemoveFromQueue(index)">✕</button>
                            </div>
                        </div>
                    }
                </div>
            </aside>

            @* ─── Save Queue as New Playlist Dialog ─── *@
            @if (_showSaveQueueDialog)
            {
                <div class="gmp-dialog-overlay" @onclick="CloseSaveQueueDialog">
                    <div class="gmp-dialog-panel" @onclick:stopPropagation="true">
                        <h4>Save Queue as Playlist</h4>
                        <div class="gmp-dialog-form">
                            <label>Playlist Name
                                <input type="text" @bind="_newQueuePlaylistName"
                                       @bind:event="oninput"
                                       placeholder="My Queue Playlist" />
                            </label>
                            <label class="gmp-dialog-checkbox">
                                <input type="checkbox" @bind="_newQueuePlaylistPublic" />
                                <span>Public playlist</span>
                            </label>
                            <p class="gmp-dialog-hint">@Playback.Queue.Count track@(Playback.Queue.Count == 1 ? "" : "s") will be added.</p>
                        </div>
                        <div class="gmp-dialog-actions">
                            <button class="btn btn-primary" @onclick="SaveQueueAsNewPlaylistAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_newQueuePlaylistName)">
                                Save
                            </button>
                            <button class="btn btn-secondary" @onclick="CloseSaveQueueDialog">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        }

        @* ─── Equalizer Slide-Out Panel ─── *@
        @if (Playback.ShowEqualizer)
        {
            <aside class="gmp-eq-panel">
                <div class="gmp-panel-header">
                    <h4>Equalizer</h4>
                    <div class="gmp-eq-header-actions">
                        <button class="btn-icon btn-small" title="Reset to flat" @onclick="ResetEqAsync">⟲</button>
                        <button class="btn-icon btn-small" title="Save as preset"
                                @onclick="Playback.ToggleSavePresetDialog">💾</button>
                        <button class="btn-icon" @onclick="Playback.ToggleEqualizer">✕</button>
                    </div>
                </div>
                <div class="gmp-eq-presets">
                    @foreach (var preset in Playback.EqPresets)
                    {
                        <span class="gmp-eq-preset-btn @(Playback.ActivePresetId == preset.Id ? "active" : "")">
                            <button class="gmp-eq-preset-name" @onclick="() => ApplyPresetAsync(preset)">@preset.Name</button>
                            <button class="gmp-eq-preset-default" title="Set as this device's default EQ"
                                    @onclick="() => SetDefaultPresetAsync(preset)">@(Playback.DefaultPresetId == preset.Id ? "☑" :
                                "☐")</button>
                                @if (!preset.IsBuiltIn)
                                {
                                    <button class="gmp-eq-preset-delete" title="Delete preset"
                                            @onclick="() => DeletePresetAsync(preset)">✕</button>
                                }
                            </span>
                        }
                    </div>
                    <div class="gmp-eq-bands">
                        @for (int i = 0; i < Playback.EqBands.Length; i++)
                        {
                            var bandIndex = i;
                            <div class="gmp-eq-band">
                                <input type="range" min="-12" max="12" step="0.5" value="@Playback.EqBands[bandIndex]"
                                       @oninput="(e) => OnEqBandChangedAsync(bandIndex, e)" orient="vertical" class="gmp-eq-slider" />
                                <span class="gmp-eq-label">@MusicPlaybackState.BandLabels[bandIndex]</span>
                            </div>
                        }
                    </div>
                </aside>
            }

            @* ─── Save EQ Preset Dialog ─── *@
            @if (Playback.ShowSavePresetDialog)
            {
                <div class="gmp-dialog-overlay" @onclick="Playback.ToggleSavePresetDialog">
                    <div class="gmp-dialog-panel" @onclick:stopPropagation="true">
                        <h4>Save EQ Preset</h4>
                        <div class="gmp-dialog-form">
                            <label>Preset Name
                                <input type="text" @bind="_newPresetName" @bind:after="OnPresetNameChanged"
                                       placeholder="My Custom Preset" />
                            </label>

                            @if (Playback.EqPresets.Count > 0)
                            {
                                <div class="gmp-dialog-preset-list">
                                    <span class="gmp-dialog-preset-list-label">Or overwrite an existing preset:</span>
                                    @foreach (var preset in Playback.EqPresets)
                                    {
                                        <div class="gmp-dialog-preset-item @(_selectedPresetId == preset.Id ? "selected" : "")"
                                             @onclick="() => SelectPreset(preset)">
                                            <span class="gmp-dialog-preset-name">@preset.Name</span>
                                            @if (_selectedPresetId == preset.Id)
                                            {
                                                <span class="gmp-dialog-preset-check">✓</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="gmp-dialog-actions">
                            <button class="btn btn-primary" @onclick="SavePresetAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_newPresetName)">
                                @(_selectedPresetId.HasValue ? "Update" : "Save")
                            </button>
                            <button class="btn btn-secondary" @onclick="Playback.ToggleSavePresetDialog">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        }

@code {
    private bool _musicModuleEnabled;
    private bool _jsInitialized;

    /// <summary>Album whose cover failed to load; the fallback SVG is rendered instead.</summary>
    private Guid? _albumArtFailedForAlbumId;
    private DotNetObjectReference<GlobalMusicPlaybar>? _dotNetRef;
    private string _newPresetName = string.Empty;
    private Guid? _selectedPresetId;

    // ── Queue-to-playlist state ──
    private bool _showSaveQueueMenu;
    private bool _showSaveQueueDialog;
    private string _newQueuePlaylistName = string.Empty;
    private bool _newQueuePlaylistPublic;
    private int? _queueItemMenuIndex;
    private List<PlaylistDto> _playlists = [];

    // ── Settings persistence ──
    private const string SettingsModule = "dotnetcloud.music";
    private const string VolumeKey = "player.volume";
    private const string MutedKey = "player.muted";
    private const string ShuffleKey = "player.shuffle";
    private const string RepeatKey = "player.repeat";
    private const string EqBandsKey = "player.eq-bands";
    private const string LocalEqStateKey = "dotnetcloud.music:eq-state";
    private bool _settingsLoaded;
    private LocalEqState? _localEqState;
    private CancellationTokenSource? _saveCts;

    /// <summary>
    /// CSS class applying the repeat-mode colour: red for Off, yellow for One, green for All.
    /// </summary>
    private string RepeatModeCssClass => Playback.Repeat switch
    {
        RepeatMode.One => "gmp-repeat-mode-one",
        RepeatMode.All => "gmp-repeat-mode-all",
        _ => "gmp-repeat-mode-off",
    };

    /// <summary>Human-readable repeat mode label shown next to the repeat button.</summary>
    private string RepeatLabel => Playback.Repeat switch
    {
        RepeatMode.One => "One",
        RepeatMode.All => "All",
        _ => "Off",
    };

    protected override void OnInitialized()
    {
        _musicModuleEnabled = ModuleRegistry.NavItems.Any(n =>
            string.Equals(n.ModuleId, "dotnetcloud.music", StringComparison.OrdinalIgnoreCase));

        Playback.OnChange += OnPlaybackStateChanged;
        Playback.OnTrackChanged += OnTrackChanged;
        ModuleRegistry.OnChange += OnModuleRegistryChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_musicModuleEnabled && Playback.NowPlaying is not null && !_jsInitialized)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.init", _dotNetRef);
                _jsInitialized = true;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to initialize global music player JS interop");
            }
        }

        if (firstRender && Playback.NowPlaying is not null)
        {
            // A track may already be playing (e.g. after a circuit reconnect) — reflect it in the tab title.
            await UpdateTabTitleAsync();
        }
    }

    private void OnPlaybackStateChanged()
    {
        InvokeAsync(StateHasChanged);
        _ = InvokeAsync(UpdateTabTitleAsync);
    }

    /// <summary>
    /// Handles a failed album-art image load by switching to the inline SVG fallback.
    /// </summary>
    /// <remarks>
    /// This used to be an inline <c>onerror=""</c> attribute in the markup, which the hardened
    /// Content-Security-Policy blocks (it allows no <c>'unsafe-inline'</c>/<c>'unsafe-hashes'</c>
    /// for scripts). Using a Blazor event handler keeps the fallback working under the strict policy.
    /// </remarks>
    private void OnAlbumArtError()
    {
        _albumArtFailedForAlbumId = Playback.NowPlaying?.AlbumId;
    }

    private void OnModuleRegistryChanged()
    {
        _musicModuleEnabled = ModuleRegistry.NavItems.Any(n =>
            string.Equals(n.ModuleId, "dotnetcloud.music", StringComparison.OrdinalIgnoreCase));
        InvokeAsync(StateHasChanged);
        if (!_musicModuleEnabled)
        {
            // Module was disabled — drop any now-playing tab title override.
            _ = InvokeAsync(UpdateTabTitleAsync);
        }
    }

    // ── Playback JS interop ──

    private async Task TogglePlayPauseAsync()
    {
        Playback.TogglePlayPause();
        if (_jsInitialized)
        {
            if (Playback.IsPlaying)
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.resume");
            else
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.pause");
        }
    }

    private void PlayNextAsync()
    {
        Playback.PlayNext();
        // JS audio is triggered by OnTrackChanged event
    }

    private void PlayPreviousAsync()
    {
        Playback.PlayPrevious();
        // JS audio is triggered by OnTrackChanged event
    }

    private async Task StopAsync()
    {
        Playback.Stop();
        if (_jsInitialized)
        {
            await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.stop");
        }
    }

    private async Task ToggleShuffleAsync()
    {
        Playback.ToggleShuffle();
        await SaveSettingImmediateAsync(ShuffleKey, Playback.Shuffle.ToString().ToLowerInvariant());
    }

    private async Task CycleRepeatAsync()
    {
        Playback.CycleRepeat();
        await SaveSettingImmediateAsync(RepeatKey, Playback.Repeat.ToString());
    }

    private async Task ToggleMuteAsync()
    {
        Playback.ToggleMute();
        if (_jsInitialized)
        {
            await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setMuted", Playback.Muted);
        }
        await SaveSettingImmediateAsync(MutedKey, Playback.Muted.ToString().ToLowerInvariant());
    }

    private async Task OnVolumeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var vol))
        {
            Playback.SetVolume(vol);
            if (_jsInitialized)
            {
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setVolume", Playback.Muted ? 0 : Playback.Volume);
            }
            SaveSettingDebounced(VolumeKey, Playback.Volume.ToString());
        }
    }

    private async Task SeekAsync(MouseEventArgs e)
    {
        if (Playback.NowPlaying is null) return;
        // Delegate to JS which uses the element's actual rendered width
        // (via getBoundingClientRect) to compute the correct fraction.
        if (_jsInitialized)
        {
            await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.handleProgressClick", e.ClientX);
        }
    }

    // ── Equalizer JS interop ──

    private async Task ToggleEqualizerAsync()
    {
        await LoadPersistedSettingsAsync();

        if (!Playback.EqPresetsLoaded)
        {
            var caller = await GetCallerAsync();
            await Playback.LoadEqPresetsAsync(caller);
        }

        // Re-resolve the device-local preset now that the preset list is available
        // (the stored preset may have been renamed or re-seeded since it was saved).
        if (_localEqState is not null && Playback.EqPresetsLoaded)
        {
            var resolved = _localEqState.ResolvePresetId(Playback.EqPresets);
            if (resolved != Playback.ActivePresetId)
                Playback.ApplyEqSnapshot(_localEqState.Bands, resolved, isLocalOverride: true);
        }

        Playback.ToggleEqualizer();
    }

    private async Task ApplyPresetAsync(EqPresetDto preset)
    {
        Playback.ApplyPreset(preset);
        if (_jsInitialized)
        {
            await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setEqBands", Playback.EqBands);
        }
        await SaveLocalEqAsync();
        SaveSettingDebounced(EqBandsKey, JsonSerializer.Serialize(Playback.EqBands));
    }

    private async Task OnEqBandChangedAsync(int bandIndex, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var gain))
        {
            Playback.SetEqBand(bandIndex, gain);
            if (_jsInitialized)
            {
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setEqBand", bandIndex, gain);
            }
            await SaveLocalEqAsync();
            SaveSettingDebounced(EqBandsKey, JsonSerializer.Serialize(Playback.EqBands));
        }
    }

    private async Task ResetEqAsync()
    {
        Playback.ResetEqBands();
        if (_jsInitialized)
        {
            await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setEqBands", Playback.EqBands);
        }
        await SaveLocalEqAsync();
        await SaveSettingImmediateAsync(EqBandsKey, JsonSerializer.Serialize(Playback.EqBands));
    }

    private async Task SavePresetAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPresetName)) return;
        try
        {
            var caller = await GetCallerAsync();
            await Playback.SavePresetAsync(_newPresetName, caller, _selectedPresetId);
            _newPresetName = string.Empty;
            _selectedPresetId = null;
            await SaveLocalEqAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save EQ preset");
        }
    }

    private void SelectPreset(EqPresetDto preset)
    {
        _selectedPresetId = preset.Id;
        _newPresetName = preset.Name;
    }

    private void OnPresetNameChanged()
    {
        // Clear the preset selection if the user edits the name away from the selected preset's name
        if (_selectedPresetId.HasValue)
        {
            var selected = Playback.EqPresets.FirstOrDefault(p => p.Id == _selectedPresetId.Value);
            if (selected is null || _newPresetName != selected.Name)
            {
                _selectedPresetId = null;
            }
        }
    }

    private async Task SetDefaultPresetAsync(EqPresetDto preset)
    {
        try
        {
            var caller = await GetCallerAsync();
            await Playback.SetDefaultPresetAsync(preset.Id, caller);
            if (_jsInitialized)
            {
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setEqBands", Playback.EqBands);
            }
            // Persist the per-device default immediately; the server value seeds new machines.
            await SaveLocalEqAsync();
            SaveSettingDebounced(EqBandsKey, JsonSerializer.Serialize(Playback.EqBands));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to set default EQ preset");
        }
    }

    private async Task DeletePresetAsync(EqPresetDto preset)
    {
        try
        {
            var caller = await GetCallerAsync();
            await Playback.DeletePresetAsync(preset.Id, caller);
            if (_jsInitialized)
            {
                await Js.InvokeVoidAsync("dotnetcloudMusicPlayer.setEqBands", Playback.EqBands);
            }
            await SaveLocalEqAsync();
            SaveSettingDebounced(EqBandsKey, JsonSerializer.Serialize(Playback.EqBands));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete EQ preset");
        }
    }


@using DotNetCloud.Core.Authorization
@using DotNetCloud.Core.DTOs
@using DotNetCloud.Core.Services
@using DotNetCloud.Modules.Music.UI
@using DotNetCloud.Modules.Music.Services
@using DotNetCloud.UI.Web.Services
@using Microsoft.Extensions.Logging
@using System.Text.Json
@inject MusicPlaybackState Playback
@inject ModuleUiRegistry ModuleRegistry
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserSettingsService UserSettingsService
@inject IJSRuntime Js
@inject ILogger<GlobalMusicPlaybar> Logger
@inject IPlaylistService PlaylistService
@inject ActivePlaylistContext ActivePlaylist
@implements IAsyncDisposable

@if (_musicModuleEnabled && Playback.NowPlaying is not null)
{
    <div class="global-music-playbar">
        <div class="gmp-track-info">
            <div class="gmp-art">
                @if (Playback.NowPlaying.AlbumId.HasValue)
                {
                    <a href="" @onclick="NavigateToPlayingAlbum"
                       @onclick:preventDefault title="View album">
                        @* The old markup used an inline onerror="" to swap in the fallback SVG, but the
                           hardened CSP (no 'unsafe-inline'/'unsafe-hashes' for script) blocks inline
                           event handlers. Track the failure in component state instead. *@
                        @if (_albumArtFailedForAlbumId == Playback.NowPlaying.AlbumId)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none"
                                 class="gmp-art">
                                <defs>
                                    <linearGradient id="gmpbg" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#cbd5e1" />
                                        <stop offset="100%" stop-color="#94a3b8" />
                                    </linearGradient>
                                </defs>
                                <rect width="200" height="200" rx="12" fill="url(#gmpbg)" />
                                <circle cx="100" cy="96" r="56" fill="#475569" opacity="0.55" />
                                <circle cx="100" cy="96" r="12" fill="#cbd5e1" />
                                <circle cx="100" cy="96" r="4" fill="#475569" />
                            </svg>
                        }
                        else
                        {
                            <img src="@MusicPlaybackState.GetAlbumArtUrl(Playback.NowPlaying.AlbumId.Value)" alt=""
                                 @onerror="OnAlbumArtError" />
                        }
                    </a>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none" class="gmp-art">
                        <defs>
                            <linearGradient id="gmpbg2" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#cbd5e1" />
                                <stop offset="100%" stop-color="#94a3b8" />
                            </linearGradient>
                        </defs>
                        <rect width="200" height="200" rx="12" fill="url(#gmpbg2)" />
                        <circle cx="100" cy="96" r="56" fill="#475569" opacity="0.55" />
                        <circle cx="100" cy="96" r="12" fill="#cbd5e1" />
                        <circle cx="100" cy="96" r="4" fill="#475569" />
                    </svg>
                }
            </div>
            <div class="gmp-text">
                <a class="gmp-title" href="" @onclick="NavigateToCurrentContext"
                   @onclick:preventDefault>@Playback.NowPlaying.Title</a>
                <span class="gmp-artist-album">
                    <a class="gmp-artist-link" href="" @onclick="() => NavigateToArtistPage(Playback.NowPlaying.ArtistId)" @onclick:preventDefault>@Playback.NowPlaying.ArtistName</a>
                    @if (!string.IsNullOrEmpty(Playback.NowPlaying.AlbumTitle) && Playback.NowPlaying.AlbumId.HasValue)
                    {
                        <span class="gmp-separator"> · </span>
                        <a class="gmp-album-link" href="" @onclick="NavigateToPlayingAlbum" @onclick:preventDefault>@Playback.NowPlaying.AlbumTitle</a>
                    }
                    else if (!string.IsNullOrEmpty(Playback.NowPlaying.AlbumTitle))
                    {
                        <span class="gmp-separator"> · </span>
                        <span>@Playback.NowPlaying.AlbumTitle</span>
                    }
                </span>
                @if (ActivePlaylist.PlaylistId.HasValue)
                {
                    <a class="gmp-playlist" href="" @onclick="NavigateToActivePlaylistAsync"
                       @onclick:preventDefault title="View playlist">
                        <span class="gmp-playlist-icon">📃</span>
                        @ActivePlaylist.PlaylistName
                    </a>
                }
            </div>
            <button class="gmp-star" @onclick="ToggleStarAsync"
                    title="@(Playback.NowPlaying.IsStarred ? "Remove from favourites" : "Add to favourites")">
                <MaterialIcon Icon="@(Playback.NowPlaying.IsStarred ? "star" : "star_border")" Size="MaterialIconSize.Sm" />
            </button>
        </div>

        <div class="gmp-controls">
            <div class="gmp-buttons">
                <button class="gmp-btn" @onclick="ToggleShuffleAsync" title="Shuffle">
                    <MaterialIcon Icon="shuffle" Size="MaterialIconSize.Sm"
                                  CssClass="@(Playback.Shuffle ? "active-control" : "")" />
                </button>
                <button class="gmp-btn" @onclick="PlayPreviousAsync" title="Previous">
                    <MaterialIcon Icon="skip_previous" Size="MaterialIconSize.Sm" />
                </button>
                <button class="gmp-btn gmp-play-pause" @onclick="TogglePlayPauseAsync"
                        title="@(Playback.IsPlaying ? "Pause" : "Play")">
                    <MaterialIcon Icon="@(Playback.IsPlaying ? "pause" : "play_arrow")" Size="MaterialIconSize.Md" />
                </button>
                <button class="gmp-btn" @onclick="PlayNextAsync" title="Next">
                    <MaterialIcon Icon="skip_next" Size="MaterialIconSize.Sm" />
                </button>
                <button class="gmp-btn" @onclick="CycleRepeatAsync" title="Repeat: @RepeatLabel">
                    <MaterialIcon Icon="@(Playback.Repeat == RepeatMode.One ? "repeat_one" : "repeat")"
                                  Size="MaterialIconSize.Sm" CssClass="@RepeatModeCssClass" />
                </button>
                <span class="gmp-repeat-label @RepeatModeCssClass">@RepeatLabel</span>
                </div>
                <div class="gmp-progress">
                    <span class="gmp-time">@MusicPlaybackState.FormatDuration(Playback.PlaybackPosition)</span>
                    <div class="gmp-progress-bar" @onclick="SeekAsync">
                        <div class="gmp-progress-fill" style="width: @Playback.GetProgressPercent()%"></div>
                    </div>
                    <span class="gmp-time">@MusicPlaybackState.FormatDuration(Playback.NowPlaying.Duration)</span>
                </div>
            </div>

            <div class="gmp-extras">
                <button class="gmp-btn" @onclick="Playback.ToggleQueue" title="Queue">
                    <MaterialIcon Icon="queue_music" Size="MaterialIconSize.Sm"
                                  CssClass="@(Playback.ShowQueue ? "active-control" : "")" />
                </button>
                <button class="gmp-btn" @onclick="ToggleEqualizerAsync" title="Equalizer">
                    <MaterialIcon Icon="graphic_eq" Size="MaterialIconSize.Sm"
                                  CssClass="@(Playback.ShowEqualizer ? "active-control" : "")" />
                </button>
                <div class="gmp-volume">
                    <button class="gmp-btn" @onclick="ToggleMuteAsync" title="Volume">
                        <MaterialIcon Icon="@VolumeIcon" Size="MaterialIconSize.Sm" />
                    </button>
                    <input type="range" min="0" max="100" value="@Playback.Volume" @oninput="OnVolumeChangedAsync"
                           class="gmp-volume-slider" />
                </div>
                <button class="gmp-btn gmp-close-btn" @onclick="StopAsync" title="Stop">
                    <MaterialIcon Icon="close" Size="MaterialIconSize.Sm" />
                </button>
            </div>
        </div>

        @* ─── Queue Slide-Out Panel ─── *@
        @if (Playback.ShowQueue)
        {
            <aside class="gmp-queue-panel">
                <div class="gmp-panel-header">
                    <h4>Play Queue</h4>
                    <div class="gmp-queue-header-actions">
                        @if (Playback.Queue.Count > 0)
                        {
                            <div class="gmp-queue-save-wrapper">
                                <button class="gmp-btn gmp-btn-sm" @onclick="ToggleSaveQueueMenu">💾 Save</button>
                                @if (_showSaveQueueMenu)
                                {
                                    <div class="gmp-queue-save-dropdown">
                                        <button @onclick="ShowSaveQueueAsNewDialog">Save as New Playlist…</button>
                                        @if (_playlists.Count > 0)
                                        {
                                            <div class="gmp-queue-save-divider"></div>
                                            @foreach (var pl in _playlists)
                                            {
                                                <button @onclick="() => AddQueueToExistingPlaylistAsync(pl.Id)">Add to @pl.Name</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button class="btn-icon" @onclick="Playback.ToggleQueue">✕</button>
                    </div>
                </div>
                <div class="gmp-queue-list">
                    @if (Playback.Queue.Count == 0)
                    {
                        <p class="gmp-queue-empty">Queue is empty</p>
                    }
                    @foreach (var (track, index) in Playback.Queue.Select((t, i) => (t, i)))
                    {
                        <div class="gmp-queue-item @(Playback.NowPlaying?.Id == track.Id ? "playing" : "")">
                            <span class="gmp-queue-num">@(index + 1)</span>
                            <div class="gmp-queue-info">
                                <span class="gmp-queue-title" @onclick="() => Playback.PlayQueueAt(index)" style="cursor:pointer">@track.Title</span>
                                <span class="gmp-queue-artist"><a class="gmp-artist-link" href="" @onclick="() => NavigateToArtistPage(track.ArtistId)" @onclick:preventDefault @onclick:stopPropagation="true">@track.ArtistName</a></span>
                            </div>
                            <div class="gmp-queue-item-actions">
                                <button class="gmp-queue-item-menu-btn" @onclick="() => ToggleQueueItemMenu(index)">⋯</button>
                                @if (_queueItemMenuIndex == index)
                                {
                                    <div class="gmp-queue-item-dropdown">
                                        @foreach (var pl in _playlists)
                                        {
                                            <button @onclick="() => AddTrackToPlaylistFromQueueAsync(pl.Id, track.Id)">Add to @pl.Name</button>
                                        }
                                    </div>
                                }
                                <button class="gmp-queue-remove" @onclick="() => Playback.RemoveFromQueue(index)">✕</button>
                            </div>
                        </div>
                    }
                </div>
            </aside>

            @* ─── Save Queue as New Playlist Dialog ─── *@
            @if (_showSaveQueueDialog)
            {
                <div class="gmp-dialog-overlay" @onclick="CloseSaveQueueDialog">
                    <div class="gmp-dialog-panel" @onclick:stopPropagation="true">
                        <h4>Save Queue as Playlist</h4>
                        <div class="gmp-dialog-form">
                            <label>Playlist Name
                                <input type="text" @bind="_newQueuePlaylistName"
                                       @bind:event="oninput"
                                       placeholder="My Queue Playlist" />
                            </label>
                            <label class="gmp-dialog-checkbox">
                                <input type="checkbox" @bind="_newQueuePlaylistPublic" />
                                <span>Public playlist</span>
                            </label>
                            <p class="gmp-dialog-hint">@Playback.Queue.Count track@(Playback.Queue.Count == 1 ? "" : "s") will be added.</p>
                        </div>
                        <div class="gmp-dialog-actions">
                            <button class="btn btn-primary" @onclick="SaveQueueAsNewPlaylistAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_newQueuePlaylistName)">
                                Save
                            </button>
                            <button class="btn btn-secondary" @onclick="CloseSaveQueueDialog">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        }

        @* ─── Equalizer Slide-Out Panel ─── *@
        @if (Playback.ShowEqualizer)
        {
            <aside class="gmp-eq-panel">
                <div class="gmp-panel-header">
                    <h4>Equalizer</h4>
                    <div class="gmp-eq-header-actions">
                        <button class="btn-icon btn-small" title="Reset to flat" @onclick="ResetEqAsync">⟲</button>
                        <button class="btn-icon btn-small" title="Save as preset"
                                @onclick="Playback.ToggleSavePresetDialog">💾</button>
                        <button class="btn-icon" @onclick="Playback.ToggleEqualizer">✕</button>
                    </div>
                </div>
                <div class="gmp-eq-presets">
                    @foreach (var preset in Playback.EqPresets)
                    {
                        <span class="gmp-eq-preset-btn @(Playback.ActivePresetId == preset.Id ? "active" : "")">
                            <button class="gmp-eq-preset-name" @onclick="() => ApplyPresetAsync(preset)">@preset.Name</button>
                            <button class="gmp-eq-preset-default" title="Set as this device's default EQ"
                                    @onclick="() => SetDefaultPresetAsync(preset)">@(Playback.DefaultPresetId == preset.Id ? "☑" :
                                "☐")</button>
                                @if (!preset.IsBuiltIn)
                                {
                                    <button class="gmp-eq-preset-delete" title="Delete preset"
                                            @onclick="() => DeletePresetAsync(preset)">✕</button>
                                }
                            </span>
                        }
                    </div>
                    <div class="gmp-eq-bands">
                        @for (int i = 0; i < Playback.EqBands.Length; i++)
                        {
                            var bandIndex = i;
                            <div class="gmp-eq-band">
                                <input type="range" min="-12" max="12" step="0.5" value="@Playback.EqBands[bandIndex]"
                                       @oninput="(e) => OnEqBandChangedAsync(bandIndex, e)" orient="vertical" class="gmp-eq-slider" />
                                <span class="gmp-eq-label">@MusicPlaybackState.BandLabels[bandIndex]</span>
                            </div>
                        }
                    </div>
                </aside>
            }

            @* ─── Save EQ Preset Dialog ─── *@
            @if (Playback.ShowSavePresetDialog)
            {
                <div class="gmp-dialog-overlay" @onclick="Playback.ToggleSavePresetDialog">
                    <div class="gmp-dialog-panel" @onclick:stopPropagation="true">
                        <h4>Save EQ Preset</h4>
                        <div class="gmp-dialog-form">
                            <label>Preset Name
                                <input type="text" @bind="_newPresetName" @bind:after="OnPresetNameChanged"
                                       placeholder="My Custom Preset" />
                            </label>

                            @if (Playback.EqPresets.Count > 0)
                            {
                                <div class="gmp-dialog-preset-list">
                                    <span class="gmp-dialog-preset-list-label">Or overwrite an existing preset:</span>
                                    @foreach (var preset in Playback.EqPresets)
                                    {
                                        <div class="gmp-dialog-preset-item @(_selectedPresetId == preset.Id ? "selected" : "")"
                                             @onclick="() => SelectPreset(preset)">
                                            <span class="gmp-dialog-preset-name">@preset.Name</span>
                                            @if (_selectedPresetId == preset.Id)
                                            {
                                                <span class="gmp-dialog-preset-check">✓</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="gmp-dialog-actions">
                            <button class="btn btn-primary" @onclick="SavePresetAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_newPresetName)">
                                @(_selectedPresetId.HasValue ? "Update" : "Save")
                            </button>
                            <button class="btn btn-secondary" @onclick="Playback.ToggleSavePresetDialog">Cancel</button>
                        </div>
                    </div>
                </div>
            }
        }

@namespace DotNetCloud.UI.Shared.Components.Editors
@using DotNetCloud.UI.Shared.Services
@inject IJSRuntime JS

@*
    Markdown editor component with toolbar and live preview.
    Provides formatting buttons for common Markdown syntax
    and a split-pane view with live-rendered preview.
*@

<div
    class="markdown-editor @(PreviewOnly ? "preview-only" : "") @(Compact ? "compact" : "") @(FillHeight ? "fill-height" : "")">
    <div class="markdown-editor-toolbar">
        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" title="Bold (Ctrl+B)" @onclick="InsertBold">
                <strong>B</strong>
            </button>
            <button type="button" class="toolbar-btn" title="Italic (Ctrl+I)" @onclick="InsertItalic">
                <em>I</em>
            </button>
            <button type="button" class="toolbar-btn" title="Strikethrough" @onclick="InsertStrikethrough">
                <s>S</s>
            </button>
        </div>
        <div class="toolbar-separator"></div>
        @if (!Compact)
        {
            <div class="toolbar-group">
                <button type="button" class="toolbar-btn" title="Heading 1" @onclick="() => InsertHeading(1)">
                    H1
                </button>
                <button type="button" class="toolbar-btn" title="Heading 2" @onclick="() => InsertHeading(2)">
                    H2
                </button>
                <button type="button" class="toolbar-btn" title="Heading 3" @onclick="() => InsertHeading(3)">
                    H3
                </button>
            </div>
            <div class="toolbar-separator"></div>
        }
        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" title="Unordered list" @onclick="InsertUnorderedList">
                &bull; List
            </button>
            @if (!Compact)
            {
                <button type="button" class="toolbar-btn" title="Ordered list" @onclick="InsertOrderedList">
                    1. List
                </button>
                <button type="button" class="toolbar-btn" title="Task list" @onclick="InsertTaskList">
                    <MaterialIcon Icon="checklist" CssClass="toolbar-icon" /> Task
                </button>
            }
        </div>
        <div class="toolbar-separator"></div>
        <div class="toolbar-group">
            <button type="button" class="toolbar-btn" title="Link" @onclick="InsertLink">
                <MaterialIcon Icon="link" CssClass="toolbar-icon" />
            </button>
            @if (!Compact)
            {
                <button type="button" class="toolbar-btn" title="Image" @onclick="InsertImage">
                    <MaterialIcon Icon="image" CssClass="toolbar-icon" />
                </button>
            }
            <button type="button" class="toolbar-btn" title="Code block" @onclick="InsertCodeBlock">
                &lt;/&gt;
            </button>
            @if (!Compact)
            {
                <button type="button" class="toolbar-btn" title="Blockquote" @onclick="InsertBlockquote">
                    <MaterialIcon Icon="format_quote" CssClass="toolbar-icon" />
                </button>
                <button type="button" class="toolbar-btn" title="Horizontal rule" @onclick="InsertHorizontalRule">
                    ―
                </button>
                <button type="button" class="toolbar-btn" title="Table" @onclick="InsertTable">
                    <MaterialIcon Icon="table_chart" CssClass="toolbar-icon" />
                </button>
            }
        </div>
        @if (Compact)
        {
            <div class="toolbar-group compact-more-group">
                <button type="button" class="toolbar-btn compact-more-btn" title="More formatting"
                        @onclick="ToggleCompactMenu">
                    <MaterialIcon Icon="menu" CssClass="toolbar-icon" />
                </button>
                @if (_showCompactMenu)
                {
                    <div class="compact-more-menu">
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertHeading(1); _showCompactMenu = false; }">
                            <span class="compact-menu-icon">H1</span> Heading 1
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertHeading(2); _showCompactMenu = false; }">
                            <span class="compact-menu-icon">H2</span> Heading 2
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertHeading(3); _showCompactMenu = false; }">
                            <span class="compact-menu-icon">H3</span> Heading 3
                        </button>
                        <div class="compact-menu-divider"></div>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertOrderedList(); _showCompactMenu = false; }">
                            <span class="compact-menu-icon">1.</span> Ordered List
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertTaskList(); _showCompactMenu = false; }">
                            <MaterialIcon Icon="checklist" CssClass="compact-menu-icon" /> Task List
                        </button>
                        <div class="compact-menu-divider"></div>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertImage(); _showCompactMenu = false; }">
                            <MaterialIcon Icon="image" CssClass="compact-menu-icon" /> Image
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertBlockquote(); _showCompactMenu = false; }">
                            <MaterialIcon Icon="format_quote" CssClass="compact-menu-icon" /> Blockquote
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertHorizontalRule(); _showCompactMenu = false; }">
                            <span class="compact-menu-icon">―</span> Horizontal Rule
                        </button>
                        <button type="button" class="compact-menu-item"
                                @onclick="() => { InsertTable(); _showCompactMenu = false; }">
                            <MaterialIcon Icon="table_chart" CssClass="compact-menu-icon" /> Table
                        </button>
                    </div>
                }
            </div>
        }
        <div class="toolbar-separator"></div>
        <div class="toolbar-group toolbar-group-right">
            <button type="button" class="toolbar-btn @(_activeView == EditorView.Edit ? "active" : "")" title="Edit"
                    @onclick="() => SetView(EditorView.Edit)">
                ✏ Edit
            </button>
            @if (!Compact)
            {
                <button type="button" class="toolbar-btn @(_activeView == EditorView.Split ? "active" : "")"
                        title="Split view" @onclick="() => SetView(EditorView.Split)">
                    ⬓ Split
                </button>
            }
            <button type="button" class="toolbar-btn @(_activeView == EditorView.Preview ? "active" : "")"
                    title="Preview" @onclick="() => SetView(EditorView.Preview)">
                👁 Preview
            </button>
        </div>
    </div>

    <div class="markdown-editor-body view-@_activeView.ToString().ToLowerInvariant()">
        @if (_activeView != EditorView.Preview)
        {
            <div class="editor-pane">
                <textarea @ref="_textareaRef" class="editor-textarea"
                          placeholder="@(Placeholder ?? "Write your note in Markdown…")" rows="@Rows" @bind="Content"
                          @bind:event="oninput" @bind:after="OnContentChanged" spellcheck="true"></textarea>
                @if (ShowCharacterCount && MaxLength > 0)
                {
                    var len = Content?.Length ?? 0;
                    var pct = (double)len / MaxLength;
                    <div
                        class="editor-character-count @(pct >= 1.0 ? "over-limit" : pct >= 0.9 ? "near-limit" : pct >= 0.8 ? "warning" : "")">
                        @len / @MaxLength characters
                    </div>
                }
            </div>
        }
        @if (_activeView != EditorView.Edit)
        {
            <div class="preview-pane">
                <div class="preview-content markdown-body">
                    @((MarkupString)_renderedHtml)
                </div>
            </div>
        }
    </div>
</div>

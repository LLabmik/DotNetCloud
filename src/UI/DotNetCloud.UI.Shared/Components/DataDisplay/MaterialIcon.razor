@namespace DotNetCloud.UI.Shared.Components.DataDisplay

@*
    Material Icons component.
    Renders Material Design icons as inline SVGs — no font dependency.

    Usage:
        <MaterialIcon Icon="home" />
        <MaterialIcon Icon="settings" Size="MaterialIconSize.Lg" />
        <MaterialIcon Icon="close" CssClass="my-custom-class" />

    Icon names are Material Icons ligature names.
    Full list: https://fonts.google.com/icons
*@

@{
    var svgPath = MaterialSvgIcons.GetPath(Icon);
}
@if (svgPath is not null)
{
    <svg class="material-icon @GetSizeClass @CssClass" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="@svgPath" />
    </svg>
}
else
{
    @* Fallback: unknown icon — render as text for discoverability *@
    <span class="material-icon--fallback @GetSizeClass @CssClass" aria-hidden="true">@Icon</span>
}

@namespace DotNetCloud.UI.Shared.Components.DataDisplay
@using DotNetCloud.UI.Shared.Services

<div class="widget-card widget-card--@Slug" data-module="@ModuleId">
    @* Decorative art layer — every module styles the three chrome slots differently. *@
    <div class="widget-card-chrome" aria-hidden="true">
        <span class="widget-card-chrome-a"></span>
        <span class="widget-card-chrome-b"></span>
        <span class="widget-card-chrome-c"></span>
    </div>
    <div class="widget-card-header">
        <span class="widget-card-icon">
            <MaterialIcon Icon="@ResolvedIcon" Size="MaterialIconSize.Lg" />
        </span>
        <h3 class="widget-card-title">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <a class="widget-card-open" href="@Href">
                <span>Open</span>
                <MaterialIcon Icon="open_in_new" Size="MaterialIconSize.Sm" />
            </a>
        }
    </div>
    <div class="widget-card-body">
        @ChildContent
    </div>
</div>

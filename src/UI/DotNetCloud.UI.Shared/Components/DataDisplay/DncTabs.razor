<div class="tabs">
    <div class="tab-header" role="tablist">
        @foreach (var tab in Tabs)
        {
            <button class="tab-btn @(tab.Id == ActiveTabId ? "active" : "")"
                    role="tab"
                    aria-selected="@(tab.Id == ActiveTabId)"
                    @onclick="() => SetActiveTab(tab.Id)">
                @tab.Label
            </button>
        }
    </div>
    <div class="tab-content" role="tabpanel">
        @ChildContent
    </div>
</div>

<div class="accordion">
    @foreach (var item in Sections)
    {
        var isOpen = _openSections.Contains(item.Id);
        <div class="accordion-item @(isOpen ? "open" : "")">
            <button class="accordion-header" @onclick="() => Toggle(item.Id)">
                <span>@item.Title</span>
                <MaterialIcon Icon="@(isOpen ? "expand_less" : "expand_more")" CssClass="accordion-icon" />
            </button>
            @if (isOpen)
            {
                <div class="accordion-body">
                    @item.Content
                </div>
            }
        </div>
    }
</div>

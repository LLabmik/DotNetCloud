<section class="dnc-section @CssClass">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="page-header">
            <h1>@Title</h1>
            @if (Actions is not null)
            {
                <div class="header-actions">
                    @Actions
                </div>
            }
        </div>
    }
    @ChildContent
</section>

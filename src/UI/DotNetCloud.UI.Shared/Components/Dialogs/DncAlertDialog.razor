@if (_visible)
{
    <div class="dialog-overlay" @onclick="Dismiss">
        <div class="dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3>@Title</h3>
                <button class="btn-icon" @onclick="Dismiss" aria-label="Close" title="Close">
                    <MaterialIcon Icon="close" />
                </button>
            </div>
            <div class="dialog-body">
                <div class="alert alert-@Level.ToString().ToLowerInvariant()">
                    @Message
                </div>
            </div>
            <div class="dialog-footer">
                <button class="btn btn-primary" @onclick="Dismiss">@DismissText</button>
            </div>
        </div>
    </div>
}

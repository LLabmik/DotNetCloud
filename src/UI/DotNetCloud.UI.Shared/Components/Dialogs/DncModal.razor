@if (_visible)
{
    <div class="dialog-overlay" @onclick="OnOverlayClick">
        <div class="dialog @(Wide ? "dialog-wide" : "") @(ExtraWide ? "dialog-xwide" : "") @CssClass" @onclick:stopPropagation="true">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="dialog-header">
                    <h3>@Title</h3>
                    <button class="btn-icon" @onclick="CloseAsync" aria-label="Close" title="Close">
                        <MaterialIcon Icon="close" />
                    </button>
                </div>
            }
            <div class="dialog-body">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="dialog-footer">
                    @Footer
                </div>
            }
        </div>
    </div>
}

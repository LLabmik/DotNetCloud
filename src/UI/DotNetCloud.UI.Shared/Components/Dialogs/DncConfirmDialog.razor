@if (_visible)
{
    <div class="dialog-overlay" @onclick="OnCancel">
        <div class="dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3>@Title</h3>
                <button class="btn-icon" @onclick="OnCancel" aria-label="Close" title="Close">
                    <MaterialIcon Icon="close" />
                </button>
            </div>
            <div class="dialog-body">
                <p>@Message</p>
            </div>
            <div class="dialog-footer">
                <button class="btn @ConfirmButtonClass" @onclick="OnConfirmClicked">@ConfirmText</button>
                <button class="btn btn-outline" @onclick="OnCancel">@CancelText</button>
            </div>
        </div>
    </div>
}

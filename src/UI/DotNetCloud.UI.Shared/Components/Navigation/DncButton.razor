<button class="btn @VariantClass @SizeClass @(FullWidth ? "btn-full" : "") @CssClass"
        type="@Type"
        disabled="@Disabled"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="spinner btn-spinner"></span>
    }
    @ChildContent
</button>

<header class="topbar">
    <div class="topbar-left">
        @if (LeftContent is not null)
        {
            @LeftContent
        }
        else
        {
            <h1 class="page-title">@Title</h1>
        }
    </div>
    <div class="topbar-right">
        @if (RightContent is not null)
        {
            @RightContent
        }
    </div>
</header>

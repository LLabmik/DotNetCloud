@using Microsoft.AspNetCore.Components.Routing

<nav class="sidebar @(Collapsed ? "collapsed" : "")">
    <div class="sidebar-header">
        <a href="/" class="brand" title="@BrandText" aria-label="@BrandText">
            <MaterialIcon Icon="@BrandIcon" CssClass="brand-icon" />
            @if (!Collapsed)
            {
                <span class="brand-text">@BrandText</span>
            }
        </a>
        <button class="sidebar-toggle"
                @onclick="ToggleCollapsed"
                title="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")"
                aria-label="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")">
            <MaterialIcon Icon="@(Collapsed ? "chevron_right" : "chevron_left")" CssClass="toggle-icon" />
        </button>
    </div>
    <div class="nav-menu">
        <ul class="nav-list">
            @foreach (var item in Items)
            {
                <li class="nav-item">
                    <NavLink href="@item.Href"
                             Match="NavLinkMatch.Prefix"
                             class="nav-link"
                             title="@item.Label"
                             aria-label="@item.Label">
                        @if (item.Icon is not null)
                        {
                            <MaterialIcon Icon="@item.Icon" CssClass="nav-icon" />
                        }
                        @if (!Collapsed)
                        {
                            <span class="nav-text">@item.Label</span>
                        }
                    </NavLink>
                </li>
            }
        </ul>
        @if (ExtraContent is not null)
        {
            <div class="nav-separator"></div>
            @ExtraContent
        }
    </div>
</nav>

@page "/admin/store"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize(Policy = "RequireAdmin")]

<PageTitle>Module store - DotNetCloud</PageTitle>

<div class="page-header">
    <h1>Module store</h1>
    <a href="/admin/modules" class="btn btn-outline">Installed modules</a>
</div>

<p class="text-muted">
    Install a signed <code>.dncpkg</code> package, either from the configured store source or by
    uploading a file. A package signed by a key this server does not trust can only be installed
    with an explicit unverified approval, and every install is written to the audit trail.
</p>

<div class="card store-panel">
    <h2>Install a package</h2>

    <p class="text-muted">
        Choose a <code>.dncpkg</code> file. The package is verified — archive safety, manifest,
        compatibility, SHA-256 and Ed25519 signature — before anything is installed, and you review
        what it asks for.
    </p>

    <InputFile OnChange="OnFileSelected" accept=".dncpkg" class="store-file-input" />

    @if (_inspecting)
    {
        <LoadingIndicator Message="Verifying the package..." />
    }
</div>

@if (_result is not null)
{
    <div class="alert @(_result.Success ? "alert-success" : "alert-danger")">
        <div class="store-result-header">
            <MaterialIcon Icon="@(_result.Success ? "check_circle" : "error")" />
            <strong>@(_result.Success ? "Install completed" : "Install failed")</strong>
        </div>
        <p>@(_result.Error)</p>

        @if (_result.RolledBack)
        {
            <p>
                The module did not become healthy, so the previous version was restored.
                @(_result.RollbackReason)
            </p>
        }

        @foreach (var issue in _result.Issues)
        {
            <p class="store-issue">[@issue.Code] @issue.Message</p>
        }
    </div>
}

@if (_review is not null)
{
    <div class="card store-panel store-review">
        <h2>Review: @ReviewTitle</h2>

        <dl class="store-details">
            <dt>Module</dt>
            <dd>@(_review.ModuleId ?? "unknown")</dd>

            <dt>Version</dt>
            <dd>
                @(_review.Version ?? "unknown")
                @if (_review.IsAlreadyInstalled)
                {
                    <span class="text-muted">(replacing @_review.InstalledVersion)</span>
                }
            </dd>

            <dt>Publisher</dt>
            <dd>@(_review.PublisherId ?? "none declared")</dd>

            <dt>Signature</dt>
            <dd>
                <span class="badge badge-@(_review.IsSignedByTrustedKey ? "success" : "danger")">
                    @SignatureLabel
                </span>
            </dd>

            <dt>SHA-256</dt>
            <dd class="store-hash">@(_review.Sha256 ?? "not computed")</dd>

            <dt>Data store</dt>
            <dd>@_review.DataStoreMode</dd>

            <dt>User erasure</dt>
            <dd>@(_review.HandlesUserErasure ? "implemented" : "not implemented")</dd>
        </dl>

        <h3>Capabilities requested</h3>
        @if (_review.Capabilities.Count == 0)
        {
            <p class="text-muted">None.</p>
        }
        else
        {
            <ul class="store-list">
                @foreach (var capability in _review.Capabilities)
                {
                    <li><code>@capability</code></li>
                }
            </ul>
        }

        <h3>User consent scopes</h3>
        @if (_review.UserConsentScopes.Count == 0)
        {
            <p class="text-muted">None — the module requests no access to user data.</p>
        }
        else
        {
            <ul class="store-list">
                @foreach (var scope in _review.UserConsentScopes)
                {
                    <li><code>@scope</code></li>
                }
            </ul>
        }

        @foreach (var warning in _review.Warnings)
        {
            <p class="store-issue">@warning.Message</p>
        }

        @foreach (var issue in _review.Issues)
        {
            <p class="store-issue store-issue-error">[@issue.Code] @issue.Message</p>
        }

        <label class="store-confirm">
            <input type="checkbox" @bind="_acknowledged" />
            I reviewed these capabilities and scopes and approve installing this package.
        </label>

        @if (!_review.IsSignedByTrustedKey)
        {
            <label class="store-confirm">
                <input type="checkbox" @bind="_unverifiedAcknowledged" />
                I understand this package is <strong>not verified by a key this server trusts</strong>
                and I accept responsibility for its source.
            </label>
        }

        <div class="store-actions">
            <button class="btn btn-primary" @onclick="InstallAsync" disabled="@(!CanInstall)">
                Install
            </button>
            <button class="btn btn-outline" @onclick="ClearAsync" disabled="@_installing">Cancel</button>
        </div>
    </div>
}

<div class="card store-panel">
    <h2>Configured store source</h2>

    @if (_loadingCatalogue)
    {
        <LoadingIndicator Message="Reading the configured store source..." />
    }
    else if (_catalogue.Count == 0)
    {
        <p class="text-muted">
            No packages are listed. Point <code>Modules:Store:IndexUrl</code> at a published store
            index (or <code>Modules:Store:LocalFeedPath</code> at a feed directory) to see what is
            available here, or install a file above.
        </p>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Module</th>
                        <th>Version</th>
                        <th>Publisher</th>
                        <th>Capabilities</th>
                        <th>Installed</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in _catalogue)
                    {
                        <tr>
                            <td>
                                @package.Name
                                <small class="text-muted">@package.ModuleId</small>
                            </td>
                            <td>@package.Version</td>
                            <td>@(package.PublisherId ?? "—")</td>
                            <td>@(package.Capabilities.Count == 0 ? "—" : string.Join(", ", package.Capabilities))</td>
                            <td>@(package.InstalledVersion ?? "—")</td>
                            <td>
                                @if (package.Yanked)
                                {
                                    <span class="badge badge-danger">Withdrawn</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Available</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-outline"
                                        @onclick="() => ReviewStorePackageAsync(package)"
                                        disabled="@(_inspecting || _installing || package.Yanked || package.InstalledVersion == package.Version)">
                                    Review
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted">
            Review fetches and verifies the package, then shows the same approval step as an upload.
            From a shell, use <code>dotnetcloud module install --from-store &lt;module-id&gt;</code>.
        </p>
    }
</div>

@page "/admin/system"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize(Policy = "RequireAdmin")]
@implements IAsyncDisposable

<PageTitle>System - DotNetCloud</PageTitle>

<div class="page-header system-header">
    <div>
        <h1>System</h1>
        <p class="text-muted system-subtitle">Live process, traffic and background-task metrics. Refreshes every 5 seconds.</p>
    </div>
    <div class="system-header-actions">
        @if (_status is not null)
        {
            <span class="system-updated @(_stale ? "system-updated--stale" : string.Empty)">
                @( _stale ? $"stale — last updated {FormatTimeAgo(_lastSuccessUtc)}" : $"updated {FormatTimeAgo(_lastSuccessUtc)}" )
            </span>
        }
        <a href="/admin/health" class="btn btn-outline">Health details</a>
        <button class="btn btn-outline" @onclick="RefreshAsync" disabled="@_refreshing">Refresh</button>
    </div>
</div>

@if (_status is null)
{
    @if (_initialLoadFailed)
    {
        <div class="empty-state">
            <p>Unable to retrieve system metrics.</p>
        </div>
    }
    else
    {
        <LoadingIndicator Message="Loading system metrics..." />
    }
}
else
{
    @* ── Top stat cards ─────────────────────────────────────────── *@
    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-icon dash-stat-icon--modules">
                <MaterialIcon Icon="speed" />
            </div>
            <div class="dash-stat-body">
                <span class="dash-stat-label">CPU (@_status.ProcessorCount cores)</span>
                <span class="dash-stat-value">@FormatPercent(_status.CpuPercent)</span>
                <span class="dash-stat-sub">app processes only</span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-icon dash-stat-icon--storage">
                <MaterialIcon Icon="memory" />
            </div>
            <div class="dash-stat-body">
                <span class="dash-stat-label">Memory</span>
                <span class="dash-stat-value">@FormatBytes(_status.WorkingSetBytes)</span>
                <span class="dash-stat-sub">GC heap @FormatBytes(_status.GcHeapBytes)</span>
            </div>
        </div>

        <div class="dash-stat-card" title="Distinct users with an active SignalR (chat/Blazor) connection. Does not include sync clients.">
            <div class="dash-stat-icon dash-stat-icon--users">
                <MaterialIcon Icon="group" />
            </div>
            <div class="dash-stat-body">
                <span class="dash-stat-label">Users online</span>
                <span class="dash-stat-value">@_status.Users.Online</span>
                <span class="dash-stat-sub">@_status.Users.Connections connection(s) · SignalR sessions</span>
            </div>
        </div>

        <div class="dash-stat-card">
            <div class="dash-stat-icon dash-stat-icon--orgs">
                <MaterialIcon Icon="swap_vert" />
            </div>
            <div class="dash-stat-body">
                <span class="dash-stat-label">Data transferred</span>
                <span class="dash-stat-value">@FormatBytes(_status.Traffic.BytesTotal)</span>
                <span class="dash-stat-sub">
                    ↓ @FormatBytes(_status.Traffic.BytesIn) · ↑ @FormatBytes(_status.Traffic.BytesOut)
                </span>
            </div>
        </div>
    </div>

    @* ── Uptime / rate strip ───────────────────────────────────── *@
    <div class="system-strip">
        <span><MaterialIcon Icon="schedule" Size="MaterialIconSize.Sm" /> Uptime @FormatUptime(_status.UptimeSeconds)</span>
        <span><MaterialIcon Icon="speed" Size="MaterialIconSize.Sm" /> Rate ↓ @FormatRate(_status.Traffic.InPerSecond) · ↑ @FormatRate(_status.Traffic.OutPerSecond)</span>
        @if (_status.UnavailableModules.Count > 0)
        {
            <span class="system-strip-warning">
                <MaterialIcon Icon="warning" Size="MaterialIconSize.Sm" />
                Unavailable: @string.Join(", ", _status.UnavailableModules)
            </span>
        }
    </div>

    @* ── Processes ─────────────────────────────────────────────── *@
    <div class="dash-section">
        <div class="dash-section-header">
            <h2>Processes</h2>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Process</th>
                        <th>Module</th>
                        <th class="num">PID</th>
                        <th class="num">CPU</th>
                        <th class="num">Working set</th>
                        <th class="num">GC heap</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var process in _status.Processes)
                    {
                        <tr>
                            <td>@process.Name</td>
                            <td class="text-muted">@process.Id</td>
                            <td class="num">@process.Pid</td>
                            <td class="num">@FormatPercent(process.CpuPercent)</td>
                            <td class="num">@FormatBytes(process.WorkingSetBytes ?? 0)</td>
                            <td class="num">@(process.GcHeapBytes is null ? "—" : FormatBytes(process.GcHeapBytes.Value))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Per-user traffic ──────────────────────────────────────── *@
    <div class="dash-section">
        <div class="dash-section-header">
            <h2>Traffic by user</h2>
            @if (_status.UsersTraffic.Showing < _status.UsersTraffic.Total)
            {
                <span class="system-section-count">
                    showing top @_status.UsersTraffic.Showing of @_status.UsersTraffic.Total
                </span>
            }
        </div>

        <p class="system-source-note">
            <strong>Transferred (this session)</strong> — counts every client, including ones that are not in the
            online-user count above, such as the desktop sync client (which streams over SSE rather than a SignalR
            hub). Rows can therefore outnumber the online-user count. Totals restart when a user goes quiet.
        </p>

        @if (_status.UsersTraffic.Entries.Count == 0)
        {
            <p class="text-muted">No user traffic yet.</p>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Presence</th>
                            <th>State</th>
                            <th>Last activity</th>
                            <th class="num">In</th>
                            <th class="num">Out</th>
                            <th class="num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _status.UsersTraffic.Entries)
                        {
                            <tr class="@(row.IsIdle ? "traffic-row--idle" : string.Empty)">
                                <td>@row.DisplayName</td>
                                <td>
                                    <span class="presence-chip presence-chip--@PresenceCssClass(row.PresenceState)"
                                          title="@PresenceTooltip(row.PresenceState)">
                                        @PresenceLabel(row.PresenceState)
                                    </span>
                                </td>
                                <td>
                                    @if (row.IsIdle)
                                    {
                                        <span class="badge badge-warning">Idle</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                </td>
                                <td title="@row.LastActivityUtc.ToString("O")">@FormatTimeAgo(row.LastActivityUtc)</td>
                                <td class="num">@FormatBytes(row.BytesIn)</td>
                                <td class="num">@FormatBytes(row.BytesOut)</td>
                                <td class="num">@FormatBytes(row.BytesTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="system-footer-note system-footer-note--inline">
                These figures come from network counters. The online-user count comes from SignalR connections.
                They measure different things.
            </p>
        }
    </div>

    @* ── Background tasks ──────────────────────────────────────── *@
    <div class="dash-section">
        <div class="dash-section-header">
            <h2>Background tasks</h2>
        </div>
        @if (_status.Tasks.Count == 0)
        {
            <p class="text-muted">No background task data available yet.</p>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Module</th>
                            <th>Service</th>
                            <th>Running for</th>
                            <th>Last run</th>
                            <th class="num">Duration</th>
                            <th>Result</th>
                            <th class="num">Runs</th>
                            <th class="num">Failures</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _status.Tasks)
                        {
                            <tr>
                                <td>
                                    @if (task.IsRunning)
                                    {
                                        <span class="badge badge-info">Running</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Idle</span>
                                    }
                                </td>
                                <td>@task.ModuleName</td>
                                <td class="bg-svc-name">@task.ServiceName</td>
                                <td>@(task.IsRunning ? FormatTimeAgo(task.CurrentRunStartedAt) : "—")</td>
                                <td title="@task.LastRunAt.ToString("O")">@FormatTimeAgo(task.LastRunAt)</td>
                                <td class="num">@FormatDuration(task.LastRunDurationMs)</td>
                                <td>
                                    <span class="badge badge-@(task.LastRunSuccess ? "success" : "danger")">
                                        @(task.LastRunSuccess ? "OK" : "Failed")
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(task.LastRunMessage))
                                    {
                                        <span class="system-task-message">@task.LastRunMessage</span>
                                    }
                                </td>
                                <td class="num">@task.TotalRuns</td>
                                <td class="num">
                                    @if (task.TotalFailures > 0)
                                    {
                                        <span class="text-danger">@task.TotalFailures</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <p class="system-footer-note">
        Data transfer counted since @_status.Traffic.SinceUtc.ToLocalTime().ToString("g")
        (HTTP payload + WebSocket frames, authenticated traffic only). Counters reset when the core process restarts.
    </p>
}

@page "/admin/modules/{ModuleId}"
@rendermode @(new Microsoft.AspNetCore.Components.Web.InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize(Policy = "RequireAdmin")]

<PageTitle>Module Details - DotNetCloud</PageTitle>

@if (_loading)
{
    <LoadingIndicator Message="Loading module details..." />
}
else if (_module is null)
{
    <div class="empty-state">
        <p>Module not found.</p>
        <a href="/admin/modules" class="btn btn-primary">Back to Modules</a>
    </div>
}
else
{
    <div class="page-header">
        <h1>@_module.Name</h1>
        <a href="/admin/modules" class="btn btn-outline">Back</a>
    </div>

    <div class="detail-grid">
        <div class="detail-section">
            <h2>Information</h2>
            <dl class="detail-list">
                <dt>Module ID</dt>
                <dd>@_module.Id</dd>
                <dt>Version</dt>
                <dd>@_module.Version</dd>
                <dt>Status</dt>
                <dd><span class="badge badge-@GetStatusClass(_module.Status)">@_module.Status</span></dd>
                <dt>Installed</dt>
                <dd>@TimeProvider.FormatDateTime(_module.InstalledAt, "yyyy-MM-dd")</dd>
                @if (!string.IsNullOrWhiteSpace(_module.Description))
                {
                    <dt>Description</dt>
                    <dd>@_module.Description</dd>
                }
            </dl>
        </div>

        <div class="detail-section">
            <h2>Actions</h2>
            <div class="action-buttons">
                @if (_module.Status == "Enabled")
                {
                    <button class="btn btn-warning" @onclick="StopAsync" disabled="@_actionInProgress">Stop</button>
                    <button class="btn btn-outline" @onclick="RestartAsync" disabled="@_actionInProgress">Restart</button>
                }
                else
                {
                    <button class="btn btn-success" @onclick="StartAsync" disabled="@_actionInProgress">Start</button>
                }
            </div>
        </div>

        @if (_module.RequiredCapabilities.Count > 0)
        {
            <div class="detail-section">
                <h2>Required Capabilities</h2>
                <ul class="tag-list">
                    @foreach (var cap in _module.RequiredCapabilities)
                    {
                        <li class="tag">@cap</li>
                    }
                </ul>
            </div>
        }

        @if (_module.GrantedCapabilities.Count > 0)
        {
            <div class="detail-section">
                <h2>Granted Capabilities</h2>
                <ul class="tag-list">
                    @foreach (var grant in _module.GrantedCapabilities)
                    {
                        <li class="tag tag-granted">@grant.CapabilityName</li>
                    }
                </ul>
            </div>
        }

        @if (_module.PublishedEvents.Count > 0)
        {
            <div class="detail-section">
                <h2>Published Events</h2>
                <ul class="tag-list">
                    @foreach (var evt in _module.PublishedEvents)
                    {
                        <li class="tag tag-event">@evt</li>
                    }
                </ul>
            </div>
        }

        @* Consent is per user: the admin grants the capability, each user decides whose data. *@
        <div class="detail-section">
            <h2>User Consent</h2>
            @if (_consent is null || _consent.ConsentingUsers == 0)
            {
                <p class="text-muted">No user has approved this module yet.</p>
            }
            else
            {
                <p class="text-muted">
                    @_consent.ConsentingUsers user(s) approved access. Revoking on a user's behalf
                    stops future calls immediately.
                </p>
                <ul class="tag-list">
                    @foreach (var scope in _consent.Scopes)
                    {
                        <li class="tag tag-granted">@scope.Scope &mdash; @scope.UserCount user(s)</li>
                    }
                </ul>

                <table class="consent-user-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Scopes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _consent.Users)
                        {
                            <tr>
                                <td class="consent-user-id">@user.UserId</td>
                                <td>@string.Join(", ", user.Scopes)</td>
                                <td>
                                    <button class="btn btn-sm btn-danger"
                                            disabled="@_consentActionInProgress"
                                            @onclick="() => RevokeConsentAsync(user.UserId)">
                                        Revoke
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_module.SubscribedEvents.Count > 0)
        {
            <div class="detail-section">
                <h2>Subscribed Events</h2>
                <ul class="tag-list">
                    @foreach (var evt in _module.SubscribedEvents)
                    {
                        <li class="tag tag-event">@evt</li>
                    }
                </ul>
            </div>
        }
    </div>
}

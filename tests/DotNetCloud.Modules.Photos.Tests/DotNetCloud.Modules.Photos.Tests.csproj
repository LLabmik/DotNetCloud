<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos\DotNetCloud.Modules.Photos.csproj" />
    <ProjectReference Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Data\DotNetCloud.Modules.Photos.Data.csproj" />
    <ProjectReference Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\DotNetCloud.Modules.Photos.Host.csproj" />
    <ProjectReference Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\DotNetCloud.Modules.Sdk.csproj" />
  </ItemGroup>

  <!-- The shipped files are the ones under test: the manifest, the framed documents and the SDK bridge. -->
  <ItemGroup>
    <None Include="..\..\src\Modules\Photos\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\assets\photos-ui.js" Link="ui\assets\photos-ui.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\assets\photos-ui.css" Link="ui\assets\photos-ui.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\widget\index.html" Link="ui\widget\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\widget\widget.js" Link="ui\widget\widget.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Photos\DotNetCloud.Modules.Photos.Host\wwwroot\widget\widget.css" Link="ui\widget\widget.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js" Link="ui\dncModuleBridge.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>

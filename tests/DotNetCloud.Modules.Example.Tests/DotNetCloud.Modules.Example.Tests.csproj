<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- The erasure handler is a host service over ExampleDbContext; InMemory is the repo's test provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Example\DotNetCloud.Modules.Example\DotNetCloud.Modules.Example.csproj" />
    <ProjectReference Include="..\..\src\Modules\Example\DotNetCloud.Modules.Example.Host\DotNetCloud.Modules.Example.Host.csproj" />
    <!-- The browser-side API client is a plain library so these tests can drive it with a stub handler. -->
    <ProjectReference Include="..\..\src\Modules\Example\DotNetCloud.Modules.Example.Web.Services\DotNetCloud.Modules.Example.Web.Services.csproj" />
    <ProjectReference Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\DotNetCloud.Modules.Sdk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged manifest is asserted directly, so the test reads the file that ships in the .dncpkg. -->
    <None Include="..\..\src\Modules\Example\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The module UI is a Blazor WebAssembly app served by the host. These are the shipped entry
         document, stylesheet and bootstrap scripts the asset guards read. -->
    <None Include="..\..\src\Modules\Example\DotNetCloud.Modules.Example.Web\wwwroot\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Example\DotNetCloud.Modules.Example.Web\wwwroot\css\app.css" Link="ui\css\app.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bridge and the frame bootstrap are the SDK's single copies; each module links them in at build time. -->
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js" Link="ui\js\dncModuleBridge.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleFrame.js" Link="ui\js\dncModuleFrame.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleBoot.js" Link="ui\js\dncModuleBoot.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

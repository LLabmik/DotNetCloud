<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Bookmarks/DotNetCloud.Modules.Bookmarks/DotNetCloud.Modules.Bookmarks.csproj" />
    <ProjectReference Include="../../src/Modules/Bookmarks/DotNetCloud.Modules.Bookmarks.Data/DotNetCloud.Modules.Bookmarks.Data.csproj" />
    <ProjectReference Include="../../src/Modules/Bookmarks/DotNetCloud.Modules.Bookmarks.Host/DotNetCloud.Modules.Bookmarks.Host.csproj" />
    <!-- The browser-side API client is a plain library so these tests can drive it with a stub handler. -->
    <ProjectReference Include="../../src/Modules/Bookmarks/DotNetCloud.Modules.Bookmarks.Web.Services/DotNetCloud.Modules.Bookmarks.Web.Services.csproj" />
    <ProjectReference Include="../../src/SDK/DotNetCloud.Modules.Sdk.Web/DotNetCloud.Modules.Sdk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged manifest is asserted directly, so the test reads the file that ships in the .dncpkg. -->
    <None Include="..\..\src\Modules\Bookmarks\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The module UI is a Blazor WebAssembly app served by the host; these are its entry document,
         stylesheet and bootstrap scripts. The widget stays a plain static document. -->
    <None Include="..\..\src\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Web\wwwroot\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Web\wwwroot\css\app.css" Link="ui\css\app.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Host\wwwroot\widget\index.html" Link="ui\widget\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Host\wwwroot\widget\widget.js" Link="ui\widget\widget.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Bookmarks\DotNetCloud.Modules.Bookmarks.Host\wwwroot\widget\widget.css" Link="ui\widget\widget.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bridge and the frame bootstrap are the SDK's single copies; each module links them in at build time. -->
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js" Link="ui\js\dncModuleBridge.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleFrame.js" Link="ui\js\dncModuleFrame.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleBoot.js" Link="ui\js\dncModuleBoot.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
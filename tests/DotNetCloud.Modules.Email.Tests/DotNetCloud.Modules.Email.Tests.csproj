<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Email/DotNetCloud.Modules.Email/DotNetCloud.Modules.Email.csproj" />
    <ProjectReference Include="../../src/Modules/Email/DotNetCloud.Modules.Email.Data/DotNetCloud.Modules.Email.Data.csproj" />
    <ProjectReference Include="../../src/Modules/Email/DotNetCloud.Modules.Email.Host/DotNetCloud.Modules.Email.Host.csproj" />
    <!-- The browser-side services are a plain library so these tests can drive them directly. -->
    <ProjectReference Include="../../src/Modules/Email/DotNetCloud.Modules.Email.Web.Services/DotNetCloud.Modules.Email.Web.Services.csproj" />
    <ProjectReference Include="../../src/SDK/DotNetCloud.Modules.Sdk.Web/DotNetCloud.Modules.Sdk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged manifest is asserted directly, so the test reads the file that ships in the .dncpkg. -->
    <None Include="..\..\src\Modules\Email\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The module-hosted UI assets (phase A5) are asserted for relative references and safe DOM use. -->

    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Host\wwwroot\widget\index.html" Link="ui\widget\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Host\wwwroot\widget\widget.js" Link="ui\widget\widget.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Host\wwwroot\widget\widget.css" Link="ui\widget\widget.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The module UI is a Blazor WebAssembly app served by the host; these are its entry
         document and stylesheet. -->
    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Web\wwwroot\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Web\wwwroot\css\app.css" Link="ui\css\app.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frame's service registrations are asserted directly: a missing one is a blank frame in the
         browser, which no other test would catch. -->
    <None Include="..\..\src\Modules\Email\DotNetCloud.Modules.Email.Web\Program.cs" Link="ui\Program.cs" CopyToOutputDirectory="PreserveNewest" />
        <!-- The bridge is the SDK's single copy of the UI protocol; the host copies it at build time. -->
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js" Link="ui\js\dncModuleBridge.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleFrame.js" Link="ui\js\dncModuleFrame.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk.Web\wwwroot\dncModuleBoot.js" Link="ui\js\dncModuleBoot.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
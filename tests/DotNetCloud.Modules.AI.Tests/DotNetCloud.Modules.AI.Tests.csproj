<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI\DotNetCloud.Modules.AI.csproj" />
    <ProjectReference Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Data\DotNetCloud.Modules.AI.Data.csproj" />
    <ProjectReference Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\DotNetCloud.Modules.AI.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged manifest is asserted directly, so the test reads the file that ships in the .dncpkg. -->
    <None Include="..\..\src\Modules\AI\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The module-hosted UI assets (phase A5) are asserted for relative references and safe DOM use. -->
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\index.html" Link="ui\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\assets\ai-ui.js" Link="ui\assets\ai-ui.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\assets\ai-ui.css" Link="ui\assets\ai-ui.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\widget\index.html" Link="ui\widget\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\widget\widget.js" Link="ui\widget\widget.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Modules\AI\DotNetCloud.Modules.AI.Host\wwwroot\widget\widget.css" Link="ui\widget\widget.css" CopyToOutputDirectory="PreserveNewest" />
    <!-- The bridge is the SDK's single copy of the UI protocol; the host copies it at build time. -->
    <None Include="..\..\src\SDK\DotNetCloud.Modules.Sdk\wwwroot\dncModuleBridge.js" Link="ui\dncModuleBridge.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>

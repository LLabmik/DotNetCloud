<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <!-- The SDK feed that ships with your DotNetCloud release. Point this at that folder; do not
         mirror it, and do not add a public source that carries DotNetCloud packages. -->
    <add key="dotnetcloud-sdk" value="__SDK_FEED__" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- Contract package ids exist in the SDK feed only. Mapping them to that source alone stops a
         same-name package on nuget.org from winning the resolve. -->
    <packageSource key="dotnetcloud-sdk">
      <package pattern="DotNetCloud.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

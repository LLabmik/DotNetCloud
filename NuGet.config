<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Platform module contracts (DotNetCloud.Core, .Core.Data, .Core.Grpc, .Core.Packaging,
      .Modules.Sdk, .Modules.Sdk.Web, .UI.Shared) are packed from this tree:

        scripts/pack-module-sdk.ps1 -Output .sdk-feed

      Only the optional module projects and their tests need it; the ordinary build
      (DotNetCloud.CI.slnf) restores from nuget.org alone.
    -->
    <add key="dotnetcloud-sdk" value=".sdk-feed" />
  </packageSources>

  <!--
    The contract ids are deliberately absent from every public feed, so a same-name package
    published to nuget.org must never win the resolve. The longest pattern matches first, so
    DotNetCloud.* resolves from the local SDK feed only.
  -->
  <packageSourceMapping>
    <packageSource key="dotnetcloud-sdk">
      <package pattern="DotNetCloud.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  
  <packageSourceCredentials>
    <!-- Add credentials for private feeds if needed -->
  </packageSourceCredentials>

  <config>
    <!-- Forward slash: a Windows-style path makes `dotnet tool restore` create a literal
         ".nuget\packages" directory on Linux instead of reusing .nuget/packages. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
    <add key="repositoryPath" value="packages" />
    <add key="signatureValidationMode" value="accept" />
  </config>

  <!-- Package sources for restoration -->
  <disabledPackageSources>
    <add key="Microsoft Visual Studio Offline Packages" value="true" />
  </disabledPackageSources>
</configuration>
